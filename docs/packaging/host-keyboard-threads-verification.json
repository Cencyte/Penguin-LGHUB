{
  "schema": 1,
  "date": "2026-10-30",
  "scope": "Synthetic SendInput thread patterns through the Wine host-keyboard bridge into private KWin receivers",
  "fault": "Per-thread X connections create separate Xwayland emulated keyboards; releasing on another connection does not release the original key.",
  "fix": "One serialized process-wide output connection, retained across worker exit, extension queried once per connection, close-on-exec FD.",
  "permission_finding": "Mounted Bazzite kwinrc retained XwaylandEisNoPromptApps=lghub_agent.exe after uninstall. A repeat authorization prompt was therefore not expected. No global permission bypass installed.",
  "prior_test_blind_spot": "The earlier 22-transition routing fixture used one sending thread and did not test cross-thread releases or worker lifetime.",
  "sources": {
    "patches/wine/0046-ghub-shared-host-keyboard-connection.patch": "e277415046f37906ed7c9d9f68c8907b21e4cd2c3425da41ac09684216b35cb5",
