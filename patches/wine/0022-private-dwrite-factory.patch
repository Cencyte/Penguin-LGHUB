+/* Private DirectWrite ABI recovered from the user's DWrite DLL and matching PDB. */
+#ifndef __WINE_DWRITE_PRIVATE_FACTORY_H
+#define __WINE_DWRITE_PRIVATE_FACTORY_H
+typedef struct private_factory private_factory;
+typedef struct glyph_cache glyph_cache;
+typedef struct cache_entry cache_entry;
+struct glyph_bitmap_info
+{
+    UINT16 width, height;
+    INT16 left, top;
+    BYTE flags, reserved;
+};
+struct merge_range
+{
+    UINT32 start, end;
+};
+struct fixed_axis
+{
+    UINT32 tag;
+    INT32 value;
+};
+struct private_factory_vtbl
+{
+    HRESULT(WINAPI *QueryInterface)(private_factory *, REFIID, void **);
+    ULONG(WINAPI *AddRef)(private_factory *);
+    ULONG(WINAPI *Release)(private_factory *);
+    HRESULT(WINAPI *CreateGlyphLookupCacheSingleThreaded)(private_factory *, glyph_cache **);
+    void(WINAPI *GetAlphaBlendParamsWithLightOnDarkAdjustment)(private_factory *, IDWriteRenderingParams *,
+                                                               IDWriteFontFace *, DWRITE_RENDERING_MODE1,
+                                                               DWRITE_TEXT_ANTIALIAS_MODE, BOOLEAN, float, float, float,
+                                                               float *, float *, float *);
+    HRESULT(WINAPI *ComputeGlyphOriginsInDIPs)(private_factory *, const DWRITE_GLYPH_RUN *, DWRITE_MEASURING_MODE,
+                                               D2D1_POINT_2F, float, const DWRITE_MATRIX *, D2D1_POINT_2F *);
+    HRESULT(WINAPI *GetMergeRanges)(private_factory *, const DWRITE_GLYPH_RUN *, struct merge_range *, UINT32 *);
+    void(WINAPI *OverrideSystemRenderingParams)(private_factory *);
+    float(WINAPI *GetCompatibleGammaOverride)(private_factory *);
+    void(WINAPI *SetCompatibleGammaOverride)(private_factory *, float);
+    HRESULT(WINAPI *CreateFontFaceReferenceFile)(private_factory *, IDWriteFontFile *, UINT32,
+                                                 const struct fixed_axis *, UINT32, DWRITE_FONT_SIMULATIONS,
+                                                 IDWriteFontFaceReference **);
+    HRESULT(WINAPI *CreateFontFaceReferencePath)(private_factory *, const WCHAR *, const FILETIME *, UINT32,
+                                                 const struct fixed_axis *, UINT32, DWRITE_FONT_SIMULATIONS,
+                                                 IDWriteFontFaceReference **);
+    HRESULT(WINAPI *CreateFontFaceReferenceKey)(private_factory *, REFGUID, const void *, UINT32, UINT32,
+                                                DWRITE_FONT_SIMULATIONS, IDWriteFontFaceReference **);
+    HRESULT(WINAPI *CreateBitmapRenderTarget)(private_factory *, UINT32 *, UINT32, UINT32,
+                                              IDWriteBitmapRenderTarget1 **);
+};
