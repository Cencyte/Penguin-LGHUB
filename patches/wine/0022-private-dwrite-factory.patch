+static float WINAPI private_get_gamma(private_factory *factory)
+{
+    union {
+        LONG bits;
+        float value;
+    } r;
+    r.bits = InterlockedCompareExchange(&compatible_gamma, 0, 0);
+    return r.value;
+}
+static void WINAPI private_set_gamma(private_factory *factory, float value)
+{
+    union {
+        LONG bits;
+        float value;
+    } v;
+    v.value = value;
+    InterlockedExchange(&compatible_gamma, v.bits);
+}
