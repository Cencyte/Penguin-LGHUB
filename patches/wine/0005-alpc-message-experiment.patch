+        to->max_total_section_size = from->MaxTotalSectionSize;
+        to->dup_object_types = from->DupObjectTypes;
+    }
+    else
+    {
+        to->flags = 0;
+        to->max_msg_len = 65535;
+        to->mem_bandwidth = 0xffffffff;
