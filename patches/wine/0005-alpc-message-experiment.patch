+        security_dst->Flags = security_src->flags;
+        security_dst->ContextHandle = wine_server_ptr_handle(security_src->context_handle);
+        if (security_dst->QoS)
+        {
+            security_dst->QoS->ImpersonationLevel = security_src->qos.impersonation_level;
+            security_dst->QoS->ContextTrackingMode = security_src->qos.context_tracking_mode;
+            security_dst->QoS->EffectiveOnly = security_src->qos.effective_only;
+        }
+    }
+
+    if ((view_src = wine_server_alpc_get_message_attribute(src, ALPC_MESSAGE_VIEW_ATTRIBUTE))
+        && (dst->ValidAttributes & ALPC_MESSAGE_VIEW_ATTRIBUTE))
+    {
+        ALPC_VIEW_ATTR *view_dst = alpc_get_message_attribute(dst, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+
+        view_dst->Flags = view_src->flags;
+        view_dst->SectionHandle = wine_server_ptr_handle(view_src->section_handle);
+        view_dst->ViewBase = wine_server_get_ptr(view_src->view_base);
+        view_dst->ViewSize = view_src->view_size;
+    }
+
+    if ((context_src = wine_server_alpc_get_message_attribute(src, ALPC_MESSAGE_CONTEXT_ATTRIBUTE))
+        && (dst->ValidAttributes & ALPC_MESSAGE_CONTEXT_ATTRIBUTE))
+    {
+        ALPC_CONTEXT_ATTR *context_dst = alpc_get_message_attribute(dst, ALPC_MESSAGE_CONTEXT_ATTRIBUTE);
