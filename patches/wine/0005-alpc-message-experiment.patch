+
+    if (attributes & ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE)
+    {
+        struct alpc_work_on_behalf_attr_t *dst = wine_server_alpc_get_message_attribute(*ret_msg_attr, ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE);
