+    dst->TotalLength = src->data_len + sizeof(*dst);
+    dst->Type = src->type;
+    dst->MessageId = src->id;
+    dst->ClientId.UniqueProcess = wine_server_ptr_handle( src->unique_process );
+    dst->ClientId.UniqueThread = wine_server_ptr_handle( src->unique_thread );
+    memcpy((unsigned char *)dst + sizeof(*dst), (const unsigned char *)src + sizeof(*src), src->data_len);
