+
+/* Free ret_msg when it's done */
+static unsigned int wine_server_add_alpc_msg( void *req, struct alpc_msg_t **ret_msg, const ALPC_PORT_MESSAGE *msg )
+{
+    unsigned int size;
+    if (!msg)
+    {
+        *ret_msg = NULL;
+        return 0;
+    }
+
+    size = sizeof(struct alpc_msg_t) + msg->DataLength;
+    *ret_msg = malloc(size);
+    if (!*ret_msg)
+        return 0;
+
+    (*ret_msg)->data_len = msg->DataLength;
+    (*ret_msg)->type = msg->Type;
+    (*ret_msg)->id = msg->MessageId;
+    memcpy( (unsigned char *)(*ret_msg) + sizeof(struct alpc_msg_t),
+            (unsigned char *)msg + sizeof(*msg), msg->DataLength );
+    wine_server_add_data( req, *ret_msg, size );
+    return size;
+}
+
+/* Free ret_msg_attr when it's done */
+static unsigned int wine_server_add_alpc_msg_attr( void *req, struct alpc_msg_attr_t **ret_msg_attr,
+                                                   ALPC_MESSAGE_ATTRIBUTES *msg_attr, ULONG mask )
+{
+    unsigned int size;
+    ULONG attributes;
+
+    if (!msg_attr)
+    {
+        *ret_msg_attr = NULL;
+        return 0;
+    }
+
+    /* ALPC_MESSAGE_CONTEXT_ATTRIBUTE and ALPC_MESSAGE_TOKEN_ATTRIBUTE are added by wineserver */
+    mask = mask & ALPC_MESSAGE_ATTRIBUTE_ALL & ~(ALPC_MESSAGE_CONTEXT_ATTRIBUTE | ALPC_MESSAGE_TOKEN_ATTRIBUTE);
+    attributes = msg_attr->ValidAttributes & mask;
+
+    size = wine_server_alpc_get_header_size(attributes);
+    *ret_msg_attr = malloc(size);
+    if (!*ret_msg_attr)
+        return 0;
+
+    (*ret_msg_attr)->attributes = attributes;
+
+    if (attributes & ALPC_MESSAGE_SECURITY_ATTRIBUTE)
+    {
+        const ALPC_SECURITY_ATTR *src = alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_SECURITY_ATTRIBUTE);
+        struct alpc_security_attr_t *dst = wine_server_alpc_get_message_attribute(*ret_msg_attr, ALPC_MESSAGE_SECURITY_ATTRIBUTE);
+
+        dst->flags = src->Flags;
+        dst->context_handle = wine_server_obj_handle(src->ContextHandle);
+        if (src->QoS)
+        {
+            dst->qos.impersonation_level = src->QoS->ImpersonationLevel;
+            dst->qos.context_tracking_mode = src->QoS->ContextTrackingMode;
+            dst->qos.effective_only = src->QoS->EffectiveOnly;
+        }
+        else
+        {
+            dst->qos.impersonation_level = SecurityAnonymous;
+            dst->qos.context_tracking_mode = SECURITY_STATIC_TRACKING;
+            dst->qos.effective_only = FALSE;
+        }
+    }
+
+    if (attributes & ALPC_MESSAGE_VIEW_ATTRIBUTE)
+    {
+        const ALPC_VIEW_ATTR *src = alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+        struct alpc_view_attr_t *dst = wine_server_alpc_get_message_attribute(*ret_msg_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+
+        dst->flags = src->Flags;
+        dst->section_handle = wine_server_obj_handle(src->SectionHandle);
+        dst->view_base = wine_server_client_ptr(src->ViewBase);
+        dst->view_size = src->ViewSize;
+    }
+
+    if (attributes & ALPC_MESSAGE_HANDLE_ATTRIBUTE)
+    {
+        const ALPC_HANDLE_ATTR *src = alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_HANDLE_ATTRIBUTE);
+        struct alpc_handle_attr_t *dst = wine_server_alpc_get_message_attribute(*ret_msg_attr, ALPC_MESSAGE_HANDLE_ATTRIBUTE);
+
+        dst->flags = src->Flags;
+        dst->handle = wine_server_obj_handle(src->Handle);
+        dst->obj_type = src->ObjectType;
+        dst->desired_access = src->DesiredAccess;
+    }
+
+    if (attributes & ALPC_MESSAGE_DIRECT_ATTRIBUTE)
+    {
+        const ALPC_DIRECT_ATTR *src = alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_DIRECT_ATTRIBUTE);
+        struct alpc_direct_attr_t *dst = wine_server_alpc_get_message_attribute(*ret_msg_attr, ALPC_MESSAGE_DIRECT_ATTRIBUTE);
+
+        dst->event = wine_server_obj_handle(src->Event);
