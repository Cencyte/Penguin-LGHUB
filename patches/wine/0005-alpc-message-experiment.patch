+    struct alpc_token_attr_t *token_attr;
+    struct alpc_direct_attr_t *direct_attr;
+    struct alpc_work_on_behalf_attr_t *work_on_behalf_attr;
+
+    msg_attr->attributes = want_attributes & record->msg_attr.attributes;
+
+    if ((security_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_SECURITY_ATTRIBUTE)))
+    {
+        memcpy(security_attr, record->security_attr, sizeof(*record->security_attr));
+        if (record->security_attr->context_handle)
+            security_attr->context_handle = duplicate_handle( port->thread->process, record->security_attr->context_handle,
+                                                              current->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if ((view_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE)))
+    {
+        memcpy(view_attr, record->view_attr, sizeof(*record->view_attr));
+        if (record->view_attr->section_handle)
+            view_attr->section_handle = duplicate_handle( port->thread->process, record->view_attr->section_handle,
+                                                          current->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if ((context_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_CONTEXT_ATTRIBUTE)))
+        memcpy(context_attr, record->context_attr, sizeof(*record->context_attr));
+
+    if ((handle_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_HANDLE_ATTRIBUTE)))
+    {
+        memcpy(handle_attr, record->handle_attr, sizeof(*record->handle_attr));
+        if (record->handle_attr->handle)
+            handle_attr->handle = duplicate_handle( port->thread->process, record->handle_attr->handle,
+                                                    current->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if ((token_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_TOKEN_ATTRIBUTE)))
+        memcpy(token_attr, record->token_attr, sizeof(*record->token_attr));
+
+    if ((direct_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_DIRECT_ATTRIBUTE)))
+    {
+        memcpy(direct_attr, record->direct_attr, sizeof(*record->direct_attr));
+        if (record->direct_attr->event)
+            direct_attr->event = duplicate_handle( port->thread->process, record->direct_attr->event,
+                                                   current->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if ((work_on_behalf_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE)))
+        memcpy(work_on_behalf_attr, record->work_on_behalf_attr, sizeof(*record->work_on_behalf_attr));
+}
+
+static int add_msg_attr_to_record(struct alpc_msg_entry *record, const struct alpc_port *port,
+                                  const struct alpc_msg_attr_t *msg_attr, unsigned int id,
+                                  int add_port_context, client_ptr_t port_context)
+{
+    record->msg_attr.attributes = 0;
+
+    /* Add ALPC_MESSAGE_CONTEXT_ATTRIBUTE when add_port_context is TRUE */
+    if (add_port_context)
+    {
+        if (!(record->context_attr = calloc(1, sizeof(*record->context_attr)))) goto failed;
+
+        record->context_attr->port_context = port_context;
+        record->context_attr->msg_id = id;
+        record->msg_attr.attributes |= ALPC_MESSAGE_CONTEXT_ATTRIBUTE;
+    }
+
+    /* Add ALPC_MESSAGE_TOKEN_ATTRIBUTE on the server side. Current initialized to zero because of
+     * no idea how to use it */
+    if (port->type == CONNECTION_PORT)
+    {
+        if (!(record->token_attr = calloc(1, sizeof(*record->token_attr)))) goto failed;
+
+        record->msg_attr.attributes |= ALPC_MESSAGE_TOKEN_ATTRIBUTE;
+    }
+
+    if (!msg_attr) return 1;
+
+    assert(!(msg_attr->attributes & (ALPC_MESSAGE_CONTEXT_ATTRIBUTE | ALPC_MESSAGE_TOKEN_ATTRIBUTE)));
+    record->msg_attr.attributes |= msg_attr->attributes;
+
+    if (msg_attr->attributes & ALPC_MESSAGE_SECURITY_ATTRIBUTE)
+    {
+        const struct alpc_security_attr_t *src_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_SECURITY_ATTRIBUTE);
+
+        if (!(record->security_attr = malloc(sizeof(*record->security_attr)))) goto failed;
+
+        memcpy(record->security_attr, src_attr, sizeof(*record->security_attr));
+        if (src_attr->context_handle)
+            record->security_attr->context_handle = duplicate_handle( current->process, src_attr->context_handle,
+                                                                      port->thread->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if (msg_attr->attributes & ALPC_MESSAGE_VIEW_ATTRIBUTE)
+    {
+        const struct alpc_view_attr_t *src_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+
+        if (!(record->view_attr = malloc(sizeof(*record->view_attr)))) goto failed;
+
+        memcpy(record->view_attr, src_attr, sizeof(*record->view_attr));
+        if (src_attr->section_handle)
+            record->view_attr->section_handle = duplicate_handle( current->process, src_attr->section_handle,
+                                                                  port->thread->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if (msg_attr->attributes & ALPC_MESSAGE_HANDLE_ATTRIBUTE)
+    {
+        const struct alpc_handle_attr_t *src_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_HANDLE_ATTRIBUTE);
+
+        if (!(record->handle_attr = malloc(sizeof(*record->handle_attr)))) goto failed;
+
+        memcpy(record->handle_attr, src_attr, sizeof(*record->handle_attr));
+        if (src_attr->handle)
+            record->handle_attr->handle = duplicate_handle( current->process, src_attr->handle,
+                                                            port->thread->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if (msg_attr->attributes & ALPC_MESSAGE_DIRECT_ATTRIBUTE)
+    {
+        const struct alpc_direct_attr_t *src_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_DIRECT_ATTRIBUTE);
+
+        if (!(record->direct_attr = calloc(1, sizeof(*record->direct_attr)))) goto failed;
+
+        if (src_attr->event)
+            record->direct_attr->event = duplicate_handle( current->process, src_attr->event,
+                                                           port->thread->process, 0, 0, DUPLICATE_SAME_ACCESS );
+    }
+
+    if (msg_attr->attributes & ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE)
+    {
+        const struct alpc_work_on_behalf_attr_t *src_attr = wine_server_alpc_get_message_attribute(msg_attr, ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE);
+
+        if (!(record->work_on_behalf_attr = malloc(sizeof(*record->work_on_behalf_attr))))
+            goto failed;
+
+        memcpy(record->work_on_behalf_attr, src_attr, sizeof(*record->work_on_behalf_attr));
+    }
+
+    return 1;
+
+failed:
+    record->msg_attr.attributes = 0;
+    if (record->security_attr && record->security_attr->context_handle)
+        close_handle(port->thread->process, record->security_attr->context_handle);
+    if (record->view_attr && record->view_attr->section_handle)
+        close_handle(port->thread->process, record->view_attr->section_handle);
+    if (record->handle_attr && record->handle_attr->handle)
+        close_handle(port->thread->process, record->handle_attr->handle);
+    if (record->direct_attr && record->direct_attr->event)
+        close_handle(port->thread->process, record->direct_attr->event);
+    free(record->security_attr);
+    free(record->view_attr);
+    free(record->context_attr);
+    free(record->handle_attr);
+    free(record->token_attr);
+    free(record->direct_attr);
+    free(record->work_on_behalf_attr);
+    return 0;
+}
+
+static int add_msg_record(struct alpc_port *dst_port, struct alpc_port *src_port,
+                          unsigned short msg_type, const struct alpc_msg_t *msg,
+                          data_size_t msg_size, const struct alpc_msg_attr_t *msg_attr,
+                          int add_port_context, client_ptr_t port_context)
+{
+    struct alpc_msg_entry *entry = NULL;
+    unsigned int id = 0;
+
+    if (!msg) return 0;
+
+    /* Don't allocate a message ID for refused or disconnected ports */
+    if (!(dst_port->status == REFUSED || dst_port->status == DISCONNECTED) && !(id = alloc_msg_id(src_port)))
+        return 0;
+
+    if (msg->data_len + sizeof(ALPC_PORT_MESSAGE) > dst_port->port_attr.max_msg_len)
+    {
+        set_error( STATUS_PORT_MESSAGE_TOO_LONG );
+        goto failed;
+    }
+
+    if (!(entry = calloc(1, sizeof(*entry))))
+    {
+        set_error( STATUS_NO_MEMORY );
+        goto failed;
+    }
+
+    if (!(entry->msg = malloc(msg_size)))
+    {
+        set_error( STATUS_NO_MEMORY );
+        goto failed;
+    }
+
+    memcpy(entry->msg, msg, msg_size);
+    if (!add_msg_attr_to_record(entry, dst_port, msg_attr, id, add_port_context, port_context))
+    {
+        set_error( STATUS_NO_MEMORY );
+        goto failed;
+    }
+    entry->msg->type = msg_type;
+    /* Add tests for this */
+    if (dst_port->type == CONNECTION_PORT && (entry->msg->type == ALPC_MESSAGE_TYPE_REQUEST
+        || entry->msg->type == ALPC_MESSAGE_TYPE_CONNECTION_REQUEST))
+        entry->msg->type |= 0x2000;
+    entry->msg->id = id;
+    entry->msg->unique_thread = current->id;
+    entry->msg->unique_process = current->process->id;
+    list_add_tail(&dst_port->msg_list, &entry->entry);
+    wake_up(&dst_port->obj, 1);
+    return 1;
+
+failed:
+    if (id) free_msg_id(id);
+    if (entry) free(entry->msg);
+    free(entry);
+    return 0;
+}
+
+static void free_msg_record( const struct alpc_port *port, struct alpc_msg_entry *record )
+{
+    if (!record) return;
+
+    if (record->security_attr && record->security_attr->context_handle)
+        close_handle(port->thread->process, record->security_attr->context_handle);
+    if (record->view_attr && record->view_attr->section_handle)
+        close_handle(port->thread->process, record->view_attr->section_handle);
+    if (record->handle_attr && record->handle_attr->handle)
+        close_handle(port->thread->process, record->handle_attr->handle);
+    if (record->direct_attr && record->direct_attr->event)
+        close_handle(port->thread->process, record->direct_attr->event);
+    free(record->msg);
+    free(record->security_attr);
+    free(record->view_attr);
+    free(record->context_attr);
+    free(record->handle_attr);
+    free(record->token_attr);
+    free(record->direct_attr);
+    free(record->work_on_behalf_attr);
+    free(record);
 }
 
