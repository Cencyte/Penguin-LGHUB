+static NTSTATUS alpc_receive_port( HANDLE port_handle, ULONG flags, ALPC_PORT_MESSAGE *recv_msg,
+                                   SIZE_T *recv_buffer_size, ALPC_MESSAGE_ATTRIBUTES *recv_msg_attr,
+                                   void *reply_data, data_size_t reply_data_size, BOOL *wait)
+{
+    NTSTATUS status;
+
+    if (wait) *wait = FALSE;
+
+    SERVER_START_REQ( alpc_receive_port )
+    {
+        req->handle = wine_server_obj_handle(port_handle);
+        req->flags = flags;
+        req->msg_size = recv_buffer_size ? *recv_buffer_size : 65535;
+        req->msg_attributes = recv_msg_attr ? recv_msg_attr->AllocatedAttributes : 0;
+        wine_server_set_reply( req, reply_data, reply_data_size );
+        if (!(status = wine_server_call( req )))
+        {
+            struct alpc_msg_attr_t *server_recv_msg_attr;
+            struct alpc_msg_t *server_recv_msg;
+
+            server_recv_msg = reply_data;
+            server_recv_msg_attr = (struct alpc_msg_attr_t *)((unsigned char *)server_recv_msg
+                                   + sizeof(*server_recv_msg) + server_recv_msg->data_len);
+            if (recv_msg) get_alpc_msg_from_server( recv_msg, server_recv_msg );
+            if (recv_msg_attr) get_alpc_msg_attr_from_server( recv_msg_attr, server_recv_msg_attr );
+        }
+        else if (status == STATUS_BUFFER_TOO_SMALL)
+        {
+            if (recv_buffer_size) *recv_buffer_size = reply->required_size;
+        }
+        else
+        {
+            if (wait) *wait = reply->wait;
+        }
+    }
+    SERVER_END_REQ;
+
+    return status;
+}
 
