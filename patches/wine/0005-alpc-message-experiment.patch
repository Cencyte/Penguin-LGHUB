+static void dump_msg(BOOL send, const ALPC_PORT_MESSAGE *message)
+{
+    unsigned char *ptr;
+
+    if (!TRACE_ON(alpc))
+        return;
+
+    if (!message)
+    {
+        TRACE("%s NULL\n", send ? "sending" : "receiving");
+        return;
+    }
+
+    TRACE("%s %p offset %#x\n", send ? "sending" : "receiving", message,
+          (unsigned int)(message->TotalLength - message->DataLength - sizeof(ALPC_PORT_MESSAGE)));
+    TRACE("header:\n");
+    TRACE("DataLength: %#x\n", message->DataLength);
+    TRACE("TotalLength: %#x\n", message->TotalLength);
+    TRACE("Type: %#x\n", message->Type);
+    TRACE("DataInfoOffset: %#x\n", message->DataInfoOffset);
+    TRACE("ClientId: %p %p\n", message->ClientId.UniqueProcess, message->ClientId.UniqueThread);
+    TRACE("MessageId: %#x\n", message->MessageId);
+    TRACE("ClientViewSize: %#lx\n", message->ClientViewSize);
+
+    TRACE("data:\n");
+    ptr = (unsigned char *)message + sizeof(*message);
+    for (unsigned int i = 0; i < message->DataLength; i++)
+    {
+        if (i && i % 16 == 0)
+            TRACE("\n");
+        TRACE("%02x ", ptr[i]);
+    }
+    TRACE("\n");
+}
+
+static void dump_msg_attr(BOOL send, ALPC_MESSAGE_ATTRIBUTES *attributes)
+{
+    if (!TRACE_ON(alpc))
+        return;
+
+    if (!attributes)
+    {
+        TRACE("%s NULL\n", send ? "sending" : "receiving");
+        return;
+    }
+
+    TRACE("%s %p allocated %#x valid %#x\n", send ? "sending" : "receiving", attributes, attributes->AllocatedAttributes, attributes->ValidAttributes);
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_SECURITY_ATTRIBUTE)
+    {
+        ALPC_SECURITY_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_SECURITY_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_SECURITY_ATTRIBUTE: Flags %#x ContextHandle %p QoS %p",
+              attr->Flags, attr->ContextHandle, attr->QoS);
+        if (attr->QoS)
+            TRACE( "(Length %#x ImpersonationLevel %d ContextTrackingMode %d EffectiveOnly %d)",
+                   attr->QoS->Length, attr->QoS->ImpersonationLevel, attr->QoS->ContextTrackingMode,
+                   attr->QoS->EffectiveOnly );
+        TRACE("\n");
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_VIEW_ATTRIBUTE)
+    {
+        ALPC_VIEW_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_VIEW_ATTRIBUTE: Flags %#x SectionHandle %p ViewBase %p ViewSize %#lx\n",
+              attr->Flags, attr->SectionHandle, attr->ViewBase, attr->ViewSize);
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_CONTEXT_ATTRIBUTE)
+    {
+        ALPC_CONTEXT_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_CONTEXT_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_CONTEXT_ATTRIBUTE: PortContext %p MessageContext %p Sequence %#x "
+              "MessageId %#x CallbackId %#x\n",
+              attr->PortContext, attr->MessageContext, attr->Sequence, attr->MessageId,
+              attr->CallbackId);
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_HANDLE_ATTRIBUTE)
+    {
+        ALPC_HANDLE_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_HANDLE_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_HANDLE_ATTRIBUTE: Flags %#x Handle %p ObjectType %#x DesiredAccess %#x\n",
+              attr->Flags, attr->Handle, attr->ObjectType, attr->DesiredAccess);
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_TOKEN_ATTRIBUTE)
+    {
+        ALPC_TOKEN_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_TOKEN_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_TOKEN_ATTRIBUTE: TokenId %s AuthenticationId %s ModifiedId %s\n",
+              wine_dbgstr_longlong(attr->TokenId), wine_dbgstr_longlong(attr->AuthenticationId),
+              wine_dbgstr_longlong(attr->ModifiedId));
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_DIRECT_ATTRIBUTE)
+    {
+        ALPC_DIRECT_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_DIRECT_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_DIRECT_ATTRIBUTE: Event %p\n", attr->Event);
+    }
+
+    if (attributes->ValidAttributes & ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE)
+    {
+        ALPC_WORK_ON_BEHALF_ATTR *attr = alpc_get_message_attribute(attributes, ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE);
+
+        TRACE("ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE: Ticket %s\n", wine_dbgstr_longlong(attr->Ticket));
+    }
+}
