+/* Send a message and attributes to an ALPC object */
+DECL_HANDLER(alpc_send_port)
+{
+    struct alpc_port *port, *dst_port = NULL;
+    const struct alpc_msg_t *msg = NULL;
+    const struct alpc_msg_attr_t *msg_attr = NULL;
+    const unsigned char *data_ptr = get_req_data();
+    unsigned short msg_type;
+
+    port = get_alpc_port_obj( current->process, req->handle, ALPC_PORT_QUERY_STATE);
+    if (!port) return;
+
+    assert(req->msg_size);
+    msg = (const struct alpc_msg_t *)data_ptr;
+    data_ptr += req->msg_size;
+
+    if (req->msg_attr_size) msg_attr = (const struct alpc_msg_attr_t *)data_ptr;
+
+    if (port->type == CONNECTION_PORT)
+    {
+        /* Send to itself if message ID is zero */
+        if (!msg->id)
+            dst_port = (struct alpc_port *)grab_object(port);
+        else
+            dst_port = get_alpc_msg_id_entry( msg->id );
+
+        if (!dst_port)
+        {
+            release_object(port);
+            set_error(STATUS_ACCESS_DENIED);
+            return;
+        }
+    }
+    else
+    {
+        dst_port = port->dst_port;
+
+        if (port->status == UNINITIALIZED)
+        {
+            set_error( STATUS_LPC_REQUESTS_NOT_ALLOWED );
+            goto failed;
+        }
+        else if (port->status == REFUSED)
+        {
+            set_error( STATUS_PORT_CONNECTION_REFUSED );
+            goto failed;
+        }
+        else if (port->status == DISCONNECTED || (dst_port->type == CONNECTION_PORT && dst_port->status == DISCONNECTED))
+        {
+            set_error( STATUS_PORT_DISCONNECTED );
+            goto failed;
+        }
+        /* If sending with the server side communication port and no valid message ID */
+        else if (dst_port->type == COMMUNICATION_PORT && !msg->id)
+        {
+            set_error( STATUS_LPC_REQUESTS_NOT_ALLOWED );
+            goto failed;
+        }
+    }
+
+    if (req->flags & ALPC_MSGFLG_REPLY_MESSAGE)
+        msg_type = dst_port->type == CONNECTION_PORT ? ALPC_MESSAGE_TYPE_DATAGRAM : ALPC_MESSAGE_TYPE_REPLY;
+    else
+        msg_type = ALPC_MESSAGE_TYPE_REQUEST;
+
+    if (add_msg_record(dst_port, port, msg_type, msg, req->msg_size, msg_attr, 1, port->port_context))
+        free_msg_id(msg->id);
+
+failed:
+    if (port->type == CONNECTION_PORT && dst_port) release_object( dst_port );
+    release_object( port );
+}
+
+/* Receive a message and attributes from an ALPC object */
+DECL_HANDLER(alpc_receive_port)
+{
+    data_size_t size, msg_size = 0, msg_attr_size = 0;
+    unsigned char *reply_data;
+    struct alpc_msg_entry *record;
+    struct alpc_port *port;
+
+    port = get_alpc_port_obj( current->process, req->handle, ALPC_PORT_QUERY_STATE );
+    if (!port) return;
+
+    if (port->type == COMMUNICATION_PORT)
+    {
+        if (port->status == UNINITIALIZED)
+        {
+            if (port->port_attr.flags & ALPC_PORTFLG_NON_BLOCKING_RECEIVE)
+            {
+                set_error( STATUS_UNSUCCESSFUL );
+                reply->wait = FALSE;
+            }
+            else
+            {
+                set_error( STATUS_LPC_REQUESTS_NOT_ALLOWED );
+                reply->wait = TRUE;
+            }
+            goto failed;
+        }
+        else if (port->status == REFUSED)
+        {
+            set_error( STATUS_PORT_CONNECTION_REFUSED );
+            goto failed;
+        }
+        else if (port->status == DISCONNECTED)
+        {
+            set_error( STATUS_PORT_DISCONNECTED );
+            goto failed;
+        }
+    }
+
+    if (list_empty(&port->msg_list))
+    {
+        reply->wait = !(port->port_attr.flags & ALPC_PORTFLG_NON_BLOCKING_RECEIVE);
+        set_error( STATUS_UNSUCCESSFUL );
+        goto failed;
+    }
+
+    /* receive message */
+    record = LIST_ENTRY(list_head(&port->msg_list), struct alpc_msg_entry, entry);
+    msg_size = sizeof(*record->msg) + record->msg->data_len;
+    /* Compare with ALPC_PORT_MESSAGE as well */
+    if (req->msg_size < msg_size || req->msg_size  < sizeof(ALPC_PORT_MESSAGE) + record->msg->data_len)
+    {
+        set_error( STATUS_BUFFER_TOO_SMALL );
+        reply->required_size = sizeof(ALPC_PORT_MESSAGE) + record->msg->data_len;
+        goto failed;
+    }
+
+    size = msg_size;
+    if (req->msg_attributes)
+    {
+        msg_attr_size = wine_server_alpc_get_header_size(req->msg_attributes & record->msg_attr.attributes);
+        size += msg_attr_size;
+    }
+
+    if (get_reply_max_size() < size)
+    {
+        set_error( STATUS_BUFFER_TOO_SMALL );
+        reply->required_size = sizeof(ALPC_PORT_MESSAGE) + record->msg->data_len;
+        goto failed;
+    }
+
+    reply_data = set_reply_data_size(size);
+    if (!reply_data)
+    {
+        set_error( STATUS_NO_MEMORY );
+        goto failed;
+    }
+
+    memcpy( reply_data, record->msg, msg_size );
+    if (msg_attr_size)
+        get_msg_attr_from_record( port, req->msg_attributes, (struct alpc_msg_attr_t *)(reply_data + msg_size), record );
+    list_remove( &record->entry );
+    free_msg_record( port, record );
+
+failed:
+    release_object( port );
+}
+
+/* Disconnect an ALPC object */
+DECL_HANDLER(alpc_disconnect_port)
+{
+    struct alpc_port *port;
+
+    port = get_alpc_port_obj( current->process, req->handle, DELETE);
+    if (!port) return;
+
+    alpc_port_disconnect( port );
+    release_object( port );
+}
+
+/* Impersonate the client of an ALPC port */
+DECL_HANDLER(alpc_impersonate_client_of_port)
+{
+    struct alpc_port *port, *impersonate_port;
+    struct token *token;
+
+    port = get_alpc_port_obj( current->process, req->handle, ALPC_PORT_QUERY_STATE);
+    if (!port) return;
+
+    if (port->type == COMMUNICATION_PORT)
+    {
+        if (port->status != CONNECTED)
+        {
+            release_object( port );
+            set_error( STATUS_INVALID_PARAMETER );
+            return;
+        }
+
+        if (port->dst_port->type == CONNECTION_PORT)
+        {
+            if (!(port->dst_port->port_attr.flags & ALPC_PORTFLG_ALLOWIMPERSONATION))
+            {
+                release_object( port );
+                set_error( STATUS_ACCESS_DENIED );
+                return;
+            }
+        }
+        else
+        {
+            if (!(port->dst_port->port_attr.flags & ALPC_PORTFLG_ALLOWIMPERSONATION &&
+                port->dst_port->port_attr.qos.context_tracking_mode == SECURITY_STATIC_TRACKING))
+            {
+                release_object( port );
+                set_error( STATUS_ACCESS_DENIED );
+                return;
+            }
+
+            if (port->dst_port->port_attr.qos.impersonation_level == SecurityAnonymous)
+            {
+                release_object( port );
+                return;
+            }
+        }
+
+        impersonate_port = (struct alpc_port *)grab_object( port->dst_port );
+    }
+    else
+    {
+        if (!(port->port_attr.flags & ALPC_PORTFLG_ALLOWIMPERSONATION))
+        {
+            release_object( port );
+            set_error( STATUS_ACCESS_DENIED );
+            return;
+        }
+
+        impersonate_port = get_alpc_msg_id_entry( req->msg_id );
+        if (!impersonate_port)
+        {
+            release_object( port );
+            set_error( STATUS_INVALID_PARAMETER );
+            return;
+        }
+    }
+
+    if (!(token = token_duplicate( impersonate_port->thread->token ?
+                                   impersonate_port->thread->token : impersonate_port->thread->process->token,
+                                   0, SecurityImpersonation, NULL, NULL, 0, NULL, 0 )))
+    {
+        release_object( impersonate_port );
+        release_object( port );
+        return;
+    }
+
+    if (current->token) release_object( current->token );
+    current->token = token;
+
+    release_object( impersonate_port );
+    release_object( port );
+}
