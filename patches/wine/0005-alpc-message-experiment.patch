+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+#ifndef __WINE_WINE_ALPC_H
+#define __WINE_WINE_ALPC_H
+
+/* Same as AlpcGetHeaderSize() but for the corresponding wine server data types */
+static inline unsigned int wine_server_alpc_get_header_size( unsigned int attribute_flags )
+{
+    static const struct
+    {
+        unsigned int attribute;
+        unsigned int size;
+    } attribute_sizes[] =
+    {
+        /* Attribute with a higher bit is stored before that with a lower bit */
+        {ALPC_MESSAGE_SECURITY_ATTRIBUTE, sizeof(struct alpc_security_attr_t)},
+        {ALPC_MESSAGE_VIEW_ATTRIBUTE, sizeof(struct alpc_view_attr_t)},
+        {ALPC_MESSAGE_CONTEXT_ATTRIBUTE, sizeof(struct alpc_context_attr_t)},
+        {ALPC_MESSAGE_HANDLE_ATTRIBUTE, sizeof(struct alpc_handle_attr_t)},
+        {ALPC_MESSAGE_TOKEN_ATTRIBUTE, sizeof(struct alpc_token_attr_t)},
+        {ALPC_MESSAGE_DIRECT_ATTRIBUTE, sizeof(struct alpc_direct_attr_t)},
+        {ALPC_MESSAGE_WORK_ON_BEHALF_ATTRIBUTE, sizeof(struct alpc_work_on_behalf_attr_t)},
+    };
+    unsigned int i, size;
+
+    size = sizeof(struct alpc_msg_attr_t);
+    for (i = 0; i < ARRAY_SIZE(attribute_sizes); i++)
+    {
+        if (attribute_flags & attribute_sizes[i].attribute)
+            size += attribute_sizes[i].size;
+    }
+
+    return size;
+}
+
+/* Same as AlpcGetMessageAttribute() but for the corresponding wine server data types */
+static inline void *wine_server_alpc_get_message_attribute( const struct alpc_msg_attr_t *attributes, unsigned int attribute_flag )
+{
+    /* If no flag is specified */
+    if (!attribute_flag)
+        return NULL;
+
+    /* If more than one flag is specified */
+    if (attribute_flag & (attribute_flag - 1))
+        return NULL;
+
+    /* If the specified flag is not in allocated attributes */
+    if ((attribute_flag & attributes->attributes & ALPC_MESSAGE_ATTRIBUTE_ALL) != attribute_flag)
+        return NULL;
+
+    return (unsigned char *)attributes + wine_server_alpc_get_header_size(attributes->attributes & ~(attribute_flag | (attribute_flag - 1)));
+}
+
+#endif /* __WINE_WINE_ALPC_H */
