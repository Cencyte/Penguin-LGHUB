+        to->max_view_size = 0xffffffff;
+        to->max_total_section_size = 0xffffffff;
+        to->dup_object_types = 0xffffffff;
+        to->qos.impersonation_level = SecurityAnonymous;
+        to->qos.context_tracking_mode = SECURITY_STATIC_TRACKING;
+        to->qos.effective_only = 0;
