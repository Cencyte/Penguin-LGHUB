+        handle_dst->ObjectType = handle_src->obj_type;
+        handle_dst->DesiredAccess = handle_src->desired_access;
+    }
+
+    if ((token_src = wine_server_alpc_get_message_attribute(src, ALPC_MESSAGE_TOKEN_ATTRIBUTE))
+        && (dst->ValidAttributes & ALPC_MESSAGE_TOKEN_ATTRIBUTE))
+    {
+        ALPC_TOKEN_ATTR *token_dst = alpc_get_message_attribute(dst, ALPC_MESSAGE_TOKEN_ATTRIBUTE);
+
+        token_dst->TokenId = token_src->token_id;
+        token_dst->AuthenticationId = token_src->auth_id;
+        token_dst->ModifiedId = token_src->modified_id;
+    }
+
+    if ((direct_src = wine_server_alpc_get_message_attribute(src, ALPC_MESSAGE_DIRECT_ATTRIBUTE))
+        && (dst->ValidAttributes & ALPC_MESSAGE_DIRECT_ATTRIBUTE))
+    {
