+/* allocate a new ALPC msg id */
+static unsigned int alloc_msg_id( struct alpc_port *src_port )
+{
+    struct alpc_msg_id_entry *entry;
+    unsigned int id;
+
+    if (used_msg_id_entries < allocated_msg_id_entries)
+    {
+        id = used_msg_id_entries + ALPC_MSG_ID_OFFSET;
+        entry = &msg_id_entries[used_msg_id_entries++];
+    }
+    else if (next_free_msg_id && num_free_msg_id >= 256)
+    {
+        id = next_free_msg_id;
+        entry = &msg_id_entries[id - ALPC_MSG_ID_OFFSET];
+        if (!(next_free_msg_id = entry->next)) last_free_msg_id = 0;
+        num_free_msg_id--;
+    }
+    else  /* need to grow the array */
+    {
+        unsigned int count = allocated_msg_id_entries + (allocated_msg_id_entries / 2);
+        if (!count) count = 512;
+        if (!(entry = realloc( msg_id_entries, count * sizeof(*entry) )))
+        {
+            set_error( STATUS_NO_MEMORY );
+            return 0;
+        }
+        msg_id_entries = entry;
+        allocated_msg_id_entries = count;
+        id = used_msg_id_entries + ALPC_MSG_ID_OFFSET;
+        entry = &msg_id_entries[used_msg_id_entries++];
+    }
+
+    entry->src_port = src_port;
+    return id;
+}
+
+/* free an ALPC message id */
+static void free_msg_id( unsigned int id )
+{
+    struct alpc_msg_id_entry *entry;
+
+    if (id < ALPC_MSG_ID_OFFSET) return;
+    if (id - ALPC_MSG_ID_OFFSET >= used_msg_id_entries) return;
+    if (!msg_id_entries[id - ALPC_MSG_ID_OFFSET].src_port) return;
+
+    entry = &msg_id_entries[id - ALPC_MSG_ID_OFFSET];
+    entry->src_port = NULL;
+    entry->next = 0;
+
+    /* append to end of free list so that we don't reuse it too early */
+    if (last_free_msg_id) msg_id_entries[last_free_msg_id - ALPC_MSG_ID_OFFSET].next = id;
+    else next_free_msg_id = id;
+    last_free_msg_id = id;
+    num_free_msg_id++;
+}
+
+/* retrieve the src port corresponding to a msg */
+struct alpc_port *get_alpc_msg_id_entry( unsigned int id )
+{
+    if (id < ALPC_MSG_ID_OFFSET) return NULL;
+    if (id - ALPC_MSG_ID_OFFSET >= used_msg_id_entries) return NULL;
+    if (!msg_id_entries[id - ALPC_MSG_ID_OFFSET].src_port) return NULL;
+    return (struct alpc_port *)grab_object(msg_id_entries[id - ALPC_MSG_ID_OFFSET].src_port);
