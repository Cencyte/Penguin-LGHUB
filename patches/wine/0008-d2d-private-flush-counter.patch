+/* ID2DPrivateInfo used by native Direct2D. The count follows real backend
+ * flushes and successful presentation submissions, not GPU completion. */
+static const GUID d2d_private_info_iid = {0xb79cc8da,0x337f,0x400f,{0xb0,0x9d,0xb2,0xed,0xf8,0xa8,0x4e,0x47}};
+static struct d3d_device *d2d_info_device(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_device, d2d_private_info);
+}
+static HRESULT WINAPI d2d_info_query(IUnknown *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    return IUnknown_QueryInterface(d2d_info_device(iface)->outer_unk, iid, out);
+}
+static ULONG WINAPI d2d_info_addref(IUnknown *iface)
+{
+    return IUnknown_AddRef(d2d_info_device(iface)->outer_unk);
+}
+static ULONG WINAPI d2d_info_release(IUnknown *iface)
+{
+    return IUnknown_Release(d2d_info_device(iface)->outer_unk);
+}
+static UINT64 WINAPI d2d_info_flush_count(IUnknown *iface)
+{
+    UINT64 count = wined3d_device_get_conservative_flush_count(d2d_info_device(iface)->wined3d_device);
+    TRACE("iface %p, conservative flush count %I64u.\n", iface, count);
+    return count;
+}
+static const struct
+{
+    HRESULT (WINAPI *QueryInterface)(IUnknown *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IUnknown *);
+    ULONG (WINAPI *Release)(IUnknown *);
+    UINT64 (WINAPI *ConservativeFlushCount)(IUnknown *);
+} d2d_info_vtable = {d2d_info_query, d2d_info_addref, d2d_info_release, d2d_info_flush_count};
