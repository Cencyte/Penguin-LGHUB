+ *
+ * Composite into a separate output bitmap, never the retained GDI bitmap.
+ * This prevents repeated paints from blending an old composition again.
+ */
+struct child_frame
+{
+    struct child_frame *next;
+    RECT window, surface;
+    RECT *clips;
+    UINT count, width, height;
+    BYTE *pixels;
+};
+struct child_composite_surface
+{
+    struct window_surface header;
+    struct window_surface *target;
+    struct child_frame *frames;
+    RECT screen;
+    unsigned int generation;
+};
+static const struct window_surface_funcs child_composite_funcs;
+
+BOOL child_composition_enabled(void)
+{
+    const char *value = getenv("WINE_GHUB_CHILD_COMPOSITION");
+    return value && !strcmp(value,"1");
+}
+static const struct window_surface_funcs child_buffer_funcs =
+{
+    offscreen_window_surface_set_clip, offscreen_window_surface_flush, offscreen_window_surface_destroy
+};
+BOOL is_child_composite_surface(struct window_surface *surface)
+{
+    return surface && surface->funcs == &child_buffer_funcs;
+}
+static void create_child_buffer(HWND hwnd, const RECT *rect, struct window_surface **out)
+{
+    BITMAPINFO info = {0};
+    struct window_surface *previous = *out;
+    if (is_child_composite_surface(previous) && EqualRect(&previous->rect, rect)) return;
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = rect->right - rect->left;
+    info.bmiHeader.biHeight = rect->top - rect->bottom;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biSizeImage = get_dib_image_size(&info);
+    *out = window_surface_create(sizeof(**out), &child_buffer_funcs, hwnd, rect, &info, 0);
+    if (previous) window_surface_release(previous);
+}
+static void free_child_frames(struct child_frame *frame)
+{
+    while (frame)
+    {
+        struct child_frame *next = frame->next;
+        free(frame->pixels); free(frame->clips); free(frame); frame = next;
+    }
+}
+static BOOL child_frame_region(HWND hwnd, UINT flags, struct child_frame *frame)
+{
+    NTSTATUS status;
+    size_t size = 256;
+    do
+    {
+        RECT *clips = malloc(size);
+        if (!clips) return FALSE;
+        SERVER_START_REQ(get_visible_region)
+        {
+            req->window = wine_server_user_handle(hwnd);
+            req->flags = flags;
+            wine_server_set_reply(req, clips, size);
+            if (!(status = wine_server_call(req)))
+            {
+                frame->clips = clips;
+                frame->count = wine_server_reply_size(reply) / sizeof(RECT);
+                frame->window = wine_server_get_rect(reply->win_rect);
+            }
+            else size = reply->total_size;
+        }
+        SERVER_END_REQ;
+        if (status) free(clips);
+    } while (status == STATUS_BUFFER_OVERFLOW);
+    return !status;
+}
+/* A below-child composition target stays below every ordinary child even if
+ * that child is later inserted below our transparent helper HWND. The parent's
+ * client DC clip excludes all opaque children regardless of insertion order. */
+static BOOL below_child_buffer(HWND hwnd)
+{
+    return NtUserGetProp(hwnd, u"GHUB.DComp.BelowChildBuffer.v1") == (HANDLE)1;
+}
+static BOOL snapshot_child_region(HWND hwnd, struct child_frame *frame)
+{
+    struct child_frame parent = {0};
+    RECT *clips;
+    size_t count = 0, i, j;
+    if (!child_frame_region(hwnd, DCX_WINDOW | DCX_CLIPSIBLINGS | DCX_CLIPCHILDREN, frame)) return FALSE;
+    if (!below_child_buffer(hwnd) || !frame->count) return TRUE;
+    if (!child_frame_region(NtUserGetAncestor(hwnd, GA_PARENT), DCX_CLIPCHILDREN, &parent)) return FALSE;
+    if (parent.count && frame->count > SIZE_MAX / parent.count / sizeof(RECT))
+    {
+        free(parent.clips);
+        return FALSE;
+    }
+    clips = malloc(max(1, (size_t)parent.count * frame->count) * sizeof(RECT));
+    if (!clips) { free(parent.clips); return FALSE; }
+    for (i = 0; i < frame->count; i++)
+        for (j = 0; j < parent.count; j++)
+            if (intersect_rect(&clips[count], &frame->clips[i], &parent.clips[j])) count++;
+    free(parent.clips);
+    free(frame->clips);
+    frame->clips = clips;
+    frame->count = count;
+    return TRUE;
+}
+/* Capture child buffers before taking the parent's surface lock. Never nest
+ * surface locks with the user lock or another child's surface lock. */
+static BOOL snapshot_child_frames(HWND parent, struct child_frame ***tail, UINT depth)
+{
+    HWND *children = list_window_children(parent);
+    UINT count = 0, index, pass;
+    BOOL ret = TRUE;
+    if (!children) return TRUE;
+    while (children[count]) count++;
+    if (depth > 64) { free(children); return FALSE; }
+    for (pass = 0; pass < 2 && ret; pass++)
+    for (index = count; index-- && ret;)
+    {
+        struct window_surface *surface = NULL;
+        struct child_frame *frame = NULL;
+        HWND hwnd = children[index];
+        WND *win;
+        if (below_child_buffer(hwnd) != (pass == 0)) continue;
+        win = get_win_ptr(hwnd);
+        if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) continue;
+        if (is_child_composite_surface(win->surface))
+        {
+            surface = win->surface;
+            window_surface_add_ref(surface);
+        }
+        release_win_ptr(win);
+        if (surface)
+        {
+            char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+            BITMAPINFO *info = (BITMAPINFO *)buffer;
+            const void *bits;
+            if (!(frame = calloc(1, sizeof(*frame))) || !snapshot_child_region(hwnd, frame)) ret = FALSE;
+            else if (frame->count)
+            {
+                window_surface_lock(surface);
+                bits = window_surface_get_color(surface, info);
+                if (!bits || info->bmiHeader.biBitCount != 32 || info->bmiHeader.biHeight >= 0 ||
+                    surface->alpha_mask != 0xff000000 || surface->color_key != CLR_INVALID) ret = FALSE;
+                else
+                {
+                    frame->width = info->bmiHeader.biWidth;
+                    frame->height = -info->bmiHeader.biHeight;
+                    frame->surface = surface->rect;
+                    if (!(frame->pixels = malloc(info->bmiHeader.biSizeImage))) ret = FALSE;
+                    else memcpy(frame->pixels, bits, info->bmiHeader.biSizeImage);
+                }
+                window_surface_unlock(surface);
+            }
+            window_surface_release(surface);
+            if (ret && frame->count)
+            {
+                **tail = frame; *tail = &frame->next; frame = NULL;
+            }
+            free_child_frames(frame);
+        }
+        if (ret) ret = snapshot_child_frames(hwnd, tail, depth + 1);
+    }
+    free(children);
+    return ret;
+}
+static struct child_frame *prepare_child_frames(struct window_surface *surface, RECT *screen, BOOL *ok)
+{
+    struct child_frame *head = NULL, **tail = &head;
+    struct window_rects rects;
+    *ok = get_window_rects(surface->hwnd, COORDS_SCREEN, &rects, get_dpi_for_window(surface->hwnd));
+    if (*ok)
+    {
+        *screen = rects.visible;
+        *ok = snapshot_child_frames(surface->hwnd, &tail, 0);
+    }
+    return head;
+}
+static void child_composite_set_clip(struct window_surface *surface, const RECT *rects, UINT count)
+{
+    struct child_composite_surface *composite = (void *)surface;
+    window_surface_set_clip(composite->target, surface->clip_region);
+}
+static BOOL child_composite_flush(struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                                 const BITMAPINFO *info, const void *bits, BOOL shape_changed,
+                                 const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    struct child_composite_surface *composite = (void *)surface;
+    struct window_surface *target = composite->target;
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *target_info = (BITMAPINFO *)buffer;
+    struct child_frame *frame;
+    BYTE *dest;
+    UINT width = info->bmiHeader.biWidth, height = -info->bmiHeader.biHeight;
+    RECT bounds = {0, 0, width, height};
+    int origin_x = composite->screen.left + surface->rect.left;
+    int origin_y = composite->screen.top + surface->rect.top;
+    BOOL ret = FALSE;
+    window_surface_lock(target);
+    dest = window_surface_get_color(target, target_info);
+    if (!dest || target_info->bmiHeader.biBitCount != 32 ||
+        target_info->bmiHeader.biWidth != width || -target_info->bmiHeader.biHeight != height) goto done;
+    memcpy(dest, bits, info->bmiHeader.biSizeImage);
+    for (frame = composite->frames; frame; frame = frame->next)
+    {
+        UINT i;
+        for (i = 0; i < frame->count; i++)
+        {
+            RECT clip = frame->clips[i], src_bounds;
+            int x, y;
+            SetRect(&src_bounds, frame->window.left + frame->surface.left,
+                    frame->window.top + frame->surface.top,
+                    frame->window.left + frame->surface.left + frame->width,
+                    frame->window.top + frame->surface.top + frame->height);
+            intersect_rect(&clip, &clip, &src_bounds);
+            OffsetRect(&clip, -origin_x, -origin_y);
+            intersect_rect(&clip, &clip, &bounds);
+            for (y = clip.top; y < clip.bottom; y++)
+            {
+                const BYTE *src = frame->pixels + ((y + origin_y - src_bounds.top) * frame->width +
+                                                  clip.left + origin_x - src_bounds.left) * 4;
+                BYTE *dst = dest + (y * width + clip.left) * 4;
+                for (x = clip.left; x < clip.right; x++, src += 4, dst += 4)
+                {
+                    UINT inverse = 255 - src[3], c;
+                    for (c = 0; c < 4; c++) dst[c] = min(255, src[c] + (dst[c] * inverse + 127) / 255);
+                }
+            }
+        }
+    }
+    target->bounds = bounds;
+    ret = TRUE;
+done:
+    window_surface_unlock(target);
+    if (ret)
+    {
+        window_surface_set_layered(target, surface->color_key, surface->alpha_bits, surface->alpha_mask);
+        window_surface_set_shape(target, surface->shape_region);
+        window_surface_flush(target);
+    }
+    return ret;
+}
+static void child_composite_destroy(struct window_surface *surface)
+{
+    struct child_composite_surface *composite = (void *)surface;
+    window_surface_release(composite->target);
+}
+static const struct window_surface_funcs child_composite_funcs =
+{
+    child_composite_set_clip, child_composite_flush, child_composite_destroy
+};
+static void wrap_child_composite_surface(HWND hwnd, struct window_surface **surface)
+{
+    struct child_composite_surface *composite;
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *target = *surface;
+    const void *bits;
+    if (!target || target == &dummy_surface || !child_composition_enabled() ||
+        NtUserGetAncestor(hwnd, GA_ROOT) != hwnd || target->funcs == &child_composite_funcs) return;
+    window_surface_lock(target);
+    bits = window_surface_get_color(target, info);
+    window_surface_unlock(target);
+    if (!bits) return;
+    if (info->bmiHeader.biBitCount != 32 || info->bmiHeader.biHeight >= 0) return;
+    composite = (void *)window_surface_create(sizeof(*composite), &child_composite_funcs, hwnd, &target->rect, info, 0);
+    if (!composite) return;
+    composite->target = target; /* consume caller's reference */
+    *surface = &composite->header;
+}
+void dirty_child_composite_parent(HWND hwnd)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct window_surface *surface = NULL;
+    WND *win;
+    if (!root || !(win = get_win_ptr(root))) return;
+    if (win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    if (win->surface && win->surface->funcs == &child_composite_funcs)
+    {
+        surface = win->surface;
+        window_surface_add_ref(surface);
+    }
+    release_win_ptr(win);
+    if (!surface) return;
+    window_surface_lock(surface);
+    ((struct child_composite_surface *)surface)->generation++;
+    surface->bounds = surface->rect;
+    OffsetRect(&surface->bounds, -surface->rect.left, -surface->rect.top);
+    window_surface_unlock(surface);
+    window_surface_release(surface);
+}
