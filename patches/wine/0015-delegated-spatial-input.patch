+/* Spatial input delegation for the isolated G HUB runtime. */
+BOOL WINAPI NtUserDelegateInput( DWORD tid, void *callback, void *context, HWND hwnd, UINT mask )
+{
+    const char *enabled = getenv( "WINE_GHUB_INPUT_DELEGATION" );
+    BOOL ret;
+    if (!enabled || strcmp( enabled, "1" ) || sizeof(void *) != 8)
+    {
+        RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
+        return FALSE;
+    }
+    SERVER_START_REQ( delegate_input )
+    {
+        req->tid = tid;
+        req->win = wine_server_user_handle( hwnd );
+        req->mask = mask;
+        req->callback = wine_server_client_ptr( callback );
+        req->context = wine_server_client_ptr( context );
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+    TRACE( "delegate tid=%u hwnd=%p callback=%p context=%p mask=%x ret=%u error=%u\n",
+           tid, hwnd, callback, context, mask, ret, RtlGetLastWin32Error() );
+    return ret;
+}
+
+BOOL WINAPI NtUserUndelegateInput( HWND hwnd, UINT disposition )
+{
+    BOOL ret;
+    SERVER_START_REQ( undelegate_input )
+    {
+        req->win = wine_server_user_handle( hwnd );
+        req->disposition = disposition;
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
+
+BOOL WINAPI NtUserHandleDelegatedInput( const MSG *message, UINT disposition )
+{
+    MSG msg = {0};
+    BOOL ret;
+    if (disposition < 1 || disposition > 3)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* Disposition 3 leaves the pending input alone, without probing MSG. */
+    if (disposition != 3 && NtReadVirtualMemory( GetCurrentProcess(), message, &msg, sizeof(msg), NULL ))
+    {
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+    SERVER_START_REQ( handle_delegated_input )
+    {
+        req->id = 0;
+        req->disposition = disposition;
+        req->win = wine_server_user_handle( msg.hwnd );
+        req->msg = msg.message;
+        req->wparam = msg.wParam;
+        req->lparam = msg.lParam;
+        req->time = msg.time;
+        req->x = msg.pt.x;
+        req->y = msg.pt.y;
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
+
+static void call_input_delegate( const MSG *msg, const struct delegated_msg_data *data )
+{
+    struct input_delegate_params params;
+    void *ret_ptr;
+    ULONG ret_len, disposition = 3;
+    unsigned int id = data->id;
+    params.callback = data->callback;
+    params.context = data->context;
+    memset( &params.msg, 0, sizeof(params.msg) );
+    params.msg.hwnd = msg->hwnd;
+    params.msg.message = msg->message;
+    params.msg.wParam = msg->wParam;
+    params.msg.lParam = msg->lParam;
+    params.msg.time = msg->time;
+    params.msg.pt = msg->pt;
+    if (!KeUserModeCallback( NtUserCallInputDelegate, &params, sizeof(params), &ret_ptr, &ret_len ) &&
+        ret_len == sizeof(ULONG))
+        disposition = *(ULONG *)ret_ptr;
+    if (disposition != 1 && disposition != 2) disposition = 3;
+    SERVER_START_REQ( handle_delegated_input )
+    {
+        req->id = id;
+        req->disposition = disposition;
+        wine_server_call( req ); /* Unregister/destroy during callback may already have cancelled it. */
+    }
+    SERVER_END_REQ;
+}
