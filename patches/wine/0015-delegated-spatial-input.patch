+/* Input delegation is owned by live threads/windows, never by client memory.
+ * Only QS_POINTER is implemented; other native masks fail explicitly. */
+struct input_delegation
+{
+    struct list entry;
+    struct thread *owner, *delegate; /* cleared by free_msg_queue before thread destruction */
+    user_handle_t win;
+    client_ptr_t callback, context;
+};
+struct delegated_input
+{
+    struct list entry;
+    struct input_delegation *binding;
+    struct message *message, *notification;
+    unsigned int id;
+    unsigned int state; /* 0=queued callback, 1=in flight, 2=deferred */
+};
+static struct list input_delegations = LIST_INIT(input_delegations);
+static struct list delegated_inputs = LIST_INIT(delegated_inputs);
+
+static struct input_delegation *find_input_delegation( user_handle_t win )
+{
+    struct input_delegation *binding;
+    LIST_FOR_EACH_ENTRY( binding, &input_delegations, struct input_delegation, entry )
+        if (binding->win == win) return binding;
+    return NULL;
+}
+
+static void finish_delegated_input( struct delegated_input *input, unsigned int disposition )
+{
+    struct input_delegation *binding = input->binding;
+    struct message *msg = input->message;
+    if (input->notification)
+        remove_queue_message( binding->delegate->queue, input->notification, SEND_MESSAGE );
+    list_remove( &input->entry );
+    if (disposition == 1 && binding->owner->queue && get_user_object( binding->win, NTUSER_OBJ_WINDOW ))
+    {
+        /* Resume the original hardware path. Do not re-inject or delegate a second time. */
+        list_add_tail( &binding->owner->queue->input->msg_list, &msg->entry );
+        set_queue_bits( binding->owner->queue, QS_POINTER );
+    }
+    else free_message( msg );
+    free( input );
+}
+
+static void remove_input_delegation( struct input_delegation *binding, unsigned int disposition )
+{
+    struct delegated_input *input, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( input, next, &delegated_inputs, struct delegated_input, entry )
+        if (input->binding == binding) finish_delegated_input( input, disposition );
+    list_remove( &binding->entry );
+    free( binding );
+}
+
+static void cleanup_input_delegations( struct thread *thread, user_handle_t win )
+{
+    struct input_delegation *binding, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( binding, next, &input_delegations, struct input_delegation, entry )
+    {
+        if (win ? binding->win == win : (binding->owner == thread || binding->delegate == thread))
+            remove_input_delegation( binding, !win && binding->owner != thread ? 1 : 2 );
+    }
+}
+
+static int queue_delegated_input( struct message *msg, user_handle_t win )
+{
+    struct input_delegation *binding;
+    struct delegated_input *input;
+    struct delegated_msg_data *data;
+    struct message *notice;
+    if (get_hardware_msg_bit( msg->msg ) != QS_POINTER || !(binding = find_input_delegation( win ))) return 0;
+    if (!(input = mem_alloc( sizeof(*input) ))) return -1;
+    if (!(notice = mem_alloc( sizeof(*notice) ))) { free(input); return -1; }
+    if (!(data = mem_alloc( sizeof(*data) ))) { free(notice); free(input); return -1; }
+    memset( notice, 0, sizeof(*notice) );
+    input->binding = binding;
+    input->message = msg;
+    input->notification = notice;
+    input->state = 0;
+    input->id = get_unique_id();
+    msg->win = win;
+    msg->unique_id = 0;
+    data->callback = binding->callback;
+    data->context = binding->context;
+    data->id = input->id;
+    data->__pad = 0;
+    notice->type = MSG_DELEGATED_INPUT;
+    notice->win = win;
+    notice->msg = msg->msg;
+    notice->wparam = msg->wparam;
+    notice->lparam = msg->lparam;
+    notice->x = msg->x;
+    notice->y = msg->y;
+    notice->time = msg->time;
+    notice->data = data;
+    notice->data_size = sizeof(*data);
+    list_add_tail( &delegated_inputs, &input->entry );
+    list_add_tail( &binding->delegate->queue->msg_list[SEND_MESSAGE], &notice->entry );
+    set_queue_bits( binding->delegate->queue, QS_SENDMESSAGE );
+    return 1;
+}
+
+static void receive_delegated_input( struct message *notice )
+{
+    struct delegated_input *input;
+    LIST_FOR_EACH_ENTRY( input, &delegated_inputs, struct delegated_input, entry )
+        if (input->notification == notice)
+        {
+            input->notification = NULL;
+            input->state = 1;
+            return;
+        }
+}
+
+DECL_HANDLER(delegate_input)
+{
+    struct thread *owner, *delegate;
+    struct input_delegation *binding, *existing;
+    struct message *msg, *next;
+    user_handle_t win = get_user_full_handle( req->win );
+    if (!(owner = get_window_thread( win ))) { set_win32_error( ERROR_INVALID_WINDOW_HANDLE ); return; }
+    if (!req->mask || (req->mask & ~0x1006u) || !req->callback)
+    { set_win32_error( ERROR_INVALID_PARAMETER ); goto done_owner; }
+    if (req->mask != QS_POINTER) { set_win32_error( ERROR_NOT_SUPPORTED ); goto done_owner; }
+    if (!(delegate = get_thread_from_id( req->tid ? req->tid : current->id )))
+    { set_win32_error( ERROR_INVALID_PARAMETER ); goto done_owner; }
+    if (!delegate->queue || delegate->state == TERMINATED)
+    { set_win32_error( ERROR_INVALID_PARAMETER ); goto done_delegate; }
+    if (owner->process != current->process || delegate->process != current->process || owner == delegate ||
+        owner->queue->input->desktop != delegate->queue->input->desktop)
+    { set_win32_error( ERROR_ACCESS_DENIED ); goto done_delegate; }
+    if ((existing = find_input_delegation( win )))
+    {
+        set_win32_error( !req->context && !existing->context && existing->delegate == delegate &&
+                        existing->callback == req->callback ? ERROR_ALREADY_REGISTERED : ERROR_ACCESS_DENIED );
+        goto done_delegate;
+    }
+    LIST_FOR_EACH_ENTRY( binding, &input_delegations, struct input_delegation, entry )
+        if (binding->delegate == owner || (binding->delegate == delegate &&
+            (binding->callback != req->callback || binding->context != req->context)))
+        { set_win32_error( ERROR_ACCESS_DENIED ); goto done_delegate; }
+    if (!(binding = mem_alloc( sizeof(*binding) ))) goto done_delegate;
+    binding->owner = owner;
+    binding->delegate = delegate;
+    binding->win = win;
+    binding->callback = req->callback;
+    binding->context = req->context;
+    list_add_tail( &input_delegations, &binding->entry );
+    /* Already queued, unconsumed pointer messages also become delegated. */
+    LIST_FOR_EACH_ENTRY_SAFE( msg, next, &owner->queue->input->msg_list, struct message, entry )
+        if (msg->win == win && get_hardware_msg_bit( msg->msg ) == QS_POINTER)
+        {
+            struct list *prev = list_prev( &owner->queue->input->msg_list, &msg->entry );
+            list_remove( &msg->entry );
+            if (queue_delegated_input( msg, win ) < 1)
+            {
+                if (prev) list_add_after( prev, &msg->entry );
+                else list_add_head( &owner->queue->input->msg_list, &msg->entry );
+                remove_input_delegation( binding, 1 );
+                goto done_delegate;
+            }
+        }
+done_delegate:
+    release_object( delegate );
+done_owner:
+    release_object( owner );
+}
+
+DECL_HANDLER(undelegate_input)
+{
+    struct input_delegation *binding = find_input_delegation( get_user_full_handle( req->win ) );
+    struct delegated_input *input, *next;
+    if (!get_user_object( get_user_full_handle( req->win ), NTUSER_OBJ_WINDOW ))
+    { set_win32_error( ERROR_INVALID_WINDOW_HANDLE ); return; }
+    if (!binding || req->disposition < 1 || req->disposition > 2)
+    { set_win32_error( ERROR_INVALID_PARAMETER ); return; }
+    if (binding->owner->process != current->process) { set_win32_error( ERROR_ACCESS_DENIED ); return; }
+    LIST_FOR_EACH_ENTRY_SAFE( input, next, &delegated_inputs, struct delegated_input, entry )
+        if (input->binding->delegate == binding->delegate && input->state != 1)
+            finish_delegated_input( input, req->disposition );
+    remove_input_delegation( binding, req->disposition );
+}
+
+DECL_HANDLER(handle_delegated_input)
+{
+    struct delegated_input *input, *next, *target = NULL;
+    struct input_delegation *binding;
+    int active = 0;
+    if (req->disposition < 1 || req->disposition > 3)
+    { set_win32_error( ERROR_INVALID_PARAMETER ); return; }
+    LIST_FOR_EACH_ENTRY( binding, &input_delegations, struct input_delegation, entry )
+        if (binding->delegate == current) active = 1;
+    if (!active) { set_win32_error( ERROR_ACCESS_DENIED ); return; }
+    if (!req->id && req->disposition == 3) return;
+    LIST_FOR_EACH_ENTRY( input, &delegated_inputs, struct delegated_input, entry )
+    {
+        struct message *msg = input->message;
+        if (input->binding->delegate != current || !input->state) continue;
+        if (req->id ? input->id == req->id : (msg->win == req->win && msg->msg == req->msg &&
+            msg->wparam == req->wparam && msg->lparam == req->lparam && msg->time == req->time &&
+            msg->x == req->x && msg->y == req->y)) { target = input; break; }
+        if (!req->id && input->state == 1) break;
+    }
+    if (!target) { set_win32_error( ERROR_INVALID_PARAMETER ); return; }
+    if (req->id)
+    {
+        if (req->disposition == 3) target->state = 2;
+        else finish_delegated_input( target, req->disposition );
+        return;
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( input, next, &delegated_inputs, struct delegated_input, entry )
+    {
+        int last = input == target;
+        if (input->binding->delegate != current) continue;
+        if (input->state == 1) break; /* Current callback resolves itself on return. */
+        finish_delegated_input( input, req->disposition );
+        if (last) break;
+    }
+}
