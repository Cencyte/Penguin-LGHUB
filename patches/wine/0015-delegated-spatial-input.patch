+static NTSTATUS WINAPI User32CallInputDelegate( void *args, ULONG size )
+{
+    struct input_delegate_params *params = args;
+    ULONG (WINAPI *callback)( const MSG *, void * ) = (void *)(UINT_PTR)params->callback;
