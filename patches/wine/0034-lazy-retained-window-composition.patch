+/* Ordinary windows may be painted directly by another process (Chromium's
+ * GPU process, for example). Do not retain and later flush an unrelated GDI
+ * bitmap over those pixels. Promote only trees containing our retained data. */
+static BOOL needs_child_composition(HWND hwnd, UINT depth)
+{
+    HWND *children;
+    UINT i;
+    BOOL needed;
+    WND *win = get_win_ptr(hwnd);
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    needed = win->composition_owner || is_child_composite_surface(win->surface) ||
+             (win->surface && win->surface->funcs == &child_composite_funcs);
+    release_win_ptr(win);
+    if (needed || depth > 64) return TRUE;
+    if (!(children = list_window_children(hwnd))) return FALSE;
+    for (i = 0; children[i] && !needed; i++) needed = needs_child_composition(children[i], depth + 1);
+    free(children);
+    return needed;
+}
