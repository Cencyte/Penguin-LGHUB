+/* Select only the foremost ordinary HWND. A child's HWND occludes its parent's
+ * below-child composition; do not walk through another application's window. */
+user_handle_t composition_input_from_point(user_handle_t scope, int x, int y)
+{
+    int raw_x = x, raw_y = y;
+    struct window *win = get_user_object(scope, NTUSER_OBJ_WINDOW);
+    if (!win || !is_visible(win) || (win->style & (WS_DISABLED | WS_MINIMIZE))) return 0;
+    map_point_raw_to_virt(win->desktop, &x, &y);
+    screen_to_client(win, &x, &y, 0);
+    win = child_window_from_point(win, x, y);
+    if (!win || (win->style & (WS_DISABLED | WS_MINIMIZE))) return 0;
+    x = raw_x; y = raw_y;
+    map_point_raw_to_virt(win->desktop, &x, &y);
+    screen_to_client(win, &x, &y, 0);
+    if (x < 0 || y < 0 || x >= win->client_rect.right - win->client_rect.left ||
+            y >= win->client_rect.bottom - win->client_rect.top) return 0;
+    return composition_target_at(win->handle, x, y);
+}
