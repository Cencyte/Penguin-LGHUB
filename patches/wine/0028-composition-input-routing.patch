+static int uniform_routes(const struct composition_sink *sink)
+{
+    unsigned int i;
+    if (sink->flags || (sink->routes[0].type != 0 && sink->routes[0].type != 2)) return 0;
+    for (i = 1; i < 4; ++i)
+        if (sink->routes[i].type != sink->routes[0].type || sink->routes[i].window != sink->routes[0].window) return 0;
+    return !sink->routes[4].type || (sink->routes[4].type == sink->routes[0].type &&
+                                   sink->routes[4].window == sink->routes[0].window);
