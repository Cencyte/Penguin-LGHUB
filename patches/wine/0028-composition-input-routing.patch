+/* Private x64 code29 bridge. This is not a Windows syscall contract. */
+struct composition_input_params
+{
+    UINT version, operation;
+    HANDLE object, scene;
+    UINT count, reserved;
+    void *regions;
+    ULONG_PTR owner;
+};
+C_ASSERT(sizeof(struct composition_input_params) == 48);
+BOOL composition_input_bridge(HWND hwnd, const void *address)
+{
+    struct composition_input_params p;
+    struct composition_scene_region *regions = NULL;
+    HANDLE created = NULL;
+    NTSTATUS status;
+    unsigned int i, count = 0;
+    const char *enabled = getenv("WINE_GHUB_INPUT_ROUTING");
+    if (!enabled || strcmp(enabled, "1")) { status = STATUS_NOT_SUPPORTED; goto done; }
+    if ((status = read_user(address, &p, sizeof(p)))) goto done;
+    if (p.version != 0x47484931 || p.reserved || p.count > 4096 || p.operation < 1 || p.operation > 5)
+    { status = STATUS_INVALID_PARAMETER; goto done; }
+    if (p.count)
+    {
+        if (!(regions = calloc(p.count, sizeof(*regions)))) { status = STATUS_NO_MEMORY; goto done; }
+        if (p.operation == 1 && (status = read_user(p.regions, regions, p.count * sizeof(*regions)))) goto done;
+    }
+    switch (p.operation)
+    {
+    case 1: /* create immutable snapshot from owned sink handles */
+        SERVER_START_REQ(create_composition_scene)
+        {
+            wine_server_add_data(req, regions, p.count * sizeof(*regions));
+            status = wine_server_call(req);
+            if (!status) created = wine_server_ptr_handle(reply->handle);
+        }
+        SERVER_END_REQ;
+        break;
+    case 2: /* read snapshot; each returned sink handle belongs to the caller */
+        SERVER_START_REQ(read_composition_scene)
+        {
+            req->handle = wine_server_obj_handle(p.scene);
+            wine_server_set_reply(req, regions, p.count * sizeof(*regions));
+            status = wine_server_call(req);
+            count = reply->count;
+        }
+        SERVER_END_REQ;
+        if (status == STATUS_BUFFER_TOO_SMALL)
+        {
+            p.count = count;
+            if (write_user((void *)address, &p, sizeof(p))) status = STATUS_ACCESS_VIOLATION;
+        }
+        else if (!status)
+        {
+            if (count > p.count) status = STATUS_INVALID_PARAMETER;
+            else
+            {
+                p.count = count;
+                status = write_user(p.regions, regions, count * sizeof(*regions));
+                if (!status) status = write_user((void *)address, &p, sizeof(p));
+            }
+            if (status) for (i = 0; i < count && i < p.count; ++i) NtClose(wine_server_ptr_handle(regions[i].sink));
+        }
+        break;
+    case 3: /* publish scene on the actual Section object */
+    case 4: /* get an owned scene handle from the Section object */
+        SERVER_START_REQ(mapping_composition_scene)
+        {
+            req->mapping = wine_server_obj_handle(p.object);
+            req->scene = wine_server_obj_handle(p.scene);
+            req->set = p.operation == 3;
+            status = wine_server_call(req);
+            if (!status && p.operation == 4) created = wine_server_ptr_handle(reply->handle);
+        }
+        SERVER_END_REQ;
+        break;
+    case 5: /* bind/unbind a target HWND to a retained scene */
+        SERVER_START_REQ(bind_composition_scene)
+        {
+            req->win = wine_server_user_handle(hwnd);
+            req->scene = wine_server_obj_handle(p.scene);
+            req->owner = p.owner;
+            status = wine_server_call(req);
+        }
+        SERVER_END_REQ;
+        break;
+    }
+    if (!status && (p.operation == 1 || p.operation == 4))
+    {
+        p.scene = created;
+        status = write_user((void *)address, &p, sizeof(p));
+        if (status && created) NtClose(created);
+    }
+done:
+    free(regions);
+    if (status) RtlSetLastWin32Error(RtlNtStatusToDosError(status));
+    return !status;
+}
