+struct scene_binding
+{
+    struct list entry;
+    struct thread *owner; /* removed at queue/window destruction before thread release */
+    user_handle_t win;
+    client_ptr_t cookie;
+    struct composition_scene *scene;
+};
+static struct list scene_bindings = LIST_INIT(scene_bindings);
+static void free_binding(struct scene_binding *binding)
+{
+    list_remove(&binding->entry);
+    release_object(binding->scene);
+    free(binding);
+}
+void cleanup_composition_input(struct thread *thread, user_handle_t win)
+{
+    struct scene_binding *binding, *next;
+    LIST_FOR_EACH_ENTRY_SAFE(binding, next, &scene_bindings, struct scene_binding, entry)
+        if (win ? binding->win == win : binding->owner == thread) free_binding(binding);
+}
+DECL_HANDLER(bind_composition_scene)
+{
+    struct scene_binding *binding = NULL, *iter;
+    struct composition_scene *scene = NULL;
+    struct thread *owner;
+    struct desktop *desktop = NULL, *other;
+    user_handle_t win = get_user_full_handle(req->win);
+    unsigned int i;
+    if (!req->owner) { set_error(STATUS_INVALID_PARAMETER); return; }
+    if (!(owner = get_window_thread(win))) { set_error(STATUS_INVALID_HANDLE); return; }
+    if (owner->process != current->process || (req->scene && owner != current))
+    { set_error(STATUS_ACCESS_DENIED); goto done; }
+    LIST_FOR_EACH_ENTRY(iter, &scene_bindings, struct scene_binding, entry)
+        if (iter->win == win) { binding = iter; break; }
+    if (binding && binding->cookie != req->owner) { set_error(STATUS_ACCESS_DENIED); goto done; }
+    if (!req->scene)
+    {
+        if (binding) free_binding(binding);
+        goto done;
+    }
+    if (!(scene = (struct composition_scene *)get_handle_obj(current->process, req->scene, 1, &scene_ops))) goto done;
+    if (!(desktop = get_thread_desktop(owner, 0))) goto done;
+    for (i = 0; i < scene->count; ++i)
+    {
+        struct thread *route = scene->entries[i].sink->threads[0];
+        if (!route || route->state == TERMINATED) continue;
+        if (!(other = get_thread_desktop(route, 0))) goto done;
+        release_object(other);
+        if (other != desktop) { set_error(STATUS_ACCESS_DENIED); goto done; }
+    }
+    if (!binding)
+    {
+        if (!(binding = mem_alloc(sizeof(*binding)))) goto done;
+        binding->win = win; binding->owner = owner; binding->cookie = req->owner;
+        list_add_tail(&scene_bindings, &binding->entry);
+    }
+    else release_object(binding->scene);
+    binding->scene = (struct composition_scene *)grab_object(scene);
+done:
+    if (desktop) release_object(desktop);
+    if (scene) release_object(scene);
+    release_object(owner);
+}
+user_handle_t composition_target_at(user_handle_t win, int x, int y)
+{
+    struct scene_binding *binding;
+    LIST_FOR_EACH_ENTRY(binding, &scene_bindings, struct scene_binding, entry)
+    {
+        unsigned int i;
+        if (binding->win != win) continue;
+        for (i = binding->scene->count; i; --i)
+        {
+            const struct scene_entry *e = &binding->scene->entries[i - 1];
+            struct thread *thread;
+            user_handle_t target;
+            int valid;
+            if (!(x >= e->left && x < e->right && y >= e->top && y < e->bottom)) continue;
+            target = e->sink->routes[0].window;
+            if (!target || !(thread = get_window_thread(target))) continue;
+            valid = thread == e->sink->threads[0] && thread->state != TERMINATED && thread->queue;
+            release_object(thread);
+            if (valid) return target;
+        }
+        return 0;
+    }
+    return 0;
+}
