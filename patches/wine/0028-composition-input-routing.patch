+static int valid_scene_rect(const struct scene_entry *entry)
+{
+    /* These comparisons reject NaN, infinity, inverted and oversized bounds. */
+    return entry->left >= -129000000.0 && entry->top >= -129000000.0 &&
+           entry->right <= 129000000.0 && entry->bottom <= 129000000.0 &&
+           entry->left < entry->right && entry->top < entry->bottom;
+}
+DECL_HANDLER(create_composition_scene)
+{
+    const struct composition_scene_region *regions = get_req_data();
+    struct composition_scene *scene;
+    unsigned int count = get_req_data_size() / sizeof(*regions), i;
+    if (count > SCENE_MAX_REGIONS || get_req_data_size() != count * sizeof(*regions))
+    { set_error(STATUS_INVALID_PARAMETER); return; }
+    if (!(scene = alloc_object(&scene_ops))) return;
+    scene->count = 0;
+    scene->entries = count ? mem_alloc(count * sizeof(*scene->entries)) : NULL;
+    if (count && !scene->entries) goto done;
+    for (i = 0; i < count; ++i)
+    {
+        struct scene_entry *entry = &scene->entries[i];
+        memcpy(&entry->left, &regions[i].left, sizeof(double));
+        memcpy(&entry->top, &regions[i].top, sizeof(double));
+        memcpy(&entry->right, &regions[i].right, sizeof(double));
+        memcpy(&entry->bottom, &regions[i].bottom, sizeof(double));
+        if (regions[i].reserved || !valid_scene_rect(entry))
+        { set_error(STATUS_INVALID_PARAMETER); goto done; }
+        entry->sink = (struct composition_sink *)get_handle_obj(current->process, regions[i].sink, 1, &sink_ops);
+        if (!entry->sink) goto done;
+        ++scene->count;
+        if (!uniform_routes(entry->sink)) { set_error(STATUS_NOT_SUPPORTED); goto done; }
+    }
+    reply->handle = alloc_handle(current->process, scene, STANDARD_RIGHTS_READ | 1, 0);
+done:
+    release_object(scene);
+}
+DECL_HANDLER(read_composition_scene)
+{
+    struct composition_scene *scene;
+    struct composition_scene_region *regions;
+    unsigned int i, status;
+    if (!(scene = (struct composition_scene *)get_handle_obj(current->process, req->handle, 1, &scene_ops))) return;
+    reply->count = scene->count;
+    if (get_reply_max_size() < scene->count * sizeof(*regions))
+    { set_error(STATUS_BUFFER_TOO_SMALL); goto done; }
+    if (!scene->count) goto done;
+    if (!(regions = set_reply_data_size(scene->count * sizeof(*regions)))) goto done;
+    memset(regions, 0, scene->count * sizeof(*regions));
+    for (i = 0; i < scene->count; ++i)
+    {
+        const struct scene_entry *entry = &scene->entries[i];
+        memcpy(&regions[i].left, &entry->left, sizeof(double));
+        memcpy(&regions[i].top, &entry->top, sizeof(double));
+        memcpy(&regions[i].right, &entry->right, sizeof(double));
+        memcpy(&regions[i].bottom, &entry->bottom, sizeof(double));
+        if (!(regions[i].sink = alloc_handle(current->process, entry->sink, STANDARD_RIGHTS_READ | 1, 0)))
+        {
+            status = get_error();
+            while (i) close_handle(current->process, regions[--i].sink);
+            set_error(status);
+            break;
+        }
+    }
+done:
+    release_object(scene);
+}
+DECL_HANDLER(mapping_composition_scene)
+{
