+/* Lab regression cases for the G HUB icon stream backport. */
+DEFINE_ASYNC_COMPLETED_HANDLER( async_bool_completed_handler,
+        IAsyncOperationCompletedHandler_boolean, IAsyncOperation_boolean )
+
+struct stream_writer_context
+{
+    IOutputStream *output;
+    IBuffer *buffer;
+};
+
+static DWORD WINAPI stream_writer_thread( void *arg )
+{
+    struct stream_writer_context *context = arg;
+    IAsyncOperationWithProgress_UINT32_UINT32 *operation;
+    HRESULT hr;
+    UINT32 count;
+    unsigned int i;
+
+    hr = RoInitialize( RO_INIT_MULTITHREADED );
+    if (FAILED(hr)) return hr;
+    for (i = 0; i < 16; ++i)
+    {
+        hr = IOutputStream_WriteAsync( context->output, context->buffer, &operation );
+        if (FAILED(hr)) break;
+        await_IAsyncOperationWithProgress_UINT32_UINT32( operation, 1000 );
+        hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults( operation, &count );
+        IAsyncOperationWithProgress_UINT32_UINT32_Release( operation );
+        if (FAILED(hr)) break;
+        if (count != 4) { hr = E_FAIL; break; }
+    }
+    RoUninitialize();
+    return hr;
+}
+
+static void test_parallel_writes( IRandomAccessStream *stream, IInputStream *input,
+                                 IOutputStream *output, IBuffer *buffer )
+{
+    struct stream_writer_context context = { output, buffer };
+    HANDLE threads[4];
+    IBuffer *result;
+    BYTE *data = buffer_get_data( buffer );
+    UINT64 value;
+    unsigned int i, j, thread_count = 0;
+    DWORD code, wait;
+
+    IRandomAccessStream_put_Size( stream, 0 );
+    IRandomAccessStream_Seek( stream, 0 );
+    memset( data, 0x5a, 4 );
+    IBuffer_put_Length( buffer, 4 );
+    for (i = 0; i < ARRAY_SIZE(threads); ++i)
+    {
+        HANDLE thread = CreateThread( NULL, 0, stream_writer_thread, &context, 0, NULL );
+        ok( !!thread, "create writer thread: %lu\n", GetLastError() );
+        if (thread) threads[thread_count++] = thread;
+    }
+    for (i = 0; i < thread_count; ++i)
+    {
+        wait = WaitForSingleObject( threads[i], 15000 );
+        ok( wait == WAIT_OBJECT_0, "writer thread wait: %lu\n", wait );
+        /* Keep the shared objects alive on a failing wait; the outer runner times out. */
+        if (wait != WAIT_OBJECT_0) WaitForSingleObject( threads[i], INFINITE );
+        GetExitCodeThread( threads[i], &code );
+        ok( code == S_OK, "writer thread: %#lx\n", code );
+        CloseHandle( threads[i] );
+    }
+    IRandomAccessStream_get_Size( stream, &value );
+    ok( value == thread_count * 64, "concurrent write size %I64u\n", value );
+    IRandomAccessStream_get_Position( stream, &value );
+    ok( value == thread_count * 64, "concurrent write position %I64u\n", value );
+    IRandomAccessStream_Seek( stream, 0 );
+    for (i = 0; i < thread_count * 2; ++i)
+    {
+        memset( data, 0xcc, 32 );
+        input_stream_read( input, buffer, 32, Completed, S_OK, &result );
+        for (j = 0; j < 32; ++j) ok( data[j] == 0x5a, "lost concurrent write at %u\n", i * 32 + j );
+        IBuffer_Release( result );
+    }
+}
