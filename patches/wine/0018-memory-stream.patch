+
+    res_buffer = NULL;
+    input_stream_read( input_stream, buffer, 17, Completed, S_OK, &res_buffer );
+    ok( res_buffer == buffer, "got different buffer.\n" );
+    hr = IBuffer_get_Length( res_buffer, &value );
