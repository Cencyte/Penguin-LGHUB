+static HRESULT WINAPI memory_stream_random_access_get_Size( IRandomAccessStream *iface, UINT64 *value )
+{
+    struct memory_stream *impl = impl_from_IRandomAccessStream( iface );
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    AcquireSRWLockShared( &impl->lock );
+    *value = impl->closed ? 0 : impl->size;
+    hr = impl->closed ? RO_E_CLOSED : S_OK;
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI memory_stream_random_access_put_Size( IRandomAccessStream *iface, UINT64 value )
+{
+    struct memory_stream *impl = impl_from_IRandomAccessStream( iface );
+    HRESULT hr;
+    AcquireSRWLockExclusive( &impl->lock );
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (value > SIZE_MAX) hr = HRESULT_FROM_WIN32( ERROR_DISK_FULL );
+    else if (SUCCEEDED(hr = memory_stream_require_capacity( impl, value )))
+    {
+        /* Discard truncated bytes; growing within capacity must not reveal them. */
+        if (value < impl->size) memset( impl->buffer + value, 0, impl->size - value );
+        impl->size = value;
+    }
+    ReleaseSRWLockExclusive( &impl->lock );
+    return hr;
+}
