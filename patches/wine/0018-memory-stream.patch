+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    ok( !operation, "got operation %p.\n", operation );
+    /* Crashes on Windows if the op pointer is null
+     * hr = IInputStream_ReadAsync( input_stream, NULL, 1, 0, NULL ); */
