+static HRESULT WINAPI memory_stream_output_GetTrustLevel( IOutputStream *iface, TrustLevel *trust_level )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( iface );
+    return memory_stream_random_access_GetTrustLevel( &impl->IRandomAccessStream_iface, trust_level );
+}
+
+static HRESULT memory_stream_output_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( (IOutputStream *)invoker );
+    IBuffer *buffer = (IBuffer *)param;
+    IBufferByteAccess *access = NULL;
+    UINT32 length, buffer_capacity;
+    size_t capacity;
+    HRESULT hr;
+    BYTE *data = NULL;
+
+    assert( !called_async );
+    result->vt = VT_UI4;
+    result->ulVal = 0;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    if (FAILED(hr = IBuffer_get_Capacity( buffer, &buffer_capacity ))) return hr;
+    if (length > buffer_capacity) return E_INVALIDARG;
+    if (length)
+    {
+        if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+        hr = IBufferByteAccess_Buffer( access, &data );
+        if (FAILED(hr) || !data)
+        {
+            IBufferByteAccess_Release( access );
+            return FAILED(hr) ? hr : E_POINTER;
+        }
+    }
+    AcquireSRWLockExclusive( &impl->lock );
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (!length) hr = S_OK;
+    else if (impl->pos > SIZE_MAX - length) hr = HRESULT_FROM_WIN32( ERROR_DISK_FULL );
+    else
+    {
+        capacity = impl->pos + length;
+        if (SUCCEEDED(hr = memory_stream_require_capacity( impl, capacity )))
+        {
+            memcpy( impl->buffer + impl->pos, data, length );
+            impl->pos = capacity;
+            impl->size = max( impl->size, impl->pos );
+            result->ulVal = length;
+        }
+    }
+    ReleaseSRWLockExclusive( &impl->lock );
+    if (access) IBufferByteAccess_Release( access );
+    return hr;
+}
+
+static HRESULT WINAPI memory_stream_output_WriteAsync( IOutputStream *iface, IBuffer *buffer,
+        IAsyncOperationWithProgress_UINT32_UINT32 **operation )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( iface );
+
+    TRACE( "iface %p, buffer %p, operation %p.\n", iface, buffer, operation );
+
+    *operation = NULL;
+
+    if (!buffer)
+        return E_POINTER;
+
+    if (memory_stream_is_closed( impl ))
+        return RO_E_CLOSED;
+
+    return async_operation_uint32_uint32_create( (IUnknown *)iface, (IUnknown *)buffer, memory_stream_output_async, operation );
+}
+
+static HRESULT memory_stream_flush_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( (IOutputStream *)invoker );
+    assert( !called_async );
+    /* Writes copy their bytes before returning; there is no deferred device I/O. */
+    if (memory_stream_is_closed( impl )) return RO_E_CLOSED;
+    result->vt = VT_BOOL;
+    result->boolVal = VARIANT_TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI memory_stream_output_FlushAsync( IOutputStream *iface, IAsyncOperation_boolean **operation )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( iface );
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (memory_stream_is_closed( impl )) return RO_E_CLOSED;
+    return async_operation_boolean_create( (IUnknown *)iface, NULL, memory_stream_flush_async, operation );
+}
