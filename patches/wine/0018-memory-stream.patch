+static void test_memory_stream_flush_and_bounds(void)
+{
+    IActivationFactory *factory;
+    IInspectable *instance;
+    IRandomAccessStream *stream;
+    IInputStream *input;
+    IOutputStream *output;
+    IBufferFactory *buffer_factory;
+    IBuffer *buffer, *result;
+    IAsyncOperation_boolean *flush;
+    IAsyncOperationWithProgress_UINT32_UINT32 *write;
+    IAsyncInfo *info;
+    IClosable *closable;
+    IUnknown *identity, *async_identity;
+    HSTRING name;
+    UINT64 position;
+    UINT32 count;
+    BOOLEAN value;
+    BYTE *data;
+    HRESULT hr;
+    unsigned int i;
+
+    hr = get_activation_factory( L"Windows.Storage.Streams.InMemoryRandomAccessStream", &factory );
+    ok( hr == S_OK, "memory stream must be registered: %#lx\n", hr );
+    if (FAILED(hr)) return;
+    hr = IActivationFactory_ActivateInstance( factory, &instance );
+    ok( hr == S_OK, "activation %#lx\n", hr );
+    IActivationFactory_Release( factory );
+    if (FAILED(hr)) return;
+    hr = IInspectable_QueryInterface( instance, &IID_IRandomAccessStream, (void **)&stream );
+    ok( hr == S_OK, "random stream %#lx\n", hr );
+    IInspectable_Release( instance );
+    if (FAILED(hr)) return;
+    check_interface( stream, &IID_IAgileObject, FALSE );
+    hr = IRandomAccessStream_QueryInterface( stream, &IID_IInputStream, (void **)&input );
+    ok( hr == S_OK, "input %#lx\n", hr );
+    hr = IRandomAccessStream_QueryInterface( stream, &IID_IOutputStream, (void **)&output );
+    ok( hr == S_OK, "output %#lx\n", hr );
+    WindowsCreateString( L"Windows.Storage.Streams.Buffer", wcslen(L"Windows.Storage.Streams.Buffer"), &name );
+    hr = RoGetActivationFactory( name, &IID_IBufferFactory, (void **)&buffer_factory );
+    ok( hr == S_OK, "buffer factory %#lx\n", hr );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return;
+    hr = IBufferFactory_Create( buffer_factory, 32, &buffer );
+    ok( hr == S_OK, "buffer %#lx\n", hr );
+    IBufferFactory_Release( buffer_factory );
+    if (FAILED(hr)) return;
+    data = buffer_get_data( buffer );
+    for (i = 0; i < 8; ++i) data[i] = i + 1;
+    output_stream_write( output, buffer, 8 );
+    hr = IRandomAccessStream_put_Size( stream, 3 );
+    ok( hr == S_OK, "shrink %#lx\n", hr );
+    hr = IRandomAccessStream_put_Size( stream, 8 );
+    ok( hr == S_OK, "regrow %#lx\n", hr );
+    IRandomAccessStream_Seek( stream, 0 );
+    input_stream_read( input, buffer, 8, Completed, S_OK, &result );
+    for (i = 0; i < 8; ++i)
+        ok( data[i] == (i < 3 ? i + 1 : 0), "regrown byte %u: %#x\n", i, data[i] );
+    IBuffer_Release( result );
+
+    IRandomAccessStream_Seek( stream, 12 );
+    memset( data, 0xa5, 4 );
+    output_stream_write( output, buffer, 4 );
+    IRandomAccessStream_Seek( stream, 8 );
+    input_stream_read( input, buffer, 8, Completed, S_OK, &result );
+    for (i = 0; i < 8; ++i)
+        ok( data[i] == (i < 4 ? 0 : 0xa5), "gap byte %u: %#x\n", i, data[i] );
+    IBuffer_Release( result );
+
+    hr = IOutputStream_FlushAsync( output, &flush );
+    ok( hr == S_OK, "flush %#lx\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        await_IAsyncOperation_boolean( flush, 1000 );
+        check_async_info( flush, Completed, S_OK );
+        value = FALSE;
+        hr = IAsyncOperation_boolean_GetResults( flush, &value );
+        ok( hr == S_OK && value == TRUE, "flush result %#lx/%u\n", hr, value );
+        hr = IAsyncOperation_boolean_QueryInterface( flush, &IID_IAsyncInfo, (void **)&info );
+        ok( hr == S_OK, "async info %#lx\n", hr );
+        IAsyncInfo_QueryInterface( info, &IID_IUnknown, (void **)&identity );
+        IAsyncOperation_boolean_QueryInterface( flush, &IID_IUnknown, (void **)&async_identity );
+        ok( identity == async_identity, "split async identity\n" );
+        IUnknown_Release( identity );
+        IUnknown_Release( async_identity );
+        hr = IAsyncInfo_Cancel( info );
+        ok( hr == S_OK, "cancel completed operation %#lx\n", hr );
+        check_async_info( flush, Completed, S_OK );
+        hr = IAsyncInfo_Close( info );
+        ok( hr == S_OK, "close operation %#lx\n", hr );
+        hr = IAsyncOperation_boolean_GetResults( flush, &value );
