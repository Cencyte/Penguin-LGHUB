--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1463,6 +1463,16 @@
 
     TRACE( "hwnd %p/%lx, pos %s, dir %d, button %d\n", hwnd, win, wine_dbgstr_point(&pos), dir, button );
 
+    /* A nested size/move loop may have already consumed the button release
+     * before an application repeats its mouse-initiated system command.
+     * Sending button 0 would start a new WM grab with no release to end it.
+     * Explicit keyboard size/move commands must still reach the WM. */
+    if (!button && dir != _NET_WM_MOVERESIZE_MOVE_KEYBOARD && dir != _NET_WM_MOVERESIZE_SIZE_KEYBOARD)
+    {
+        TRACE( "ignoring mouse size/move after button release\n" );
+        return;
+    }
+
     xev.xclient.type = ClientMessage;
     xev.xclient.window = win;
     xev.xclient.message_type = x11drv_atom(_NET_WM_MOVERESIZE);
