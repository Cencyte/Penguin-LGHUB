+           debugstr_us( port_name ), obj_attr, port_attr, (unsigned int)flags, required_server_sid,
+           connect_msg, connect_msg_size, send_msg_attr, recv_msg_attr, timeout );
+    return STATUS_NOT_IMPLEMENTED;
+}
