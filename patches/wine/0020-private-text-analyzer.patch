+}
+
+struct direction_source
+{
+    IDWriteTextAnalysisSource *source;
+    const WCHAR *text;
+    UINT32 position, remaining, available;
+};
+
+static HRESULT direction_peek(struct direction_source *source, WCHAR *ch)
+{
+    HRESULT hr;
+    if (!source->available)
+    {
+        if (FAILED(hr = IDWriteTextAnalysisSource_GetTextAtPosition(source->source, source->position,
+                &source->text, &source->available))) return hr;
+        /* A source which ends before the requested range must not cause an
+         * out-of-bounds read or an infinite loop. */
+        if (!source->text || !source->available) return E_INVALIDARG;
+    }
+    *ch = *source->text;
+    return S_OK;
+}
+
+static void direction_advance(struct direction_source *source)
+{
+    ++source->position;
+    --source->remaining;
+    --source->available;
+    ++source->text;
+}
+
+static HRESULT WINAPI private_analyzer_GetContentReadingDirection(private_textanalyzer *iface,
+        IDWriteTextAnalysisSource *source, UINT32 position, UINT32 length,
+        DWRITE_READING_DIRECTION *direction, BOOL *is_neutral)
+{
+    struct direction_source context = {source, NULL, position, length, 0};
+    DWRITE_READING_DIRECTION base;
+    WCHAR first, second;
+    UINT32 ch;
+    int strong = -1;
+    HRESULT hr;
+
+    TRACE("source %p, position %u, length %u, direction %p, neutral %p.\n",
+            source, position, length, direction, is_neutral);
+    if (!direction || !is_neutral) return E_POINTER;
+    *direction = DWRITE_READING_DIRECTION_LEFT_TO_RIGHT;
+    *is_neutral = TRUE;
+    if (!source || position + length < position) return E_INVALIDARG;
+
+    base = IDWriteTextAnalysisSource_GetParagraphReadingDirection(source);
+    while (context.remaining)
+    {
+        if (FAILED(hr = direction_peek(&context, &first))) return hr;
+        direction_advance(&context);
+        ch = first;
+        if (IS_HIGH_SURROGATE(first) && context.remaining)
+        {
+            if (FAILED(hr = direction_peek(&context, &second))) return hr;
+            if (IS_LOW_SURROGATE(second))
+            {
+                ch = 0x10000 + ((first - 0xd800) << 10) + second - 0xdc00;
+                direction_advance(&context);
+            }
+        }
+        strong = bidi_get_char_direction(ch);
+        if (strong != -1) break;
+    }
+    /* Native scans to the first L/R/AL or paragraph separator, including
+     * inside isolates. Preserve the vertical bit of the paragraph direction.
+     * This private operation is not the full Unicode paragraph algorithm. */
+    *direction = strong >= 0 ? (base & ~1) | strong : base;
+    *is_neutral = strong < 0;
+    TRACE("result direction %u, neutral %d.\n", *direction, *is_neutral);
+    return S_OK;
+}
+
+static const struct private_textanalyzer_vtbl private_analyzer_vtbl =
+{
+    private_analyzer_QueryInterface,
+    private_analyzer_AddRef,
+    private_analyzer_Release,
+    private_analyzer_GetContentReadingDirection,
+};
+static private_textanalyzer private_analyzer = { &private_analyzer_vtbl };
+
+
 IDWriteTextAnalyzer2 *get_text_analyzer(void)
 {
     return &textanalyzer;
