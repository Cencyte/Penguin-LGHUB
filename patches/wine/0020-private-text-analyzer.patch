+/* Return the first-strong classification used by the private text analyzer:
+ * horizontal direction, -1 for non-strong, or -2 for a paragraph boundary. */
+int bidi_get_char_direction(UINT32 ch)
+{
+    switch (get_table_entry_32(bidi_direction_table, ch))
+    {
+        case L: return DWRITE_READING_DIRECTION_LEFT_TO_RIGHT;
+        case R:
+        case AL: return DWRITE_READING_DIRECTION_RIGHT_TO_LEFT;
+        case B: return -2;
+        default: return -1;
+    }
+}
