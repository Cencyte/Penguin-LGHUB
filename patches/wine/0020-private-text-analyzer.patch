 static IDWriteTextAnalyzer2 textanalyzer = { &textanalyzervtbl };

+static HRESULT WINAPI private_analyzer_QueryInterface(private_textanalyzer *iface, REFIID iid, void **out)
+{
+    return IDWriteTextAnalyzer2_QueryInterface(&textanalyzer, iid, out);
+}
