+/* Execute shared-texture accesses as transactions. Readback makes the pixels
+ * available before releasing the interprocess mutex; this favors correctness
+ * over performance and is enabled only for explicitly exported lab textures. */
+struct shared_access
+{
+    struct wined3d_resource *resource;
+    BOOL write;
+};
+static void shared_add(struct shared_access *entries, unsigned int *count, struct wined3d_resource *r, BOOL write)
+{
+    unsigned int i;
+    if (!r || !r->shared_texture)
+        return;
+    for (i = 0; i < *count; ++i)
+        if (entries[i].resource == r)
+        {
+            entries[i].write |= write;
+            return;
+        }
+    entries[*count] = (struct shared_access){r, write};
+    ++*count;
+}
