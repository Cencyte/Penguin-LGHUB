+    switch (opcode)
+    {
+    case WINED3D_CS_OP_CLEAR: {
+        const struct wined3d_cs_clear *op = data;
+        for (i = 0; i < op->rt_count; ++i)
+            if (op->fb.render_targets[i])
+                shared_add(entries, &count, op->fb.render_targets[i]->resource, TRUE);
+        break;
+    }
+    case WINED3D_CS_OP_CLEAR_SYSMEM_TEXTURE:
+        shared_add(entries, &count, &((const struct wined3d_cs_clear_sysmem_texture *)data)->texture->resource, TRUE);
+        break;
+    case WINED3D_CS_OP_DRAW:
+    case WINED3D_CS_OP_DISPATCH:
+        if (opcode == WINED3D_CS_OP_DRAW)
+            for (i = 0; i < ARRAY_SIZE(cs->state.fb.render_targets); ++i)
+                if (cs->state.fb.render_targets[i])
+                    shared_add(entries, &count, cs->state.fb.render_targets[i]->resource, TRUE);
+        first = opcode == WINED3D_CS_OP_DISPATCH ? WINED3D_SHADER_TYPE_COMPUTE : 0;
+        last = opcode == WINED3D_CS_OP_DISPATCH ? WINED3D_SHADER_TYPE_COMPUTE + 1 : WINED3D_SHADER_TYPE_COMPUTE;
+        for (i = first; i < last; ++i)
