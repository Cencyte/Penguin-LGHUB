+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "wined3d_private.h"
+#include "wined3d_gl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d);
+
+#define SHARED_FLAGS 0x802        /* D3D11_RESOURCE_MISC_SHARED | SHARED_NTHANDLE */
+#define SHARED_ACCESS 0x80000001u /* DXGI_SHARED_RESOURCE_READ | WRITE */
+#define SHARED_MAX_BYTES (256u * 1024 * 1024)
+
+struct shared_header
+{
+    DWORD magic[4], version, bytes, row_pitch;
+    struct wined3d_resource_desc desc;
+    unsigned int flags;
+    LONG broken;
+    LONG64 generation;
+};
+struct wined3d_shared_texture
+{
+    HANDLE section, mutex;
+    struct shared_header *view, info;
+    LONG64 generation;
+};
+static const DWORD shared_magic[4] = {0x55424847, 0x48535844, 0x45524152, 0x00000001};
+
+static BOOL enabled(void)
+{
+    char value[2];
+    return GetEnvironmentVariableA("GHUB_D3D11_SHARED_TEXTURES", value, sizeof(value)) == 1 && value[0] == '1';
+}
+static BOOL valid_header(const struct shared_header *h)
+{
+    return !memcmp(h->magic, shared_magic, sizeof(shared_magic)) && h->version == 1 &&
+           h->desc.resource_type == WINED3D_RTYPE_TEXTURE_2D && h->desc.width && h->desc.width <= 8192 &&
+           h->desc.height && h->desc.height <= 8192 && h->desc.depth == 1 &&
+           h->desc.multisample_type == WINED3D_MULTISAMPLE_NONE && !h->desc.multisample_quality &&
+           h->flags == SHARED_FLAGS &&
+           !(h->desc.bind_flags & ~(WINED3D_BIND_RENDER_TARGET | WINED3D_BIND_SHADER_RESOURCE)) && h->row_pitch &&
+           h->row_pitch <= 8192 * 16 && h->bytes <= SHARED_MAX_BYTES && h->bytes == h->row_pitch * h->desc.height;
+}
+static void destroy_shared(struct wined3d_shared_texture *shared)
+{
+    if (!shared)
+        return;
+    if (shared->view)
+        UnmapViewOfFile(shared->view);
+    if (shared->mutex)
+        CloseHandle(shared->mutex);
+    if (shared->section)
+        CloseHandle(shared->section);
+    free(shared);
+}
+void wined3d_shared_texture_cleanup(struct wined3d_resource *resource)
+{
+    destroy_shared(resource->shared_texture);
+    resource->shared_texture = NULL;
+}
+/* One prefix-local mutex serializes multi-resource commands, including copies
+ * in opposite directions on different processes. No process pointer registry. */
+static HANDLE create_mutex(void)
+{
+    return CreateMutexW(NULL, FALSE, L"Local\\WineGHubSharedTextureV1");
+}
+static BOOL lock_shared(struct wined3d_shared_texture *shared)
+{
+    DWORD result = WaitForSingleObject(shared->mutex, 10000);
+    if (result == WAIT_ABANDONED)
+    {
+        /* A writer died with a possible incomplete GPU readback. */
+        shared->view->broken = TRUE;
+        ReleaseMutex(shared->mutex);
+        return FALSE;
+    }
+    return result == WAIT_OBJECT_0;
+}
+static BOOL header_unchanged(struct wined3d_shared_texture *shared)
+{
+    return !memcmp(shared->view, &shared->info, offsetof(struct shared_header, broken)) && !shared->view->broken &&
+           shared->view->generation > 0 && !(shared->view->generation & 1);
+}
+static HRESULT open_shared(HANDLE handle, struct wined3d_shared_texture **out)
+{
+    struct wined3d_shared_texture *shared;
+    struct shared_header *view;
+    HRESULT hr = E_INVALIDARG;
+
+    *out = NULL;
+    if (!enabled())
+        return E_NOTIMPL;
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return E_OUTOFMEMORY;
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &shared->section, 0, FALSE,
+                         DUPLICATE_SAME_ACCESS))
+        goto fail;
+    if (!(view = MapViewOfFile(shared->section, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view))))
+        goto fail;
+    shared->info = *view;
+    UnmapViewOfFile(view);
+    if (!valid_header(&shared->info))
+        goto fail;
+    if (!(shared->view =
+              MapViewOfFile(shared->section, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view) + shared->info.bytes)))
+        goto fail;
+    if (!(shared->mutex = create_mutex()))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+    if (!lock_shared(shared))
+    {
+        hr = E_FAIL;
+        goto fail;
+    }
+    if (!header_unchanged(shared))
+    {
+        ReleaseMutex(shared->mutex);
+        goto fail;
+    }
+    ReleaseMutex(shared->mutex);
+    *out = shared;
+    return S_OK;
