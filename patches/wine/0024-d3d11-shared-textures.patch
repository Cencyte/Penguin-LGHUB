+    if (access != SHARED_ACCESS && access != (GENERIC_ALL | SHARED_ACCESS))
+        return E_NOTIMPL;
+    wined3d_texture_get_pitch(texture_from_resource(resource), 0, &pitch, &slice);
+    if (!slice || slice > SHARED_MAX_BYTES)
+        return E_NOTIMPL;
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return E_OUTOFMEMORY;
+    shared->section = CreateFileMappingW(INVALID_HANDLE_VALUE, (SECURITY_ATTRIBUTES *)attributes, PAGE_READWRITE, 0,
+                                         sizeof(struct shared_header) + slice, name);
+    if (!shared->section)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+    if (GetLastError() == ERROR_ALREADY_EXISTS)
+    {
+        hr = DXGI_ERROR_NAME_ALREADY_EXISTS;
+        goto fail;
+    }
+    if (!(shared->view = MapViewOfFile(shared->section, FILE_MAP_WRITE, 0, 0, sizeof(struct shared_header) + slice)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+    if (!(shared->mutex = create_mutex()))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+    memcpy(shared->info.magic, shared_magic, sizeof(shared_magic));
+    shared->info.version = 1;
+    shared->info.bytes = slice;
+    shared->info.row_pitch = pitch;
+    shared->info.flags = resource->shared_flags;
+    wined3d_resource_get_desc(resource, &shared->info.desc);
+    *shared->view = shared->info;
+    /* Reserve caller handle before attaching so failure leaves resource intact. */
+    if (!DuplicateHandle(GetCurrentProcess(), shared->section, GetCurrentProcess(), handle,
+                         SECTION_QUERY | SECTION_MAP_READ | SECTION_MAP_WRITE, attributes && attributes->bInheritHandle,
+                         0))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+    args = (struct attach_args){resource, shared, TRUE, E_FAIL};
+    wined3d_cs_init_object(resource->device->cs, attach_shared, &args);
+    resource->device->cs->c.ops->finish(&resource->device->cs->c, WINED3D_CS_QUEUE_DEFAULT);
+    if (SUCCEEDED(hr = args.hr))
+        return hr;
+    CloseHandle(*handle);
+    *handle = NULL;
+fail:
+    destroy_shared(shared);
+    return hr;
+}
+HRESULT CDECL wined3d_resource_open_shared_handle(struct wined3d_resource *resource, HANDLE handle)
+{
+    struct wined3d_shared_texture *shared;
+    struct attach_args args;
+    unsigned int pitch, slice;
+    HRESULT hr;
+
+    if (!supported(resource))
+        return E_NOTIMPL;
+    if (resource->shared_texture)
+        return E_INVALIDARG;
+    if (FAILED(hr = open_shared(handle, &shared)))
+        return hr;
+    wined3d_texture_get_pitch(texture_from_resource(resource), 0, &pitch, &slice);
+    if (pitch != shared->info.row_pitch || slice != shared->info.bytes || resource->width != shared->info.desc.width ||
+        resource->height != shared->info.desc.height || resource->format->id != shared->info.desc.format ||
+        resource->bind_flags != shared->info.desc.bind_flags)
+    {
+        destroy_shared(shared);
+        return E_INVALIDARG;
+    }
+    args = (struct attach_args){resource, shared, FALSE, E_FAIL};
+    wined3d_cs_init_object(resource->device->cs, attach_shared, &args);
+    resource->device->cs->c.ops->finish(&resource->device->cs->c, WINED3D_CS_QUEUE_DEFAULT);
+    if (FAILED(args.hr))
+        destroy_shared(shared);
+    return args.hr;
+}
