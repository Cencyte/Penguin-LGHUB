+        resource->type != WINED3D_RTYPE_TEXTURE_2D || resource->shared_flags != SHARED_FLAGS ||
+        resource->access != WINED3D_RESOURCE_ACCESS_GPU || resource->multisample_type ||
+        resource->multisample_quality || resource->width > 8192 || resource->height > 8192 ||
+        resource->bind_flags & ~(WINED3D_BIND_RENDER_TARGET | WINED3D_BIND_SHADER_RESOURCE) ||
+        resource->format->block_width != 1 || resource->format->block_height != 1 ||
+        resource->format->attrs & WINED3D_FORMAT_ATTR_PLANAR || !resource->format->byte_count)
