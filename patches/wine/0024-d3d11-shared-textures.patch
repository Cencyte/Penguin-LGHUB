+    texture = texture_from_resource(resource);
+    return texture->level_count == 1 && texture->layer_count == 1;
+}
+/* Called on the CS thread, with the transport mutex held. */
+static BOOL transfer(struct wined3d_resource *resource, BOOL publish)
+{
+    struct wined3d_texture *texture = texture_from_resource(resource);
+    struct wined3d_shared_texture *shared = resource->shared_texture;
+    struct wined3d_context *context = context_acquire(resource->device, NULL, 0);
+    struct wined3d_bo_address address;
+    BOOL ret;
+
+    if (!wined3d_context_gl(context)->valid)
+    {
+        ERR("Invalid GL context for shared texture %p.\n", resource);
+        shared->view->broken = TRUE;
+        context_release(context);
+        return FALSE;
+    }
+    if (publish)
+        ret = wined3d_texture_load_location(texture, 0, context, WINED3D_LOCATION_SYSMEM);
+    else
+        ret = wined3d_texture_prepare_location(texture, 0, context, WINED3D_LOCATION_SYSMEM);
+    if (ret)
+    {
+        wined3d_texture_get_bo_address(texture, 0, &address, WINED3D_LOCATION_SYSMEM);
+        if (publish)
+        {
+            /* Odd generation means publication was interrupted. */
+            InterlockedIncrement64(&shared->view->generation);
+            memcpy(shared->view + 1, address.addr, shared->info.bytes);
+            shared->generation = InterlockedIncrement64(&shared->view->generation);
+        }
+        else
+        {
+            memcpy((void *)address.addr, shared->view + 1, shared->info.bytes);
+            wined3d_texture_validate_location(texture, 0, WINED3D_LOCATION_SYSMEM);
+            wined3d_texture_invalidate_location(texture, 0, ~WINED3D_LOCATION_SYSMEM);
+            shared->generation = shared->view->generation;
+        }
+    }
+    context_release(context);
+    if (!ret)
+        shared->view->broken = TRUE;
+    return ret;
+}
+BOOL wined3d_shared_texture_begin(struct wined3d_resource *resource)
+{
+    struct wined3d_shared_texture *shared = resource->shared_texture;
+    if (!lock_shared(shared))
+        return FALSE;
+    if (!header_unchanged(shared) || (shared->generation != shared->view->generation && !transfer(resource, FALSE)))
+    {
+        ReleaseMutex(shared->mutex);
+        return FALSE;
+    }
+    return TRUE;
+}
+BOOL wined3d_shared_texture_end(struct wined3d_resource *resource, BOOL write)
+{
+    struct wined3d_shared_texture *shared = resource->shared_texture;
+    BOOL ret = !write || transfer(resource, TRUE);
+    ReleaseMutex(shared->mutex);
+    return ret;
+}
+struct attach_args
+{
+    struct wined3d_resource *resource;
+    struct wined3d_shared_texture *shared;
+    BOOL publish;
+    HRESULT hr;
+};
+static void attach_shared(void *arg)
+{
+    struct attach_args *args = arg;
+    struct wined3d_resource *resource = args->resource;
+    args->hr = E_FAIL;
+    if (!lock_shared(args->shared))
+        return;
+    if (!args->publish && !header_unchanged(args->shared))
+    {
+        ReleaseMutex(args->shared->mutex);
+        return;
+    }
+    resource->shared_texture = args->shared;
+    if (transfer(resource, args->publish))
+        args->hr = S_OK;
+    else
+        resource->shared_texture = NULL;
+    ReleaseMutex(args->shared->mutex);
