+/* Completion events are owned and retired on the CS thread. No worker holds
+ * the WineD3D mutex while waiting for GPU work or device destruction. */
+struct wined3d_completion_event
+{
+    struct list entry;
+    struct wined3d_cs *cs;
+    struct wined3d_fence *fence;
+    HANDLE event;
+};
+
+static void complete_event(struct wined3d_completion_event *completion)
+{
+    TRACE_(d3d_perf)("Signalling DXGI completion event %p.\n", completion->event);
+    if (!SetEvent(completion->event))
+        ERR("Failed to signal completion event, error %lu.\n", GetLastError());
+    CloseHandle(completion->event);
+    wined3d_fence_destroy(completion->fence);
+    free(completion);
+}
+
+static void poll_queries(struct wined3d_cs *cs);
+
+static void poll_completion_events(struct wined3d_cs *cs, bool wait)
+{
+    struct wined3d_completion_event *completion, *next;
+    enum wined3d_fence_result result;
+
+    LIST_FOR_EACH_ENTRY_SAFE(completion, next, &cs->completion_events, struct wined3d_completion_event, entry)
+    {
+        result = wait ? wined3d_fence_wait(completion->fence, cs->c.device)
+                : wined3d_fence_test(completion->fence, cs->c.device, 0);
+        if (result == WINED3D_FENCE_WAITING)
+            continue;
+        /* Like event queries, release waiters when the backend/context fails.
+         * This API signals on device removal as well as normal completion. */
+        if (result != WINED3D_FENCE_OK)
+            WARN("Completion fence returned %#x.\n", result);
+        /* Publish earlier query results before waking an application that
+         * may immediately inspect them with DONOTFLUSH. */
+        if (cs->thread)
+            poll_queries(cs);
+        list_remove(&completion->entry);
+        complete_event(completion);
+    }
+}
+
+static void finish_completion_events(void *object)
+{
+    poll_completion_events(object, true);
+}
+
+void wined3d_cs_finish_completions(struct wined3d_cs *cs)
+{
+    wined3d_cs_init_object(cs, finish_completion_events, cs);
+    wined3d_cs_finish(cs, WINED3D_CS_QUEUE_DEFAULT);
+}
+
+static void issue_completion_event(void *object)
+{
+    struct wined3d_completion_event *completion = object;
+    struct wined3d_cs *cs = completion->cs;
+    struct wined3d_context *context;
+
+    context = context_acquire(cs->c.device, NULL, 0);
+    if (!wined3d_context_gl(context)->valid)
+    {
+        WARN("GL context lost before completion fence.\n");
+        context_release(context);
+        complete_event(completion);
+        return;
+    }
+    wined3d_fence_issue(completion->fence, cs->c.device);
+    /* Waiting on the OS event must make progress without another D3D call. */
+    cs->c.device->adapter->adapter_ops->adapter_flush_context(context);
+    context_release(context);
+    list_add_tail(&cs->completion_events, &completion->entry);
+    /* Without a CS thread there is no independent poller. Complete here on
+     * the issuing GL thread rather than moving its context to a worker. */
+    if (!cs->thread)
+        poll_completion_events(cs, true);
+}
+
+HRESULT CDECL wined3d_device_enqueue_set_event(struct wined3d_device *device, HANDLE event)
+{
+    static const UNICODE_STRING event_type = RTL_CONSTANT_STRING(L"Event");
+    struct { OBJECT_TYPE_INFORMATION info; WCHAR name[64]; } type;
+    struct wined3d_completion_event *completion;
+    OBJECT_BASIC_INFORMATION basic;
+    HANDLE owned;
+    HRESULT hr;
+
+    /* Duplicate first so concurrent handle closure/reuse cannot change the
+     * object being validated. Never request rights the caller did not have. */
+    if (!DuplicateHandle(GetCurrentProcess(), event, GetCurrentProcess(), &owned, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return GetLastError() == ERROR_NOT_ENOUGH_MEMORY ? E_OUTOFMEMORY : E_INVALIDARG;
+    if (NtQueryObject(owned, ObjectBasicInformation, &basic, sizeof(basic), NULL)
+            || !(basic.GrantedAccess & EVENT_MODIFY_STATE)
+            || NtQueryObject(owned, ObjectTypeInformation, &type, sizeof(type), NULL)
+            || !RtlEqualUnicodeString(&type.info.TypeName, &event_type, FALSE))
+    {
+        CloseHandle(owned);
+        return E_INVALIDARG;
+    }
+    if (wined3d_get_renderer() != WINED3D_RENDERER_OPENGL || device->wined3d->flags & WINED3D_NO3D)
+    {
+        CloseHandle(owned);
+        return E_NOTIMPL;
+    }
+    if (!(completion = calloc(1, sizeof(*completion))))
+    {
+        CloseHandle(owned);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = wined3d_fence_create(device, &completion->fence)))
+    {
+        CloseHandle(owned);
+        free(completion);
+        return hr;
+    }
+    completion->event = owned;
+    completion->cs = device->cs;
+    TRACE_(d3d_perf)("Queueing DXGI completion event %p as %p.\n", event, owned);
+    wined3d_cs_init_object(device->cs, issue_completion_event, completion);
+    return S_OK;
+}
