+static void test_bmp_stream(void)
+{
+    IActivationFactory *f;
+    IInspectable *instance;
+    IRandomAccessStream *stream;
+    IOutputStream *output, *detached;
+    IInputStream *input;
+    IDataWriter *writer;
+    IAsyncOperation_UINT32 *op;
+    IAsyncOperation_boolean *flush;
+    IAsyncOperationWithProgress_IBuffer_UINT32 *read;
+    IBufferFactory *bf;
+    IBuffer *buffer, *result;
+    struct completion handler = { {&completion_vtbl}, 1 };
+    BYTE header[14] = {'B','M'}, dib[40] = {40}, *pixels, *data;
+    const UINT32 pixel_count = 1024 * 768 * 3;
+    UINT32 count, i, length;
+    BOOLEAN flushed = FALSE;
+    UINT64 size;
+    if (FAILED(factory(L"Windows.Storage.Streams.InMemoryRandomAccessStream", &IID_IActivationFactory, (void **)&f))) return;
+    HR(IActivationFactory_ActivateInstance(f, &instance)); IActivationFactory_Release(f);
+    HR(IInspectable_QueryInterface(instance, &IID_IRandomAccessStream, (void **)&stream)); IInspectable_Release(instance);
+    HR(IRandomAccessStream_QueryInterface(stream, &IID_IOutputStream, (void **)&output));
+    HR(IRandomAccessStream_QueryInterface(stream, &IID_IInputStream, (void **)&input));
+    writer = create_writer(output);
+    if (!writer) return;
+    pixels = malloc(pixel_count);
+    for (i = 0; i < pixel_count; ++i) pixels[i] = (i * 13 + 7) & 255;
+    HR(IDataWriter_WriteBytes(writer, sizeof(header), header));
+    HR(IDataWriter_WriteBytes(writer, sizeof(dib), dib));
+    HR(IDataWriter_WriteBytes(writer, pixel_count, pixels));
+    HR(IRandomAccessStream_get_Size(stream, &size)); ok(!size, "buffering wrote early\n");
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == pixel_count + 54, "buffer size %u\n", count);
+    HR(IDataWriter_StoreAsync(writer, &op));
+    handler.event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    HR(IAsyncOperation_UINT32_put_Completed(op, &handler.iface));
+    ok(WaitForSingleObject(handler.event, 3000) == WAIT_OBJECT_0, "store completion missing\n");
+    CloseHandle(handler.event);
+    HR(IAsyncOperation_UINT32_GetResults(op, &count)); ok(count == pixel_count + 54, "stored bytes %u\n", count);
+    IAsyncOperation_UINT32_Release(op);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(!count, "store retained bytes %u\n", count);
+    HR(IDataWriter_FlushAsync(writer, &flush));
+    HR(IAsyncOperation_boolean_GetResults(flush, &flushed)); ok(flushed == TRUE, "flush result %u\n", flushed);
+    IAsyncOperation_boolean_Release(flush);
+    HR(IRandomAccessStream_Seek(stream, 0));
+    if (FAILED(factory(L"Windows.Storage.Streams.Buffer", &IID_IBufferFactory, (void **)&bf))) return;
+    HR(IBufferFactory_Create(bf, pixel_count + 54, &buffer)); IBufferFactory_Release(bf);
+    HR(IInputStream_ReadAsync(input, buffer, pixel_count + 54, InputStreamOptions_None, &read));
+    HR(IAsyncOperationWithProgress_IBuffer_UINT32_GetResults(read, &result));
+    HR(IBuffer_get_Length(result, &length)); ok(length == pixel_count + 54, "read bytes %u\n", length);
+    data = buffer_data(result);
+    ok(!memcmp(data, header, 14) && !memcmp(data + 14, dib, 40) && !memcmp(data + 54, pixels, pixel_count), "BMP payload corrupted\n");
+    IBuffer_Release(result); IAsyncOperationWithProgress_IBuffer_UINT32_Release(read); IBuffer_Release(buffer);
+    HR(IDataWriter_DetachStream(writer, &detached)); IOutputStream_Release(detached);
+    close_writer(writer); IDataWriter_Release(writer);
+    HR(IRandomAccessStream_Seek(stream, 0));
+    IInputStream_Release(input); IOutputStream_Release(output);
+    ok(!IRandomAccessStream_Release(stream), "stream retained by writer operations\n");
+    ok(handler.refs == 1 && handler.calls == 1, "completion lifecycle %ld/%ld\n", handler.refs, handler.calls);
+    free(pixels);
+}
