+static void test_serialization(void)
+{
+    IDataWriter *writer = create_writer(NULL);
+    IBuffer *buffer;
+    ByteOrder order;
+    UnicodeEncoding encoding;
+    UINT32 count;
+    HSTRING text;
+    HRESULT hr;
+    GUID guid = {0x11223344,0x5566,0x7788,{0x99,0xaa,0xbb,0xcc,0xdd,0xee,0xff,0x00}};
+    DateTime time = {0x0102030405060708};
+    TimeSpan span = {-2};
+    static const WCHAR string[] = {'A', 0, 0xe9, 0xd83d, 0xde00};
+    static const BYTE utf8[] = {0x41,0,0xc3,0xa9,0xf0,0x9f,0x98,0x80};
+    static const BYTE utf16be[] = {0,0x41,0,0,0,0xe9,0xd8,0x3d,0xde,0};
+    static const BYTE expected[] = {
+        1,0xff,0x12,0x34,0xff,0xfe,0xff,0xff,0xff,0xfd,
+        0x12,0x34,0x56,0x78,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,
+        0x3f,0x80,0,0,0x3f,0xf0,0,0,0,0,0,0,
+        0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xaa,0xbb,0xcc,0xdd,0xee,0xff,0,
+        1,2,3,4,5,6,7,8,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe };
+    if (!writer) return;
+    HR(IDataWriter_get_ByteOrder(writer, &order)); ok(order == ByteOrder_BigEndian, "default order %u\n", order);
+    HR(IDataWriter_get_UnicodeEncoding(writer, &encoding)); ok(encoding == UnicodeEncoding_Utf8, "default encoding %u\n", encoding);
+    hr = IDataWriter_put_ByteOrder(writer, 99); ok(hr == E_INVALIDARG, "invalid order %#lx\n", hr);
+    hr = IDataWriter_put_UnicodeEncoding(writer, 99); ok(hr == E_INVALIDARG, "invalid encoding %#lx\n", hr);
+    HR(IDataWriter_WriteBoolean(writer, TRUE)); HR(IDataWriter_WriteByte(writer, 0xff));
+    HR(IDataWriter_WriteUInt16(writer, 0x1234)); HR(IDataWriter_WriteInt16(writer, -2)); HR(IDataWriter_WriteInt32(writer, -3));
+    HR(IDataWriter_WriteUInt32(writer, 0x12345678)); HR(IDataWriter_WriteUInt64(writer, 0x0102030405060708));
+    HR(IDataWriter_WriteSingle(writer, 1.0f)); HR(IDataWriter_WriteDouble(writer, 1.0)); HR(IDataWriter_WriteGuid(writer, guid));
+    HR(IDataWriter_WriteDateTime(writer, time)); HR(IDataWriter_WriteTimeSpan(writer, span));
+    HR(IDataWriter_DetachBuffer(writer, &buffer)); buffer_matches(buffer, expected, sizeof(expected)); IBuffer_Release(buffer);
+    HR(IDataWriter_put_ByteOrder(writer, ByteOrder_LittleEndian));
+    HR(IDataWriter_WriteUInt32(writer, 0x12345678));
+    HR(IDataWriter_DetachBuffer(writer, &buffer));
+    { BYTE bytes[] = {0x78,0x56,0x34,0x12}; buffer_matches(buffer, bytes, sizeof(bytes)); }
+    HR(IDataWriter_WriteBufferRange(writer, buffer, 1, 2));
+    hr = IDataWriter_WriteBufferRange(writer, buffer, ~0u, 2); ok(hr == E_INVALIDARG, "range overflow %#lx\n", hr);
+    HR(IDataWriter_WriteBuffer(writer, buffer)); IBuffer_Release(buffer);
+    HR(IDataWriter_DetachBuffer(writer, &buffer));
+    { BYTE bytes[] = {0x56,0x34,0x78,0x56,0x34,0x12}; buffer_matches(buffer, bytes, sizeof(bytes)); }
+    IBuffer_Release(buffer);
+    HR(WindowsCreateString(string, ARRAY_SIZE(string), &text));
+    HR(IDataWriter_MeasureString(writer, text, &count)); ok(count == sizeof(utf8), "UTF8 measure %u\n", count);
+    HR(IDataWriter_WriteString(writer, text, &count)); ok(count == sizeof(utf8), "UTF8 count %u\n", count);
+    HR(IDataWriter_DetachBuffer(writer, &buffer)); buffer_matches(buffer, utf8, sizeof(utf8)); IBuffer_Release(buffer);
+    HR(IDataWriter_put_UnicodeEncoding(writer, UnicodeEncoding_Utf16BE));
+    HR(IDataWriter_WriteString(writer, text, &count)); ok(count == sizeof(utf16be), "UTF16 byte count %u\n", count);
+    HR(IDataWriter_DetachBuffer(writer, &buffer)); buffer_matches(buffer, utf16be, sizeof(utf16be)); IBuffer_Release(buffer);
+    HR(IDataWriter_put_UnicodeEncoding(writer, UnicodeEncoding_Utf16LE));
+    HR(IDataWriter_WriteString(writer, text, &count));
+    HR(IDataWriter_DetachBuffer(writer, &buffer)); buffer_matches(buffer, (const BYTE *)string, sizeof(string)); IBuffer_Release(buffer);
+    WindowsDeleteString(text);
+    HR(IDataWriter_WriteBytes(writer, 0, NULL));
+    hr = IDataWriter_WriteBytes(writer, 1, NULL); ok(hr == E_POINTER, "null bytes %#lx\n", hr);
+    ok(!IDataWriter_Release(writer), "buffer-only writer retained\n");
+}
