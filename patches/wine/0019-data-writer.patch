+struct mock_stream
+{
+    IOutputStream iface;
+    IClosable closable;
+    LONG refs;
+    struct mock_op *last;
+    HRESULT write_hr;
+    unsigned int flushes, closes;
+    IDataWriter *reenter;
+};
+static struct mock_stream *mock_stream_impl(IOutputStream *iface) { return CONTAINING_RECORD(iface, struct mock_stream, iface); }
+static HRESULT WINAPI stream_qi(IOutputStream *iface, REFIID iid, void **out)
+{
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IOutputStream)) *out = iface;
+    else if (IsEqualGUID(iid, &IID_IClosable)) *out = &mock_stream_impl(iface)->closable;
+    else return E_NOINTERFACE;
+    IOutputStream_AddRef(iface); return S_OK;
+}
+static ULONG WINAPI stream_addref(IOutputStream *iface) { return InterlockedIncrement(&mock_stream_impl(iface)->refs); }
+static ULONG WINAPI stream_release(IOutputStream *iface) { return InterlockedDecrement(&mock_stream_impl(iface)->refs); }
+static HRESULT WINAPI stream_iids(IOutputStream *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI stream_name(IOutputStream *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI stream_trust(IOutputStream *iface, TrustLevel *trust) { return E_NOTIMPL; }
+static HRESULT WINAPI stream_write(IOutputStream *iface, IBuffer *buffer, IAsyncOperationWithProgress_UINT32_UINT32 **out)
+{
+    struct mock_stream *impl = mock_stream_impl(iface);
+    HRESULT hr;
+    *out = NULL;
+    if (impl->reenter)
+    {
+        hr = IDataWriter_WriteByte(impl->reenter, 0xf0);
+        ok(hr == BUSY, "write reentrancy not rejected: %#lx\n", hr);
+    }
+    if (FAILED(impl->write_hr)) return impl->write_hr;
+    if (impl->last) mock_release(&impl->last->iface);
+    impl->last = calloc(1, sizeof(*impl->last));
+    impl->last->iface.lpVtbl = &mock_op_vtbl;
+    impl->last->info.lpVtbl = &mock_info_vtbl;
+    impl->last->refs = 1;
+    impl->last->buffer = buffer; IBuffer_AddRef(buffer);
+    *out = &impl->last->iface; mock_addref(*out);
+    return S_OK;
+}
+static HRESULT WINAPI stream_flush(IOutputStream *iface, IAsyncOperation_boolean **out)
+{
+    ++mock_stream_impl(iface)->flushes;
+    *out = NULL;
+    return E_ACCESSDENIED;
+}
+static const IOutputStreamVtbl mock_stream_vtbl = { stream_qi, stream_addref, stream_release,
+    stream_iids, stream_name, stream_trust, stream_write, stream_flush };
+static struct mock_stream *mock_closable_impl(IClosable *iface) { return CONTAINING_RECORD(iface, struct mock_stream, closable); }
+static HRESULT WINAPI close_qi(IClosable *iface, REFIID iid, void **out) { return stream_qi(&mock_closable_impl(iface)->iface, iid, out); }
+static ULONG WINAPI close_addref(IClosable *iface) { return stream_addref(&mock_closable_impl(iface)->iface); }
+static ULONG WINAPI close_release(IClosable *iface) { return stream_release(&mock_closable_impl(iface)->iface); }
+static HRESULT WINAPI close_iids(IClosable *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI close_name(IClosable *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI close_trust(IClosable *iface, TrustLevel *trust) { return E_NOTIMPL; }
+static HRESULT WINAPI close_close(IClosable *iface) { ++mock_closable_impl(iface)->closes; return S_OK; }
+static const IClosableVtbl mock_closable_vtbl = { close_qi, close_addref, close_release, close_iids, close_name, close_trust, close_close };
