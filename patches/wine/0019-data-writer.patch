+static void test_pending_writer(void)
+{
+    struct mock_stream stream = { {&mock_stream_vtbl}, {&mock_closable_vtbl}, 1 };
+    struct completion handler = { {&completion_vtbl}, 1 };
+    IDataWriter *writer = create_writer(&stream.iface);
+    IAsyncOperation_UINT32 *op, *other;
+    IAsyncOperation_boolean *flush;
+    IAsyncInfo *info;
+    IOutputStream *detached;
+    IBuffer *buffer;
+    IUnknown *a, *b;
+    UINT32 count;
+    AsyncStatus status;
+    HRESULT hr;
+    BYTE bytes[] = {1, 2, 3, 4, 5, 6};
+    if (!writer) return;
+    stream.reenter = writer;
+    HR(IDataWriter_WriteBytes(writer, sizeof(bytes), bytes));
+    HR(IDataWriter_StoreAsync(writer, &op));
+    buffer_matches(stream.last->buffer, bytes, sizeof(bytes));
+    HR(IAsyncOperation_UINT32_QueryInterface(op, &IID_IAsyncInfo, (void **)&info));
+    HR(IAsyncInfo_get_Status(info, &status));
+    ok(status == Started, "premature status %u\n", status);
+    hr = IAsyncOperation_UINT32_GetResults(op, &count);
+    ok(hr == E_ILLEGAL_METHOD_CALL, "premature result %#lx\n", hr);
+    hr = IAsyncInfo_Close(info); ok(hr == E_ILLEGAL_STATE_CHANGE, "premature close %#lx\n", hr);
+    HR(IAsyncInfo_QueryInterface(info, &IID_IUnknown, (void **)&a));
+    HR(IAsyncOperation_UINT32_QueryInterface(op, &IID_IUnknown, (void **)&b));
+    ok(a == b, "async identity mismatch\n"); IUnknown_Release(a); IUnknown_Release(b);
+    HR(IAsyncOperation_UINT32_put_Completed(op, &handler.iface));
+    hr = IAsyncOperation_UINT32_put_Completed(op, &handler.iface);
+    ok(hr == E_ILLEGAL_DELEGATE_ASSIGNMENT, "second completion assignment %#lx\n", hr);
+    hr = IDataWriter_WriteByte(writer, 9); ok(hr == BUSY, "write while storing %#lx\n", hr);
+    other = (void *)0xdeadbeef;
+    hr = IDataWriter_StoreAsync(writer, &other); ok(hr == BUSY && !other, "overlap store %#lx/%p\n", hr, other);
+    hr = IDataWriter_DetachStream(writer, &detached); ok(hr == BUSY && !detached, "detach while storing %#lx\n", hr);
+    hr = IDataWriter_DetachBuffer(writer, &buffer); ok(hr == BUSY && !buffer, "detach buffer while storing %#lx\n", hr);
+    hr = IDataWriter_FlushAsync(writer, &flush); ok(hr == BUSY && !flush, "flush while storing %#lx\n", hr);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == 6, "pending bytes %u\n", count);
+    handler.reenter = writer;
+    mock_finish(stream.last, Completed, S_OK, 2);
+    ok(handler.calls == 1 && handler.status == Completed && handler.result_hr == S_OK && handler.result == 2,
+       "completion calls/status/result %ld/%u/%#lx/%u\n", handler.calls, handler.status, handler.result_hr, handler.result);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == 5, "short write lost tail: %u\n", count);
+    HR(IDataWriter_DetachBuffer(writer, &buffer));
+    { BYTE expected[] = {3,4,5,6,0x7e}; buffer_matches(buffer, expected, sizeof(expected)); }
+    IBuffer_Release(buffer);
+    ok(stream.last->refs == 1, "child adapter cycle retained: %ld\n", stream.last->refs);
+    HR(IAsyncInfo_Close(info));
+    hr = IAsyncOperation_UINT32_GetResults(op, &count); ok(hr == E_ILLEGAL_METHOD_CALL, "closed result %#lx\n", hr);
+    IAsyncInfo_Release(info); IAsyncOperation_UINT32_Release(op);
+    ok(handler.refs == 1, "completion handler leaked: %ld\n", handler.refs);
+
+    HR(IDataWriter_WriteBytes(writer, sizeof(bytes), bytes));
+    HR(IDataWriter_StoreAsync(writer, &op));
+    HR(IAsyncOperation_UINT32_QueryInterface(op, &IID_IAsyncInfo, (void **)&info));
+    HR(IAsyncInfo_Cancel(info));
+    ok(stream.last->canceled == 1, "child cancel not called\n");
+    HR(IAsyncInfo_get_Status(info, &status)); ok(status == Canceled, "cancel status %u\n", status);
+    hr = IAsyncOperation_UINT32_GetResults(op, &count); ok(hr == E_ABORT && !count, "canceled result %#lx/%u\n", hr, count);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == 6, "cancel lost pending bytes\n");
+    IAsyncInfo_Release(info); IAsyncOperation_UINT32_Release(op);
+    HR(IDataWriter_StoreAsync(writer, &op));
+    mock_finish(stream.last, Error, E_ACCESSDENIED, 0);
+    hr = IAsyncOperation_UINT32_GetResults(op, &count); ok(hr == E_ACCESSDENIED, "error propagation %#lx\n", hr);
+    IAsyncOperation_UINT32_Release(op);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == 6, "error lost pending bytes\n");
+    /* Complete on another thread after caller drops its operation reference. */
+    {
+        struct completion threaded = { {&completion_vtbl}, 1 };
+        HANDLE thread;
+        DWORD wait;
+        HR(IDataWriter_StoreAsync(writer, &op));
+        threaded.event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        HR(IAsyncOperation_UINT32_put_Completed(op, &threaded.iface));
+        IAsyncOperation_UINT32_Release(op);
+        mock_addref(&stream.last->iface);
+        thread = CreateThread(NULL, 0, finish_worker, stream.last, 0, NULL);
+        ok(!!thread, "create completion thread\n");
+        if (thread)
+        {
+            wait = WaitForSingleObject(thread, 5000);
+            ok(wait == WAIT_OBJECT_0, "completion thread wait %lu\n", wait);
+            if (wait != WAIT_OBJECT_0) WaitForSingleObject(thread, INFINITE);
+            CloseHandle(thread);
+        }
+        else finish_worker(stream.last);
+        ok(threaded.calls == 1 && threaded.status == Completed && threaded.result == 6 && threaded.refs == 1,
+           "cross-thread completion %ld/%u/%u/%ld\n", threaded.calls, threaded.status, threaded.result, threaded.refs);
+        CloseHandle(threaded.event);
+        HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(!count, "threaded store retained bytes\n");
+        ok(stream.last->refs == 1, "threaded child retained %ld\n", stream.last->refs);
+    }
+    HR(IDataWriter_WriteBytes(writer, sizeof(bytes), bytes));
+    HR(IDataWriter_StoreAsync(writer, &op));
+    mock_finish(stream.last, Completed, S_OK, 7);
+    hr = IAsyncOperation_UINT32_GetResults(op, &count);
+    ok(hr == E_UNEXPECTED, "invalid child byte count accepted %#lx\n", hr);
+    IAsyncOperation_UINT32_Release(op);
+    HR(IDataWriter_get_UnstoredBufferLength(writer, &count)); ok(count == 6, "invalid result lost bytes\n");
+    stream.write_hr = E_OUTOFMEMORY;
+    op = (void *)0xdeadbeef;
+    hr = IDataWriter_StoreAsync(writer, &op); ok(hr == E_OUTOFMEMORY && !op, "creation failure %#lx/%p\n", hr, op);
+    HR(IDataWriter_WriteByte(writer, 7));
+    hr = IDataWriter_FlushAsync(writer, &flush); ok(hr == E_ACCESSDENIED && !flush && stream.flushes == 1, "flush forwarding %#lx\n", hr);
+    HR(IDataWriter_DetachStream(writer, &detached)); ok(detached == &stream.iface, "detach identity\n");
+    IOutputStream_Release(detached);
+    close_writer(writer); ok(!stream.closes, "detached stream closed\n");
+    hr = IDataWriter_WriteByte(writer, 1); ok(hr == RO_E_CLOSED, "write after close %#lx\n", hr);
+    ok(!IDataWriter_Release(writer), "writer retained\n");
+    ok(stream.refs == 1, "stream retained %ld\n", stream.refs);
+    mock_release(&stream.last->iface); stream.last = NULL;
+    writer = create_writer(&stream.iface);
+    close_writer(writer); close_writer(writer); ok(stream.closes == 1, "close count %u\n", stream.closes);
+    IDataWriter_Release(writer);
+    ok(stream.refs == 1, "closed stream retained\n");
+    stream.write_hr = S_OK;
+    writer = create_writer(&stream.iface);
+    stream.reenter = NULL;
+    HR(IDataWriter_WriteBytes(writer, sizeof(bytes), bytes));
+    HR(IDataWriter_StoreAsync(writer, &op));
+    close_writer(writer);
+    IDataWriter_Release(writer);
+    mock_finish(stream.last, Error, RO_E_CLOSED, 0);
+    hr = IAsyncOperation_UINT32_GetResults(op, &count);
+    ok(hr == RO_E_CLOSED, "pending close result %#lx\n", hr);
+    IAsyncOperation_UINT32_Release(op);
+    ok(stream.refs == 1 && stream.last->refs == 1, "pending close retained references\n");
+    mock_release(&stream.last->iface);
+
+}
