+static HRESULT factory( const WCHAR *class, REFIID iid, void **out )
+{
+    HSTRING name;
+    HRESULT hr;
+    HR(WindowsCreateString(class, wcslen(class), &name));
+    hr = RoGetActivationFactory(name, iid, out);
+    WindowsDeleteString(name);
+    ok(hr == S_OK, "activation %s: %#lx\n", wine_dbgstr_w(class), hr);
+    return hr;
+}
+static IDataWriter *create_writer( IOutputStream *stream )
+{
+    IDataWriterFactory *f;
+    IActivationFactory *activation;
+    IDataWriter *writer = NULL;
+    IInspectable *instance;
+    if (stream)
+    {
+        if (FAILED(factory(L"Windows.Storage.Streams.DataWriter", &IID_IDataWriterFactory, (void **)&f))) return NULL;
+        HR(IDataWriterFactory_CreateDataWriter(f, stream, &writer));
+        IDataWriterFactory_Release(f);
+    }
+    else
+    {
+        if (FAILED(factory(L"Windows.Storage.Streams.DataWriter", &IID_IActivationFactory, (void **)&activation))) return NULL;
+        HR(IActivationFactory_ActivateInstance(activation, &instance));
+        HR(IInspectable_QueryInterface(instance, &IID_IDataWriter, (void **)&writer));
+        IInspectable_Release(instance);
+        IActivationFactory_Release(activation);
+    }
+    return writer;
+}
+static BYTE *buffer_data( IBuffer *buffer )
+{
+    IBufferByteAccess *access;
+    BYTE *data = NULL;
+    HR(IBuffer_QueryInterface(buffer, &IID_IBufferByteAccess, (void **)&access));
+    HR(IBufferByteAccess_Buffer(access, &data));
+    IBufferByteAccess_Release(access);
+    return data;
+}
+static void buffer_matches( IBuffer *buffer, const BYTE *expected, UINT32 size )
+{
+    UINT32 length;
+    HR(IBuffer_get_Length(buffer, &length));
+    ok(length == size, "buffer length %u expected %u\n", length, size);
+    if (length == size && size) ok(!memcmp(buffer_data(buffer), expected, size), "buffer data mismatch\n");
+}
+static void close_writer( IDataWriter *writer )
