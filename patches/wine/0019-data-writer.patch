+    if (*handler) IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_AddRef(*handler);
+    return S_OK;
+}
+static HRESULT WINAPI mock_results(IAsyncOperationWithProgress_UINT32_UINT32 *iface, UINT32 *count)
+{
+    struct mock_op *impl = mock_from_op(iface);
+    *count = impl->status == Completed ? impl->count : 0;
+    return impl->status == Started ? E_ILLEGAL_METHOD_CALL : impl->error;
+}
+static const IAsyncOperationWithProgress_UINT32_UINT32Vtbl mock_op_vtbl =
+{ mock_qi, mock_addref, mock_release, mock_iids, mock_name, mock_trust, mock_put_progress,
+  mock_get_progress, mock_put_completed, mock_get_completed, mock_results };
+static void mock_finish(struct mock_op *impl, AsyncStatus status, HRESULT error, UINT32 count)
+{
+    IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *handler = impl->handler;
+    impl->handler = NULL;
+    impl->status = status; impl->error = error; impl->count = count;
+    if (handler)
+    {
+        IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_Invoke(handler, &impl->iface, status);
+        IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_Release(handler);
+    }
+}
+static HRESULT WINAPI mock_info_qi(IAsyncInfo *iface, REFIID iid, void **out) { return mock_qi(&mock_from_info(iface)->iface, iid, out); }
+static ULONG WINAPI mock_info_addref(IAsyncInfo *iface) { return mock_addref(&mock_from_info(iface)->iface); }
+static ULONG WINAPI mock_info_release(IAsyncInfo *iface) { return mock_release(&mock_from_info(iface)->iface); }
+static HRESULT WINAPI mock_info_iids(IAsyncInfo *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI mock_info_name(IAsyncInfo *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI mock_info_trust(IAsyncInfo *iface, TrustLevel *trust) { return E_NOTIMPL; }
+static HRESULT WINAPI mock_info_id(IAsyncInfo *iface, UINT32 *id) { *id = 45; return S_OK; }
+static HRESULT WINAPI mock_info_status(IAsyncInfo *iface, AsyncStatus *status) { *status = mock_from_info(iface)->status; return S_OK; }
+static HRESULT WINAPI mock_info_error(IAsyncInfo *iface, HRESULT *error) { *error = mock_from_info(iface)->error; return S_OK; }
+static HRESULT WINAPI mock_info_cancel(IAsyncInfo *iface)
+{
