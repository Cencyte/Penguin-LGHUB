+static HRESULT WINAPI mock_info_close(IAsyncInfo *iface) { return S_OK; }
+static const IAsyncInfoVtbl mock_info_vtbl = { mock_info_qi, mock_info_addref, mock_info_release,
+    mock_info_iids, mock_info_name, mock_info_trust, mock_info_id, mock_info_status, mock_info_error, mock_info_cancel, mock_info_close };
