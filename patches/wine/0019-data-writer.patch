+#define WRITER_BUSY HRESULT_FROM_WIN32(ERROR_INVALID_OPERATION)
+#define ASYNC_CLOSED 4
+
+struct data_writer
+{
+    IDataWriter IDataWriter_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    SRWLOCK lock;
+    BYTE *data;
+    UINT32 length, capacity;
+    IOutputStream *stream;
+    ByteOrder order;
+    UnicodeEncoding encoding;
+    BOOL closed, storing;
+};
+
+static struct data_writer *writer_from_iface( IDataWriter *iface )
+{
+    return CONTAINING_RECORD( iface, struct data_writer, IDataWriter_iface );
+}
+
+static HRESULT copy_iids( const IID *const *ids, ULONG count, ULONG *iid_count, IID **iids )
+{
+    ULONG i;
+    if (!iid_count || !iids) return E_POINTER;
+    *iid_count = 0;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i) (*iids)[i] = *ids[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+static HRESULT WINAPI writer_QueryInterface( IDataWriter *iface, REFIID iid, void **out )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IDataWriter)) *out = iface;
+    else if (IsEqualGUID(iid, &IID_IClosable)) *out = &impl->IClosable_iface;
+    else return E_NOINTERFACE;
+    IDataWriter_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI writer_AddRef( IDataWriter *iface )
+{
+    return InterlockedIncrement( &writer_from_iface(iface)->ref );
+}
+
+static ULONG WINAPI writer_Release( IDataWriter *iface )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->stream) IOutputStream_Release( impl->stream );
+        free( impl->data );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI writer_GetIids( IDataWriter *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IDataWriter, &IID_IClosable };
+    return copy_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+
+static HRESULT WINAPI writer_GetRuntimeClassName( IDataWriter *iface, HSTRING *name )
+{
+    static const WCHAR value[] = L"Windows.Storage.Streams.DataWriter";
+    return WindowsCreateString( value, ARRAY_SIZE(value) - 1, name );
+}
+
+static HRESULT WINAPI writer_GetTrustLevel( IDataWriter *iface, TrustLevel *trust )
+{
+    if (!trust) return E_POINTER;
+    *trust = BaseTrust;
+    return S_OK;
+}
+
+/* Callers hold the writer lock. A pending store owns an immutable buffer. */
+static HRESULT writer_ready( struct data_writer *impl )
+{
+    return impl->closed ? RO_E_CLOSED : impl->storing ? WRITER_BUSY : S_OK;
+}
+
+static HRESULT writer_append( struct data_writer *impl, const BYTE *data, UINT32 length )
+{
+    UINT32 capacity;
+    BYTE *resized;
+    HRESULT hr = writer_ready( impl );
+    if (FAILED(hr)) return hr;
+    if (length && !data) return E_POINTER;
+    if (length > UINT_MAX - impl->length) return E_OUTOFMEMORY;
+    if (impl->length + length > impl->capacity)
+    {
+        capacity = max( impl->length + length, 256 );
+        if (impl->capacity <= UINT_MAX / 2) capacity = max( capacity, impl->capacity * 2 );
+        if (!(resized = realloc( impl->data, capacity ))) return E_OUTOFMEMORY;
+        impl->data = resized;
+        impl->capacity = capacity;
+    }
+    if (length) memcpy( impl->data + impl->length, data, length );
+    impl->length += length;
+    return S_OK;
+}
+
+static HRESULT WINAPI writer_get_UnstoredBufferLength( IDataWriter *iface, UINT32 *value )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    AcquireSRWLockShared( &impl->lock );
+    *value = impl->closed ? 0 : impl->length;
+    hr = impl->closed ? RO_E_CLOSED : S_OK;
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+
+#define WRITER_PROPERTY(name, type, member, valid) \
+static HRESULT WINAPI writer_get_##name( IDataWriter *iface, type *value ) \
+{ \
+    struct data_writer *impl = writer_from_iface(iface); \
+    HRESULT hr; \
+    if (!value) return E_POINTER; \
+    AcquireSRWLockShared(&impl->lock); \
+    *value = impl->member; \
+    hr = impl->closed ? RO_E_CLOSED : S_OK; \
+    ReleaseSRWLockShared(&impl->lock); \
+    return hr; \
+} \
+static HRESULT WINAPI writer_put_##name( IDataWriter *iface, type value ) \
+{ \
+    struct data_writer *impl = writer_from_iface(iface); \
+    HRESULT hr; \
+    AcquireSRWLockExclusive(&impl->lock); \
+    hr = writer_ready(impl); \
+    if (SUCCEEDED(hr) && !(valid)) hr = E_INVALIDARG; \
+    if (SUCCEEDED(hr)) impl->member = value; \
+    ReleaseSRWLockExclusive(&impl->lock); \
+    return hr; \
+}
+WRITER_PROPERTY(ByteOrder, ByteOrder, order, value == ByteOrder_LittleEndian || value == ByteOrder_BigEndian)
+WRITER_PROPERTY(UnicodeEncoding, UnicodeEncoding, encoding,
+                value == UnicodeEncoding_Utf8 || value == UnicodeEncoding_Utf16LE || value == UnicodeEncoding_Utf16BE)
+
+static HRESULT WINAPI writer_WriteBytes( IDataWriter *iface, UINT32 count, BYTE *value )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    HRESULT hr;
+    if (!TryAcquireSRWLockExclusive( &impl->lock )) return WRITER_BUSY;
+    hr = writer_append( impl, value, count );
+    ReleaseSRWLockExclusive( &impl->lock );
+    TRACE( "writer %p, count %u, hr %#lx.\n", iface, count, hr );
+    return hr;
+}
+
+static HRESULT WINAPI writer_WriteByte( IDataWriter *iface, BYTE value )
+{
+    return writer_WriteBytes( iface, 1, &value );
+}
+
+static HRESULT WINAPI writer_WriteBoolean( IDataWriter *iface, BOOLEAN value )
+{
+    return writer_WriteByte( iface, !!value );
+}
+
+static HRESULT writer_number( IDataWriter *iface, UINT64 value, unsigned int size )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    BYTE bytes[8];
+    unsigned int i;
+    HRESULT hr;
+    if (!TryAcquireSRWLockExclusive( &impl->lock )) return WRITER_BUSY;
+    for (i = 0; i < size; ++i)
+        bytes[impl->order == ByteOrder_LittleEndian ? i : size - i - 1] = value >> (8 * i);
+    hr = writer_append( impl, bytes, size );
+    ReleaseSRWLockExclusive( &impl->lock );
+    return hr;
+}
+#define WRITER_NUMBER(name, type) \
+static HRESULT WINAPI writer_Write##name( IDataWriter *iface, type value ) \
+{ return writer_number( iface, (UINT64)value, sizeof(value) ); }
+WRITER_NUMBER(Int16, INT16)
+WRITER_NUMBER(Int32, INT32)
+WRITER_NUMBER(Int64, INT64)
+WRITER_NUMBER(UInt16, UINT16)
+WRITER_NUMBER(UInt32, UINT32)
+WRITER_NUMBER(UInt64, UINT64)
+
+static HRESULT WINAPI writer_WriteSingle( IDataWriter *iface, FLOAT value )
+{
+    UINT32 bits;
+    memcpy( &bits, &value, sizeof(bits) );
+    return writer_number( iface, bits, sizeof(bits) );
+}
+static HRESULT WINAPI writer_WriteDouble( IDataWriter *iface, DOUBLE value )
+{
+    UINT64 bits;
+    memcpy( &bits, &value, sizeof(bits) );
+    return writer_number( iface, bits, sizeof(bits) );
+}
+static HRESULT WINAPI writer_WriteDateTime( IDataWriter *iface, DateTime value )
+{
+    return writer_WriteInt64( iface, value.UniversalTime );
+}
+static HRESULT WINAPI writer_WriteTimeSpan( IDataWriter *iface, TimeSpan value )
+{
+    return writer_WriteInt64( iface, value.Duration );
+}
+static HRESULT WINAPI writer_WriteGuid( IDataWriter *iface, GUID value )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    BYTE bytes[16];
+    unsigned int i;
+    HRESULT hr;
+    if (!TryAcquireSRWLockExclusive( &impl->lock )) return WRITER_BUSY;
+    for (i = 0; i < 4; ++i) bytes[impl->order == ByteOrder_LittleEndian ? i : 3 - i] = value.Data1 >> (8 * i);
+    for (i = 0; i < 2; ++i)
+    {
+        bytes[4 + (impl->order == ByteOrder_LittleEndian ? i : 1 - i)] = value.Data2 >> (8 * i);
+        bytes[6 + (impl->order == ByteOrder_LittleEndian ? i : 1 - i)] = value.Data3 >> (8 * i);
+    }
+    memcpy( bytes + 8, value.Data4, 8 );
+    hr = writer_append( impl, bytes, sizeof(bytes) );
+    ReleaseSRWLockExclusive( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI writer_WriteBufferRange( IDataWriter *iface, IBuffer *buffer, UINT32 start, UINT32 count )
+{
+    IBufferByteAccess *access;
+    UINT32 length, capacity;
+    BYTE *data;
+    HRESULT hr;
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    if (FAILED(hr = IBuffer_get_Capacity( buffer, &capacity ))) return hr;
+    if (length > capacity || start > length || count > length - start) return E_INVALIDARG;
+    if (!count) return writer_WriteBytes( iface, 0, NULL );
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = IBufferByteAccess_Buffer( access, &data );
+    if (SUCCEEDED(hr)) hr = data ? writer_WriteBytes( iface, count, data + start ) : E_POINTER;
+    IBufferByteAccess_Release( access );
+    return hr;
+}
+static HRESULT WINAPI writer_WriteBuffer( IDataWriter *iface, IBuffer *buffer )
+{
+    UINT32 length;
+    HRESULT hr;
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    return writer_WriteBufferRange( iface, buffer, 0, length );
+}
+
+static HRESULT writer_string( IDataWriter *iface, HSTRING value, UINT32 *count, BOOL append )
+{
+    struct data_writer *impl = writer_from_iface( iface );
+    const WCHAR *text;
+    UINT32 length, bytes = 0, i;
+    BYTE *encoded = NULL;
+    int converted;
+    HRESULT hr;
+    if (!count) return E_POINTER;
+    *count = 0;
+    text = WindowsGetStringRawBuffer( value, &length );
+    if (!TryAcquireSRWLockExclusive( &impl->lock )) return WRITER_BUSY;
+    if (FAILED(hr = writer_ready( impl ))) goto done;
+    if (impl->encoding == UnicodeEncoding_Utf8)
+    {
+        if (length > INT_MAX) { hr = E_OUTOFMEMORY; goto done; }
+        converted = length ? WideCharToMultiByte( CP_UTF8, 0, text, length, NULL, 0, NULL, NULL ) : 0;
+        if (length && !converted) { hr = HRESULT_FROM_WIN32(GetLastError()); goto done; }
+        bytes = converted;
+        if (append && bytes)
+        {
+            if (!(encoded = malloc(bytes))) { hr = E_OUTOFMEMORY; goto done; }
+            if (!WideCharToMultiByte( CP_UTF8, 0, text, length, (char *)encoded, bytes, NULL, NULL ))
+            { hr = HRESULT_FROM_WIN32(GetLastError()); goto done; }
+        }
+    }
+    else
+    {
+        if (length > UINT_MAX / 2) { hr = E_OUTOFMEMORY; goto done; }
+        bytes = length * 2;
+        if (append && bytes)
+        {
+            if (!(encoded = malloc(bytes))) { hr = E_OUTOFMEMORY; goto done; }
+            for (i = 0; i < length; ++i)
+            {
+                encoded[2*i + (impl->encoding == UnicodeEncoding_Utf16LE ? 0 : 1)] = text[i];
+                encoded[2*i + (impl->encoding == UnicodeEncoding_Utf16LE ? 1 : 0)] = text[i] >> 8;
+            }
+        }
+    }
+    if (append) hr = writer_append( impl, encoded, bytes );
+    if (SUCCEEDED(hr)) *count = bytes;
+done:
+    ReleaseSRWLockExclusive( &impl->lock );
+    free( encoded );
+    return hr;
+}
+static HRESULT WINAPI writer_WriteString( IDataWriter *iface, HSTRING value, UINT32 *count )
+{
+    return writer_string( iface, value, count, TRUE );
+}
+static HRESULT WINAPI writer_MeasureString( IDataWriter *iface, HSTRING value, UINT32 *count )
+{
+    return writer_string( iface, value, count, FALSE );
+}
+
+static HRESULT writer_buffer( const BYTE *data, UINT32 length, IBuffer **out )
+{
+    static const WCHAR class[] = L"Windows.Storage.Streams.Buffer";
+    IBufferFactory *factory;
+    IBufferByteAccess *access;
+    HSTRING name;
+    BYTE *target;
+    HRESULT hr;
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString( class, ARRAY_SIZE(class) - 1, &name ))) return hr;
+    hr = RoGetActivationFactory( name, &IID_IBufferFactory, (void **)&factory );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return hr;
+    hr = IBufferFactory_Create( factory, length, out );
+    IBufferFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = IBuffer_QueryInterface( *out, &IID_IBufferByteAccess, (void **)&access )))
+    {
+        hr = IBufferByteAccess_Buffer( access, &target );
+        if (SUCCEEDED(hr) && length)
+        {
+            if (!target) hr = E_POINTER;
+            else memcpy( target, data, length );
+        }
+        IBufferByteAccess_Release( access );
+    }
+    if (SUCCEEDED(hr)) hr = IBuffer_put_Length( *out, length );
+    if (FAILED(hr)) { IBuffer_Release(*out); *out = NULL; }
+    return hr;
+}
+
+/* Adapter from the output stream's real write operation to DataWriterStoreOperation.
+ * The child's completion breaks the temporary child/delegate reference cycle.
+ * No waiting or message pumping happens on the calling thread. */
+struct writer_store
+{
+    IAsyncOperation_UINT32 IAsyncOperation_UINT32_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 handler_iface;
+    LONG ref;
+    SRWLOCK lock;
+    struct data_writer *writer;
+    IBuffer *buffer;
+    IAsyncOperationWithProgress_UINT32_UINT32 *child;
+    IAsyncInfo *child_info;
+    IAsyncOperationCompletedHandler_UINT32 *completed;
+    AsyncStatus status;
+    HRESULT error;
+    UINT32 count, id;
+    BOOL assigned;
+};
+
+static struct writer_store *store_from_iface( IAsyncOperation_UINT32 *iface )
+{
+    return CONTAINING_RECORD( iface, struct writer_store, IAsyncOperation_UINT32_iface );
+}
+static HRESULT WINAPI store_QueryInterface( IAsyncOperation_UINT32 *iface, REFIID iid, void **out )
+{
+    struct writer_store *impl = store_from_iface( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IAsyncOperation_UINT32)) *out = iface;
+    else if (IsEqualGUID(iid, &IID_IAsyncInfo)) *out = &impl->IAsyncInfo_iface;
+    else return E_NOINTERFACE;
+    IAsyncOperation_UINT32_AddRef( iface );
+    return S_OK;
+}
+static ULONG WINAPI store_AddRef( IAsyncOperation_UINT32 *iface )
+{
+    return InterlockedIncrement( &store_from_iface(iface)->ref );
+}
+static ULONG WINAPI store_Release( IAsyncOperation_UINT32 *iface )
+{
+    struct writer_store *impl = store_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->completed) IAsyncOperationCompletedHandler_UINT32_Release( impl->completed );
+        if (impl->child_info) IAsyncInfo_Release( impl->child_info );
+        if (impl->child) IAsyncOperationWithProgress_UINT32_UINT32_Release( impl->child );
+        if (impl->buffer) IBuffer_Release( impl->buffer );
+        IDataWriter_Release( &impl->writer->IDataWriter_iface );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI store_GetIids( IAsyncOperation_UINT32 *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IAsyncOperation_UINT32, &IID_IAsyncInfo };
+    return copy_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+static HRESULT WINAPI store_GetRuntimeClassName( IAsyncOperation_UINT32 *iface, HSTRING *name )
+{
+    static const WCHAR value[] = L"Windows.Storage.Streams.DataWriterStoreOperation";
+    return WindowsCreateString( value, ARRAY_SIZE(value) - 1, name );
+}
+static HRESULT WINAPI store_GetTrustLevel( IAsyncOperation_UINT32 *iface, TrustLevel *trust )
+{
+    if (!trust) return E_POINTER;
+    *trust = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI store_put_Completed( IAsyncOperation_UINT32 *iface, IAsyncOperationCompletedHandler_UINT32 *handler )
+{
+    struct writer_store *impl = store_from_iface( iface );
+    AsyncStatus status;
+    HRESULT hr = S_OK;
+    BOOL invoke = FALSE;
+    if (handler) IAsyncOperationCompletedHandler_UINT32_AddRef( handler );
+    AcquireSRWLockExclusive( &impl->lock );
+    status = impl->status;
+    if (status == ASYNC_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    else if (impl->assigned) hr = E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    else
+    {
+        impl->assigned = TRUE;
+        if (status == Started) { impl->completed = handler; handler = NULL; }
+        else invoke = TRUE;
+    }
+    ReleaseSRWLockExclusive( &impl->lock );
+    if (handler)
+    {
+        if (invoke)
+        {
+            IAsyncOperation_UINT32_AddRef( iface );
+            IAsyncOperationCompletedHandler_UINT32_Invoke( handler, iface, status );
+            IAsyncOperation_UINT32_Release( iface );
+        }
+        IAsyncOperationCompletedHandler_UINT32_Release( handler );
+    }
+    return hr;
+}
+static HRESULT WINAPI store_get_Completed( IAsyncOperation_UINT32 *iface, IAsyncOperationCompletedHandler_UINT32 **handler )
+{
+    struct writer_store *impl = store_from_iface( iface );
+    HRESULT hr;
+    if (!handler) return E_POINTER;
+    AcquireSRWLockShared( &impl->lock );
+    *handler = impl->completed;
+    if (*handler) IAsyncOperationCompletedHandler_UINT32_AddRef( *handler );
+    hr = impl->status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : S_OK;
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+static HRESULT WINAPI store_GetResults( IAsyncOperation_UINT32 *iface, UINT32 *count )
+{
+    struct writer_store *impl = store_from_iface( iface );
+    HRESULT hr;
+    if (!count) return E_POINTER;
+    AcquireSRWLockShared( &impl->lock );
+    *count = impl->status == Completed ? impl->count : 0;
+    hr = impl->status == Started || impl->status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : impl->error;
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+static const IAsyncOperation_UINT32Vtbl store_vtbl =
+{
+    store_QueryInterface, store_AddRef, store_Release, store_GetIids, store_GetRuntimeClassName,
+    store_GetTrustLevel, store_put_Completed, store_get_Completed, store_GetResults,
+};
+DEFINE_IINSPECTABLE( store_info, IAsyncInfo, struct writer_store, IAsyncOperation_UINT32_iface )
+static HRESULT WINAPI store_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    struct writer_store *impl = impl_from_IAsyncInfo(iface);
+    HRESULT hr;
+    if (!id) return E_POINTER;
+    AcquireSRWLockShared(&impl->lock);
+    *id = impl->id;
+    hr = impl->status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : S_OK;
+    ReleaseSRWLockShared(&impl->lock);
+    return hr;
+}
+static HRESULT WINAPI store_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct writer_store *impl = impl_from_IAsyncInfo(iface);
+    if (!status) return E_POINTER;
+    AcquireSRWLockShared(&impl->lock);
+    *status = impl->status;
+    ReleaseSRWLockShared(&impl->lock);
+    return *status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+static HRESULT WINAPI store_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    struct writer_store *impl = impl_from_IAsyncInfo(iface);
+    HRESULT hr;
+    if (!error) return E_POINTER;
+    AcquireSRWLockShared(&impl->lock);
+    hr = impl->status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : S_OK;
+    *error = FAILED(hr) ? hr : impl->error;
+    ReleaseSRWLockShared(&impl->lock);
+    return hr;
+}
+static HRESULT WINAPI store_info_Cancel( IAsyncInfo *iface )
+{
+    struct writer_store *impl = impl_from_IAsyncInfo(iface);
+    IAsyncInfo *child = NULL;
+    HRESULT hr = S_OK;
+    AcquireSRWLockShared(&impl->lock);
+    if (impl->status == ASYNC_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    else if ((child = impl->child_info)) IAsyncInfo_AddRef(child);
+    ReleaseSRWLockShared(&impl->lock);
+    if (child) { hr = IAsyncInfo_Cancel(child); IAsyncInfo_Release(child); }
+    return hr;
+}
+static HRESULT WINAPI store_info_Close( IAsyncInfo *iface )
+{
+    struct writer_store *impl = impl_from_IAsyncInfo(iface);
+    HRESULT hr = S_OK;
+    AcquireSRWLockExclusive(&impl->lock);
+    if (impl->status == Started) hr = E_ILLEGAL_STATE_CHANGE;
+    else impl->status = ASYNC_CLOSED;
+    ReleaseSRWLockExclusive(&impl->lock);
+    return hr;
+}
+static const IAsyncInfoVtbl store_info_vtbl =
+{
+    store_info_QueryInterface, store_info_AddRef, store_info_Release, store_info_GetIids,
+    store_info_GetRuntimeClassName, store_info_GetTrustLevel, store_info_get_Id,
+    store_info_get_Status, store_info_get_ErrorCode, store_info_Cancel, store_info_Close,
+};
+
+static void store_finish( struct writer_store *impl, AsyncStatus status, HRESULT hr, UINT32 count )
+{
+    IAsyncOperationCompletedHandler_UINT32 *handler;
+    IAsyncOperationWithProgress_UINT32_UINT32 *child;
+    IAsyncInfo *child_info;
+    IBuffer *buffer;
+    struct data_writer *writer = impl->writer;
+
+    /* This helper is called once, either by completion or by creation failure. */
+    AcquireSRWLockExclusive(&writer->lock);
+    if (SUCCEEDED(hr) && count > writer->length) { hr = E_UNEXPECTED; status = Error; count = 0; }
+    if (SUCCEEDED(hr) && count)
+    {
+        writer->length -= count;
+        memmove(writer->data, writer->data + count, writer->length);
+    }
+    writer->storing = FALSE;
+    ReleaseSRWLockExclusive(&writer->lock);
+
+    AcquireSRWLockExclusive(&impl->lock);
+    impl->status = status;
+    impl->error = hr;
+    impl->count = SUCCEEDED(hr) ? count : 0;
+    handler = impl->completed; impl->completed = NULL;
+    child = impl->child; impl->child = NULL;
+    child_info = impl->child_info; impl->child_info = NULL;
+    buffer = impl->buffer; impl->buffer = NULL;
+    ReleaseSRWLockExclusive(&impl->lock);
+    TRACE("store %p, status %u, count %u, hr %#lx.\n", impl, status, count, hr);
+    if (handler)
+    {
+        IAsyncOperationCompletedHandler_UINT32_Invoke(handler, &impl->IAsyncOperation_UINT32_iface, status);
+        IAsyncOperationCompletedHandler_UINT32_Release(handler);
+    }
+    if (child_info) IAsyncInfo_Release(child_info);
+    if (child) IAsyncOperationWithProgress_UINT32_UINT32_Release(child);
+    if (buffer) IBuffer_Release(buffer);
+}
+static struct writer_store *store_from_handler( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    return CONTAINING_RECORD(iface, struct writer_store, handler_iface);
+}
+static HRESULT WINAPI store_handler_QueryInterface( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface,
+                                                   REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    if (IsEqualGUID(iid, &IID_IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32))
+    {
+        *out = iface;
+        IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IAgileObject))
+    {
+        *out = iface;
+        IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32_AddRef(iface);
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI store_handler_AddRef( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    return store_AddRef(&store_from_handler(iface)->IAsyncOperation_UINT32_iface);
+}
+static ULONG WINAPI store_handler_Release( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface )
+{
+    return store_Release(&store_from_handler(iface)->IAsyncOperation_UINT32_iface);
+}
+static HRESULT WINAPI store_handler_Invoke( IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *iface,
+                                           IAsyncOperationWithProgress_UINT32_UINT32 *child, AsyncStatus status )
+{
+    struct writer_store *impl = store_from_handler(iface);
+    UINT32 count = 0;
+    HRESULT hr;
+    store_AddRef(&impl->IAsyncOperation_UINT32_iface);
+    hr = status == Canceled ? E_ABORT : IAsyncOperationWithProgress_UINT32_UINT32_GetResults(child, &count);
+    if (FAILED(hr) && status != Canceled) status = Error;
+    store_finish(impl, status, hr, count);
+    store_Release(&impl->IAsyncOperation_UINT32_iface);
+    return S_OK;
+}
+static const IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32Vtbl store_handler_vtbl =
+{
+    store_handler_QueryInterface, store_handler_AddRef, store_handler_Release, store_handler_Invoke,
+};
+
+static HRESULT WINAPI writer_StoreAsync( IDataWriter *iface, IAsyncOperation_UINT32 **operation )
+{
+    static LONG next_id;
+    struct data_writer *writer = writer_from_iface(iface);
+    struct writer_store *impl;
+    IAsyncOperationWithProgress_UINT32_UINT32 *child = NULL;
+    IOutputStream *stream;
+    HRESULT hr;
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!TryAcquireSRWLockExclusive(&writer->lock)) return WRITER_BUSY;
+    hr = writer_ready(writer);
+    if (SUCCEEDED(hr) && !writer->stream) hr = E_ILLEGAL_METHOD_CALL;
+    if (FAILED(hr)) { ReleaseSRWLockExclusive(&writer->lock); return hr; }
+    if (!(impl = calloc(1, sizeof(*impl)))) { ReleaseSRWLockExclusive(&writer->lock); return E_OUTOFMEMORY; }
+    impl->IAsyncOperation_UINT32_iface.lpVtbl = &store_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &store_info_vtbl;
+    impl->handler_iface.lpVtbl = &store_handler_vtbl;
+    impl->ref = 1;
+    impl->id = InterlockedIncrement(&next_id);
+    impl->writer = writer;
+    IDataWriter_AddRef(iface);
+    writer->storing = TRUE;
+    stream = writer->stream;
+    IOutputStream_AddRef(stream);
+    ReleaseSRWLockExclusive(&writer->lock);
+
+    hr = writer_buffer(writer->data, writer->length, &impl->buffer);
+    if (SUCCEEDED(hr)) hr = IOutputStream_WriteAsync(stream, impl->buffer, &child);
+    IOutputStream_Release(stream);
+    if (SUCCEEDED(hr) && !child) hr = E_UNEXPECTED;
+    if (SUCCEEDED(hr))
+    {
+        impl->child = child;
+        IAsyncOperationWithProgress_UINT32_UINT32_AddRef(child);
+        hr = IAsyncOperationWithProgress_UINT32_UINT32_QueryInterface(child, &IID_IAsyncInfo, (void **)&impl->child_info);
+        if (SUCCEEDED(hr)) hr = IAsyncOperationWithProgress_UINT32_UINT32_put_Completed(child, &impl->handler_iface);
+    }
+    if (child) IAsyncOperationWithProgress_UINT32_UINT32_Release(child);
+    if (FAILED(hr))
+    {
+        store_finish(impl, Error, hr, 0);
+        store_Release(&impl->IAsyncOperation_UINT32_iface);
+        return hr;
+    }
+    *operation = &impl->IAsyncOperation_UINT32_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI writer_FlushAsync( IDataWriter *iface, IAsyncOperation_boolean **operation )
+{
+    struct data_writer *impl = writer_from_iface(iface);
+    IOutputStream *stream = NULL;
+    HRESULT hr;
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    AcquireSRWLockShared(&impl->lock);
+    hr = writer_ready(impl);
+    if (SUCCEEDED(hr) && !(stream = impl->stream)) hr = E_ILLEGAL_METHOD_CALL;
+    if (stream) IOutputStream_AddRef(stream);
+    ReleaseSRWLockShared(&impl->lock);
+    if (FAILED(hr)) return hr;
+    hr = IOutputStream_FlushAsync(stream, operation);
+    IOutputStream_Release(stream);
+    return hr;
+}
+static HRESULT WINAPI writer_DetachBuffer( IDataWriter *iface, IBuffer **buffer )
+{
+    struct data_writer *impl = writer_from_iface(iface);
+    HRESULT hr;
+    if (!buffer) return E_POINTER;
+    *buffer = NULL;
+    if (!TryAcquireSRWLockExclusive(&impl->lock)) return WRITER_BUSY;
+    hr = writer_ready(impl);
+    if (SUCCEEDED(hr)) impl->storing = TRUE;
+    ReleaseSRWLockExclusive(&impl->lock);
+    if (FAILED(hr)) return hr;
+    hr = writer_buffer(impl->data, impl->length, buffer);
+    AcquireSRWLockExclusive(&impl->lock);
+    if (SUCCEEDED(hr)) impl->length = 0;
+    impl->storing = FALSE;
+    ReleaseSRWLockExclusive(&impl->lock);
+    return hr;
+}
+static HRESULT WINAPI writer_DetachStream( IDataWriter *iface, IOutputStream **stream )
+{
+    struct data_writer *impl = writer_from_iface(iface);
+    HRESULT hr;
+    if (!stream) return E_POINTER;
+    *stream = NULL;
+    if (!TryAcquireSRWLockExclusive(&impl->lock)) return WRITER_BUSY;
+    hr = writer_ready(impl);
+    if (SUCCEEDED(hr)) { *stream = impl->stream; impl->stream = NULL; }
+    ReleaseSRWLockExclusive(&impl->lock);
+    return hr;
+}
+static const IDataWriterVtbl writer_vtbl =
+{
+    writer_QueryInterface, writer_AddRef, writer_Release, writer_GetIids, writer_GetRuntimeClassName,
+    writer_GetTrustLevel, writer_get_UnstoredBufferLength, writer_get_UnicodeEncoding, writer_put_UnicodeEncoding,
+    writer_get_ByteOrder, writer_put_ByteOrder, writer_WriteByte, writer_WriteBytes, writer_WriteBuffer,
+    writer_WriteBufferRange, writer_WriteBoolean, writer_WriteGuid, writer_WriteInt16, writer_WriteInt32,
+    writer_WriteInt64, writer_WriteUInt16, writer_WriteUInt32, writer_WriteUInt64, writer_WriteSingle,
+    writer_WriteDouble, writer_WriteDateTime, writer_WriteTimeSpan, writer_WriteString, writer_MeasureString,
+    writer_StoreAsync, writer_FlushAsync, writer_DetachBuffer, writer_DetachStream,
+};
+DEFINE_IINSPECTABLE( writer_closable, IClosable, struct data_writer, IDataWriter_iface )
+static HRESULT WINAPI writer_closable_Close( IClosable *iface )
+{
+    struct data_writer *impl = impl_from_IClosable(iface);
+    IOutputStream *stream;
+    IClosable *closable;
+    HRESULT hr = S_OK;
+    AcquireSRWLockExclusive(&impl->lock);
