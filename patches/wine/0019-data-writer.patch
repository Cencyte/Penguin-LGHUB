+static struct completion *completion_impl(IAsyncOperationCompletedHandler_UINT32 *iface)
+{ return CONTAINING_RECORD(iface, struct completion, iface); }
+static HRESULT WINAPI completion_qi(IAsyncOperationCompletedHandler_UINT32 *iface, REFIID iid, void **out)
+{
+    *out = NULL;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_IAgileObject) &&
+        !IsEqualGUID(iid, &IID_IAsyncOperationCompletedHandler_UINT32)) return E_NOINTERFACE;
+    *out = iface; IAsyncOperationCompletedHandler_UINT32_AddRef(iface); return S_OK;
+}
+static ULONG WINAPI completion_addref(IAsyncOperationCompletedHandler_UINT32 *iface)
+{ return InterlockedIncrement(&completion_impl(iface)->refs); }
+static ULONG WINAPI completion_release(IAsyncOperationCompletedHandler_UINT32 *iface)
+{ return InterlockedDecrement(&completion_impl(iface)->refs); }
+static HRESULT WINAPI completion_invoke(IAsyncOperationCompletedHandler_UINT32 *iface, IAsyncOperation_UINT32 *op, AsyncStatus status)
+{
+    struct completion *impl = completion_impl(iface);
+    InterlockedIncrement(&impl->calls);
+    impl->status = status;
+    impl->result_hr = IAsyncOperation_UINT32_GetResults(op, &impl->result);
+    if (impl->reenter) HR(IDataWriter_WriteByte(impl->reenter, 0x7e));
+    if (impl->event) SetEvent(impl->event);
