+#include "config.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "handle.h"
+#include "process.h"
+#include "thread.h"
+#include "user.h"
+#include "security.h"
+#include "request.h"
+
+static const WCHAR composition_name[] = {'C','o','m','p','o','s','i','t','i','o','n'};
+struct type_descr composition_type =
+{
+    {composition_name, sizeof(composition_name)},
+    STANDARD_RIGHTS_REQUIRED | 3,
+    {STANDARD_RIGHTS_READ | 1, STANDARD_RIGHTS_WRITE | 2,
+     STANDARD_RIGHTS_EXECUTE, STANDARD_RIGHTS_REQUIRED | 3}
+};
+struct composition_sink
+{
+    struct object obj;
+    struct luid luid;
+    unsigned int view_id, flags;
+    struct composition_input_route routes[5];
+    struct thread *threads[5];
+};
+static void sink_dump(struct object *obj, int verbose)
+{
+    struct composition_sink *sink = (struct composition_sink *)obj;
+    fprintf(stderr, "Composition input sink luid=%08x:%08x view=%u flags=%x\n",
+            sink->luid.high_part, sink->luid.low_part, sink->view_id, sink->flags);
+}
+static void sink_destroy(struct object *obj)
+{
+    struct composition_sink *sink = (struct composition_sink *)obj;
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(sink->threads); i++)
+        if (sink->threads[i]) release_object(sink->threads[i]);
+}
+static const struct object_ops sink_ops =
+{
+    sizeof(struct composition_sink), &composition_type, sink_dump,
+    no_add_queue, NULL, NULL, NULL, no_signal, no_get_fd, default_get_sync,
+    default_map_access, default_get_sd, default_set_sd, default_get_full_name,
+    no_lookup_name, directory_link_name, default_unlink_name, no_open_file,
+    no_kernel_obj_list, no_close_handle, sink_destroy
+};
+DECL_HANDLER(create_composition_input_sink)
+{
+    struct composition_sink *sink;
+    const struct composition_input_route *routes = get_req_data();
+    unsigned int i;
+    if (get_req_data_size() != 5 * sizeof(*routes) || (req->flags & ~1u))
+    {
+        set_error(STATUS_INVALID_PARAMETER);
+        return;
+    }
+    if (!(sink = alloc_object(&sink_ops))) return;
+    memset(sink->threads, 0, sizeof(sink->threads));
+    memset(&sink->luid, 0, sizeof(sink->luid));
+    sink->view_id = req->view_id;
+    sink->flags = req->flags;
+    memcpy(sink->routes, routes, sizeof(sink->routes));
+    for (i = 0; i < ARRAY_SIZE(sink->routes); i++)
+    {
+        if (routes[i].type > 2 || (routes[i].type != 2 && routes[i].window))
+        {
+            set_error(STATUS_INVALID_PARAMETER);
+            goto done;
+        }
+        if (routes[i].type == 2)
+        {
+            if (!(sink->threads[i] = get_window_thread(routes[i].window)))
+            {
+                set_error(STATUS_INVALID_HANDLE);
+                goto done;
+            }
+            if (sink->threads[i]->process != current->process)
+            {
+                set_error(STATUS_ACCESS_DENIED);
+                goto done;
+            }
+        }
+    }
+    allocate_luid(&sink->luid);
+    reply->handle = alloc_handle(current->process, sink, STANDARD_RIGHTS_READ | STANDARD_RIGHTS_WRITE | 3, 0);
+done:
+    release_object(sink);
+}
+DECL_HANDLER(query_composition_input_sink)
+{
+    struct composition_sink *sink;
+    if (!(sink = (struct composition_sink *)get_handle_obj(current->process, req->handle, 1, &sink_ops))) return;
+    reply->luid = sink->luid;
+    reply->view_id = sink->view_id;
+    reply->flags = sink->flags;
+    release_object(sink);
+}
