+#if 0
+#pragma makedep unix
+#endif
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "win32u_private.h"
+#include "wine/server.h"
+#include "wine/debug.h"
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+/* Observed x64 ABI: header followed by four (Win10) or five (Win11)
+ * 0x38-byte routing records, plus flags at 0x120 in the latter layout.
+ * No pointer in the caller's memory is retained. */
+struct sink_route
+{
+    UINT type, reserved;
+    UINT64 window;
+    UINT64 data[5];
+};
+struct sink_desc
+{
+    UINT size, view_id;
+    struct sink_route routes[5];
+    UINT flags, reserved;
+};
+C_ASSERT(sizeof(struct sink_route) == 0x38);
+C_ASSERT(sizeof(struct sink_desc) == 0x128);
+
+static NTSTATUS read_user(const void *src, void *dst, SIZE_T size)
+{
+    return NtReadVirtualMemory(GetCurrentProcess(), src, dst, size, NULL) ? STATUS_ACCESS_VIOLATION : STATUS_SUCCESS;
+}
+static NTSTATUS write_user(void *dst, const void *src, SIZE_T size)
+{
+    return NtWriteVirtualMemory(GetCurrentProcess(), dst, src, size, NULL) ? STATUS_ACCESS_VIOLATION : STATUS_SUCCESS;
+}
+static NTSTATUS create_sink(const void *descriptor, BOOL implicit, HANDLE *output)
+{
+    struct sink_desc desc = {0};
+    struct composition_input_route routes[5] = {{0}};
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    const char *enabled = getenv("WINE_GHUB_INPUT_SINK");
+    NTSTATUS status;
+    unsigned int i, j, size;
+
+    if (!output) return STATUS_INVALID_PARAMETER;
+    if ((status = write_user(output, &handle, sizeof(handle)))) return status;
+    if (!descriptor) return STATUS_INVALID_PARAMETER;
+    if (!enabled || strcmp(enabled, "1") || sizeof(void *) != 8) return STATUS_NOT_IMPLEMENTED;
+    if ((status = read_user(descriptor, &size, sizeof(size)))) return status;
+    /* The reference kernel normalizes older descriptors to 0x128, but we
+     * intentionally reject unverified version sizes in this opt-in path. */
+    if (size != 0xe8 && size != sizeof(desc)) return STATUS_NOT_SUPPORTED;
+    if ((status = read_user(descriptor, &desc, size))) return status;
+    if (desc.reserved || (desc.flags & ~1u)) return STATUS_NOT_SUPPORTED;
+    for (i = 0; i < ARRAY_SIZE(routes); i++)
+    {
+        struct sink_route *route = &desc.routes[i];
+        if (route->type > 4) return STATUS_INVALID_PARAMETER;
+        if (route->type == 3 || route->type == 4 || route->reserved) return STATUS_NOT_SUPPORTED;
+        for (j = 0; j < ARRAY_SIZE(route->data); j++)
+            if (route->data[j]) return STATUS_NOT_SUPPORTED;
+        if (route->type == 2 && (!route->window || route->window > 0xffffffff))
+            return STATUS_INVALID_HANDLE;
+        if (route->type != 2 && route->window) return STATUS_INVALID_PARAMETER;
+        routes[i].type = route->type;
+        routes[i].window = route->window;
+    }
+    SERVER_START_REQ(create_composition_input_sink)
+    {
+        req->view_id = desc.view_id;
+        req->flags = desc.flags | !!implicit;
+        wine_server_add_data(req, routes, sizeof(routes));
+        if (!(status = wine_server_call(req))) handle = wine_server_ptr_handle(reply->handle);
+    }
+    SERVER_END_REQ;
+    TRACE("create size=%x view=%u implicit=%u route=%u hwnd=%p => %#x %p\n", size, desc.view_id,
+          implicit, routes[0].type, UlongToHandle(routes[0].window), status, handle);
+    if (status) return status;
+    if ((status = write_user(output, &handle, sizeof(handle)))) NtClose(handle);
+    return status;
+}
+NTSTATUS WINAPI NtCreateCompositionInputSink(const void *desc, HANDLE *handle)
+{
+    return create_sink(desc, FALSE, handle);
+}
+NTSTATUS WINAPI NtCreateImplicitCompositionInputSink(const void *desc, HANDLE *handle)
+{
+    return create_sink(desc, TRUE, handle);
+}
+NTSTATUS WINAPI NtCloseCompositionInputSink(HANDLE handle)
+{
+    /* Reference kernel logs the sink close then forwards directly to NtClose. */
+    TRACE("close %p\n", handle);
+    return NtClose(handle);
+}
+static NTSTATUS query_sink(HANDLE handle, LUID *luid, UINT *view_id, UINT *flags)
+{
+    NTSTATUS status;
+    SERVER_START_REQ(query_composition_input_sink)
+    {
+        req->handle = wine_server_obj_handle(handle);
+        if (!(status = wine_server_call(req)))
+        {
+            luid->LowPart = reply->luid.low_part;
+            luid->HighPart = reply->luid.high_part;
+            *view_id = reply->view_id;
+            *flags = reply->flags;
+        }
+    }
+    SERVER_END_REQ;
+    return status;
+}
+NTSTATUS WINAPI NtQueryCompositionInputSinkLuid(HANDLE handle, LUID *out)
+{
+    LUID luid;
+    UINT view_id, flags;
+    NTSTATUS status = query_sink(handle, &luid, &view_id, &flags);
+    return status ? status : write_user(out, &luid, sizeof(luid));
+}
+NTSTATUS WINAPI NtQueryCompositionInputSinkViewId(HANDLE handle, UINT *out)
+{
+    LUID luid;
+    UINT view_id, flags;
+    NTSTATUS status = query_sink(handle, &luid, &view_id, &flags);
+    return status ? status : write_user(out, &view_id, sizeof(view_id));
+}
