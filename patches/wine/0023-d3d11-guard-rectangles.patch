+    RECT rects[WINED3D_MAX_VIEWPORTS], guard;
+    unsigned int i, rt_count = 0, count, mode;
+
+    *changed = FALSE;
+    for (i = 0; i < ARRAY_SIZE(state->fb.render_targets); ++i)
+        if (state->fb.render_targets[i])
+        {
+            ++rt_count;
+            if (wined3d_resource_get_guard_rect(state->fb.render_targets[i]->resource, NULL))
+                view = state->fb.render_targets[i];
+        }
+    if (!view)
+        return TRUE;
+    if (rt_count != 1)
+    {
+        WARN("Guarded rendering does not support multiple render targets.\n");
+        return FALSE;
+    }
+    mode = wined3d_resource_get_guard_rect(view->resource, &guard);
+    if (mode == 2 || IsRectEmpty(&guard))
+        return FALSE;
+    if (state->rasterizer_state)
+        desc = state->rasterizer_state->desc;
+    else
