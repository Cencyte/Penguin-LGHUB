+static BOOL guard_begin_draw(struct wined3d_device_context *context, BOOL *changed)
+{
+    const struct wined3d_state *state = context->state;
+    struct wined3d_device *device = context->device;
+    struct wined3d_rendertarget_view *view = NULL;
+    struct wined3d_rasterizer_state_desc desc = {0};
