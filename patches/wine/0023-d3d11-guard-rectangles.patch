+/* Guard rectangles are a DirectComposition update-region contract, not a
+ * content-protection feature. Only non-planar single-subresource 2D render
+ * textures are supported; reject other shapes rather than silently unguard. */
+HRESULT CDECL wined3d_resource_set_guard_rect(struct wined3d_resource *resource, unsigned int mode, const RECT *rect)
+{
+    struct wined3d_texture *texture;
+    if (mode > 2 || (mode == 1 && !rect))
+        return E_INVALIDARG;
+    if (resource->type != WINED3D_RTYPE_TEXTURE_2D)
+        return E_NOTIMPL;
+    texture = texture_from_resource(resource);
+    if (texture->level_count != 1 || texture->layer_count != 1 ||
+        resource->multisample_type != WINED3D_MULTISAMPLE_NONE ||
+        resource->bind_flags & ~(WINED3D_BIND_RENDER_TARGET | WINED3D_BIND_SHADER_RESOURCE) ||
+        resource->format->block_width != 1 || resource->format->block_height != 1 ||
+        resource->format->attrs & WINED3D_FORMAT_ATTR_PLANAR || !resource->format->byte_count)
+        return E_NOTIMPL;
+    wined3d_mutex_lock();
+    resource->guard_mode = mode;
+    if (mode == 1)
+        resource->guard_rect = *rect;
+    else if (mode == 2)
+        SetRectEmpty(&resource->guard_rect);
+    else
+        SetRect(&resource->guard_rect, 0, 0, -16, -4); /* Native unguarded sentinel. */
+    wined3d_mutex_unlock();
+    return S_OK;
+}
+unsigned int CDECL wined3d_resource_get_guard_rect(struct wined3d_resource *resource, RECT *rect)
+{
+    unsigned int mode;
+    wined3d_mutex_lock();
+    mode = resource->guard_mode;
+    if (rect)
+    {
+        if (mode)
+            *rect = resource->guard_rect;
+        else
+            SetRect(rect, 0, 0, -16, -4);
+    }
+    wined3d_mutex_unlock();
+    return mode;
+}
