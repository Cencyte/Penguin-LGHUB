+/* Restrict producer commands before they are queued. Caller-visible rasterizer
+ * state is never changed; the CS temporarily receives the guarded variant. */
+static BOOL guard_clip_rect(struct wined3d_resource *resource, RECT *rect)
+{
+    RECT guard;
+    unsigned int mode = wined3d_resource_get_guard_rect(resource, &guard);
+    if (!mode)
+        return TRUE;
+    if (!IntersectRect(rect, rect, &guard))
+        return FALSE;
+    return !IsRectEmpty(rect);
+}
+static BOOL guard_clip_box(struct wined3d_resource *resource, struct wined3d_box *box)
+{
+    RECT rect = {box->left, box->top, box->right, box->bottom};
+    if (!guard_clip_rect(resource, &rect))
+        return FALSE;
+    box->left = rect.left;
+    box->top = rect.top;
+    box->right = rect.right;
+    box->bottom = rect.bottom;
+    return TRUE;
+}
