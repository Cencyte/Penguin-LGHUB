+        desc.fill_mode = WINED3D_FILL_SOLID;
+        desc.cull_mode = WINED3D_CULL_BACK;
+        desc.depth_clip = TRUE;
+    }
+    count = max(state->viewport_count, 1);
+    for (i = 0; i < count; ++i)
+    {
+        SetRect(&rects[i], 0, 0, view->width, view->height);
+        if (desc.scissor)
+        {
+            if (i < state->scissor_rect_count)
+                IntersectRect(&rects[i], &rects[i], &state->scissor_rects[i]);
+            else
+                SetRectEmpty(&rects[i]);
+        }
+        IntersectRect(&rects[i], &rects[i], &guard);
+    }
+    desc.scissor = TRUE;
