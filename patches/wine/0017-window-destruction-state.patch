+
+DECL_HANDLER(mark_window_destroying)
+{
+    struct window *win = get_window(req->handle);
+    if (!win) return;
+    if (!win->thread || win->thread->process != current->process || is_desktop_window(win))
+    {
+        set_error(STATUS_ACCESS_DENIED);
+        return;
+    }
+    SHARED_WRITE_BEGIN(win->shared, window_shm_t)
+    {
+        shared->in_destroy = 1;
+    }
+    SHARED_WRITE_END;
+}
