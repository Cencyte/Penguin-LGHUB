@@ -752,10 +752,20 @@

 BOOL WINAPI GetPointerDeviceRects( HANDLE device, RECT *device_rect, RECT *display_rect )
 {
-    FIXME( "device %p, device_rect %p, display_rect %p stub!\n",
-           device, device_rect, display_rect );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    POINTER_INFO info;
+    RECT rect;
+    if (!device_rect || !display_rect)
+    { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    /* Only the private composition mouse sample has pixel-native device
+     * coordinates. Do not invent geometry for an unknown hardware device. */
+    if (!device || !GetPointerInfo(1, &info) || info.pointerType != PT_MOUSE || info.sourceDevice != device)
+    { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    rect.left = GetSystemMetrics(SM_XVIRTUALSCREEN);
+    rect.top = GetSystemMetrics(SM_YVIRTUALSCREEN);
+    rect.right = rect.left + GetSystemMetrics(SM_CXVIRTUALSCREEN);
+    rect.bottom = rect.top + GetSystemMetrics(SM_CYVIRTUALSCREEN);
+    *device_rect = *display_rect = rect;
+    return TRUE;
 }

