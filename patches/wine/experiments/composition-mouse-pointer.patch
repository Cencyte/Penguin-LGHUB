@@ -2770,6 +2770,53 @@
  *
  * Process a hardware message; return TRUE if message should be passed on to the app
  */
+/* The native composition input sink consumes WM_POINTER buttons, not legacy
+ * mouse buttons. Keep the legacy move path for hover and expose genuine mouse
+ * samples only for this explicitly enabled private sink route. */
+static BOOL composition_mouse_pointer(MSG *msg, const struct hardware_msg_data *data, BOOL remove)
+{
+    const char *enabled = getenv("WINE_GHUB_POINTER_MOUSE");
+    POINTER_INFO pointer = {0};
+    UINT message = msg->message;
+    if (!(data->flags & COMPOSITION_INPUT_ROUTED) || !enabled || strcmp(enabled, "1")) return FALSE;
+    if (message != WM_LBUTTONDOWN && message != WM_LBUTTONUP &&
+        message != WM_MOUSEMOVE) return FALSE;
+    if (message == WM_MOUSEMOVE && !(msg->wParam & MK_LBUTTON)) return FALSE;
+    pointer.pointerType = PT_MOUSE;
+    pointer.pointerId = 1;
+    pointer.sourceDevice = (HANDLE)(ULONG_PTR)0x47485542;
+    pointer.frameId = data->hw_id;
+    pointer.pointerFlags = POINTER_FLAG_INRANGE | POINTER_FLAG_PRIMARY | POINTER_FLAG_CONFIDENCE;
+    if (msg->wParam & MK_LBUTTON) pointer.pointerFlags |= POINTER_FLAG_INCONTACT | POINTER_FLAG_FIRSTBUTTON;
+    pointer.hwndTarget = msg->hwnd;
+    pointer.ptPixelLocation = pointer.ptPixelLocationRaw = msg->pt;
+    pointer.dwTime = msg->time;
+    pointer.historyCount = 1;
+    if (message == WM_LBUTTONDOWN)
+    {
+        pointer.pointerFlags |= POINTER_FLAG_DOWN;
+        pointer.ButtonChangeType = POINTER_CHANGE_FIRSTBUTTON_DOWN;
+        msg->message = WM_POINTERDOWN;
+    }
+    else if (message == WM_LBUTTONUP)
+    {
+        pointer.pointerFlags |= POINTER_FLAG_UP;
+        pointer.ButtonChangeType = POINTER_CHANGE_FIRSTBUTTON_UP;
+        msg->message = WM_POINTERUP;
+    }
+    else
+    {
+        pointer.pointerFlags |= POINTER_FLAG_UPDATE;
+        msg->message = WM_POINTERUPDATE;
+    }
+    if (remove) get_user_thread_info()->composition_pointer = pointer;
+    msg->wParam = MAKELONG(1, pointer.pointerFlags & 0xffff);
+    msg->lParam = MAKELONG(pointer.ptPixelLocation.x, pointer.ptPixelLocation.y);
+    TRACE("composition mouse pointer message=%x hwnd=%p point=%d,%d flags=%x\n", msg->message,
+          msg->hwnd, pointer.ptPixelLocation.x,pointer.ptPixelLocation.y,pointer.pointerFlags);
+    return TRUE;
+}
+
 static BOOL process_hardware_message( MSG *msg, UINT hw_id, const struct hardware_msg_data *msg_data,
                                       HWND hwnd_filter, UINT first, UINT last, BOOL remove )
 {
@@ -2787,7 +2834,12 @@
     msg->pt.x = rect.left;
     msg->pt.y = rect.top;

-    if (msg->message == WM_INPUT || msg->message == WM_INPUT_DEVICE_CHANGE)
