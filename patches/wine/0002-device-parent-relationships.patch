 /***********************************************************************
+ *              CM_Get_Parent (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Parent(DEVINST *parent, DEVINST child, ULONG flags)
+{
+    SP_DEVINFO_DATA info = {sizeof(info)};
+    WCHAR parent_id[MAX_DEVICE_ID_LEN];
+    DEVPROPTYPE type;
+    DWORD size;
+    HDEVINFO set;
+    CONFIGRET ret = CR_NO_SUCH_DEVNODE;
+
+    TRACE("%p, %lu, %#lx\n", parent, child, flags);
+
+    if (!parent) return CR_INVALID_POINTER;
+    *parent = 0;
+    if (flags) return CR_INVALID_FLAG;
+    if (child >= devinst_table_size || !devinst_table[child]) return CR_NO_SUCH_DEVNODE;
+
+    if ((set = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE)
+        return CR_FAILURE;
+    if (SetupDiOpenDeviceInfoW(set, devinst_table[child], NULL, 0, &info)
+            && SetupDiGetDevicePropertyW(set, &info, &DEVPKEY_Device_Parent, &type,
+                (BYTE *)parent_id, sizeof(parent_id), &size, 0)
+            && type == DEVPROP_TYPE_STRING && size >= sizeof(WCHAR)
+            && size <= sizeof(parent_id) && !(size % sizeof(WCHAR))
+            && !parent_id[size / sizeof(WCHAR) - 1] && parent_id[0]
+            && SetupDiOpenDeviceInfoW(set, parent_id, NULL, 0, &info))
+    {
+        *parent = info.DevInst;
+        ret = CR_SUCCESS;
+    }
+    SetupDiDestroyDeviceInfoList(set);
+    return ret;
+}
