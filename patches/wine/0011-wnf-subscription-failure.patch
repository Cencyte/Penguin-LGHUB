+/*********************************************************************
+ *           RtlSubscribeWnfStateChangeNotification [NTDLL.@]
+ *
+ * WNF notification delivery is not implemented. Return a failure that
+ * callers can handle instead of raising an unimplemented-export exception.
+ * In particular, do not hand out a fake successful subscription.
+ */
+NTSTATUS WINAPI RtlSubscribeWnfStateChangeNotification(void **subscription, ULONGLONG state,
+        ULONG stamp, void *callback, void *context, const GUID *type, ULONG group, ULONG flags)
+{
+    FIXME("%p, %s, %lu, %p, %p, %p, %lu, %lu: unsupported\n", subscription,
+            wine_dbgstr_longlong(state), stamp, callback, context, type, group, flags);
+    if (subscription) *subscription = NULL;
+    return STATUS_NOT_IMPLEMENTED;
+}
