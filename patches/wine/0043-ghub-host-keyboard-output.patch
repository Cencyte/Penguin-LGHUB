From: Cencyte D <antiultra2007@gmail.com>
Subject: [PATCH] Opt in the G HUB agent to host X11 keyboard output.

--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -357,6 +357,9 @@
 #define WINE_SWP_FULLSCREEN 0x80000000
 #define WINE_SWP_RESIZABLE  0x40000000

+/* Private, opt-in G HUB keyboard output. Does not change the driver ABI. */
+#define WINE_GHUB_HOST_KEYBOARD_ESCAPE 0x47484b49
+
 struct vulkan_driver_funcs;
 struct opengl_driver_funcs;

--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -651,10 +651,31 @@
 /***********************************************************************
  *           NtUserSendInput  (win32u.@)
  */
+static BOOL ghub_host_keyboard_enabled(void)
+{
+    const char *enabled = getenv( "WINE_GHUB_HOST_KEYBOARD" );
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    static const char name[] = "lghub_agent.exe";
+    unsigned int i, start = 0, length = image->Length / sizeof(WCHAR);
+
+    if (!enabled || strcmp( enabled, "1" )) return FALSE;
+    for (i = 0; i < length; ++i)
+        if (image->Buffer[i] == '\\' || image->Buffer[i] == '/') start = i + 1;
+    if (length - start != sizeof(name) - 1) return FALSE;
+    for (i = 0; i < sizeof(name) - 1; ++i)
+    {
+        WCHAR ch = image->Buffer[start+i];
+        if (ch >= 'A' && ch <= 'Z') ch += 'a' - 'A';
+        if (ch != (unsigned char)name[i]) return FALSE;
+    }
+    return TRUE;
+}
+
 UINT WINAPI NtUserSendInput( UINT count, INPUT *inputs, int size )
 {
     UINT i;
     NTSTATUS status = STATUS_SUCCESS;
+    BOOL host_keyboard = ghub_host_keyboard_enabled();

     if (size != sizeof(INPUT))
     {
