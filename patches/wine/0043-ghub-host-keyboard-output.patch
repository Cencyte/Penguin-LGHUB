--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -39,6 +39,7 @@
 #include <ctype.h>
 #include <stdarg.h>
 #include <string.h>
+#include <dlfcn.h>

 #include "x11drv.h"

@@ -67,6 +68,71 @@
 static int NumLockMask, ScrollLockMask, AltGrMask; /* mask in the XKeyEvent state */

 static pthread_mutex_t kbd_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* Keep hardware layout translation in the X11 driver. G HUB's software key
+ * assignments otherwise terminate in wineserver and never reach native apps. */
+INT X11DRV_GhubHostKeyboard( const KEYBDINPUT *input )
+{
+    static void *library;
+    static int (*fake_key)( Display *, unsigned int, Bool, unsigned long );
+    static Bool (*query)( Display *, int *, int *, int *, int * );
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    Display *display = thread_init_display();
+    unsigned int scan = input->wScan & 0xff, vk = input->wVk;
+    int keycode = 0, candidate, ret = 0, a, b, c, d;
+    BOOL extended = !!(input->dwFlags & KEYEVENTF_EXTENDEDKEY);
+    KeySym function_key = input->wVk >= VK_F1 && input->wVk <= VK_F24
+                        ? XK_F1 + input->wVk - VK_F1 : NoSymbol;
+
+    if (input->dwFlags & KEYEVENTF_UNICODE) return 0;
+    if (input->dwFlags & KEYEVENTF_SCANCODE)
+        scan |= extended ? 0x100 : 0;
+    else switch (vk)
+    {
+        case VK_SHIFT: vk = input->wScan == 0x36 ? VK_RSHIFT : VK_LSHIFT; break;
+        case VK_CONTROL: vk = extended ? VK_RCONTROL : VK_LCONTROL; break;
+        case VK_MENU: vk = extended ? VK_RMENU : VK_LMENU; break;
+    }
+
+    pthread_mutex_lock( &kbd_mutex );
+    for (candidate = min_keycode; candidate <= max_keycode; ++candidate)
+    {
+        if (input->dwFlags & KEYEVENTF_SCANCODE)
+        {
+            if (keyc2scan[candidate] != scan) continue;
+        }
+        else
+        {
+            if (!vk || (keyc2vkey[candidate] & 0xff) != vk) continue;
+            /* Wine assigns spare virtual keys to unmapped XF86 keys. Do not
+             * turn an absent F13-F24 into an unrelated desktop command. */
+            if (function_key && XkbKeycodeToKeysym( display, candidate, 0, 0 ) != function_key) continue;
+            if ((vk == VK_RETURN || (vk >= VK_PRIOR && vk <= VK_DOWN) ||
+                 vk == VK_INSERT || vk == VK_DELETE) &&
+                !!(keyc2scan[candidate] & 0x100) != extended) continue;
+        }
+        keycode = candidate;
+        break;
+    }
+    pthread_mutex_unlock( &kbd_mutex );
+    if (!keycode) return 0;
+
+    pthread_mutex_lock( &mutex );
+    if (!library && (library = dlopen( "libXtst.so.6", RTLD_NOW | RTLD_LOCAL )))
+    {
+        fake_key = dlsym( library, "XTestFakeKeyEvent" );
+        query = dlsym( library, "XTestQueryExtension" );
+    }
+    if (fake_key && query && query( display, &a, &b, &c, &d ))
+    {
+        ret = !!fake_key( display, keycode, !(input->dwFlags & KEYEVENTF_KEYUP), CurrentTime );
+        XFlush( display );
+        TRACE( "G HUB host key vk=%x scan=%x flags=%x keycode=%u sent=%d\n",
+               input->wVk, input->wScan, input->dwFlags, keycode, ret );
+    }
+    pthread_mutex_unlock( &mutex );
+    return ret;
+}

 static char KEYBOARD_MapDeadKeysym(KeySym keysym);

