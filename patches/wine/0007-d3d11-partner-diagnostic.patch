+        const D3D11_SUBRESOURCE_DATA *data, ID3D11Texture2D **out)
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    return partner_unsupported("CreateGuardableTexture2D");
+}
+static void WINAPI partner_guard(IUnknown *iface, ID3D11Texture2D *texture, RECT rect) { partner_unsupported_void("SetGuardRect"); }
+static void WINAPI partner_empty(IUnknown *iface, ID3D11Texture2D *texture) { partner_unsupported_void("SetEmptyGuardRect"); }
+static void WINAPI partner_unguarded(IUnknown *iface, ID3D11Texture2D *texture) { partner_unsupported_void("SetUnguarded"); }
