+/* Diagnostic private partner interface: preserve real device identity/lifetime,
+ * report zero optional partner capabilities, and fail explicitly on any actual
+ * operation not implemented. Enabled only by GHUB_D3D11_PARTNER_PROBE. */
+static const GUID partner_iid = {0x26c5dc23,0xe49c,0x4b0a,{0x8f,0x79,0xe7,0xb1,0xac,0x80,0x4d,0x32}};
+static struct d3d_device *partner_device(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_device, partner_probe);
+}
+static HRESULT WINAPI partner_query(IUnknown *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    return IUnknown_QueryInterface(partner_device(iface)->outer_unk, iid, out);
+}
+static ULONG WINAPI partner_addref(IUnknown *iface)
+{
+    return IUnknown_AddRef(partner_device(iface)->outer_unk);
+}
+static ULONG WINAPI partner_release(IUnknown *iface)
+{
+    return IUnknown_Release(partner_device(iface)->outer_unk);
+}
+static HRESULT partner_unsupported(const char *name)
+{
+    ERR("GHUB partner probe: unsupported %s\n", name);
+    return E_NOTIMPL;
+}
+static void partner_unsupported_void(const char *name)
+{
+    partner_unsupported(name);
+    RaiseException(0xc0000002, EXCEPTION_NONCONTINUABLE, 0, NULL);
+}
+static HRESULT WINAPI partner_begin(IUnknown *iface) { return partner_unsupported("BeginGuardRectangleSupport"); }
+static void WINAPI partner_end(IUnknown *iface) { partner_unsupported_void("EndGuardRectangleSupport"); }
